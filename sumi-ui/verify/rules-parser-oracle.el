;;; Independent engine-parser oracle for the Sumi AOT parity corpus.
(load (expand-file-name "engine/skk-input-rules.el" (getenv "SUMI_TEST_ROOT")) nil t)
(defun sumi-rules-b64 (s) (base64-encode-string (encode-coding-string s 'utf-8-unix) t))
(let* ((dir (getenv "SUMI_TEST_CORPUS")) (files (directory-files dir t "\\.conf\\'")))
 (dolist (file files)
  (let* ((text (with-temp-buffer (let ((coding-system-for-read 'utf-8-unix)) (insert-file-contents file)) (buffer-string)))
         (config (skk-input-rules-parse text)) (index 0) rows)
   (dolist (table (plist-get config :tables))
    (dolist (row (cdr table))
     (push (format "ROW %d %s %s %s" index (sumi-rules-b64 (car row))
                   (sumi-rules-b64 (nth 1 row)) (sumi-rules-b64 (or (nth 2 row) ""))) rows))
    (setq index (1+ index)))
   (with-temp-file (concat file ".expected")
    (insert (format "OPTIONS width=%d pair=%d\n" (if (equal (plist-get config :width) "zenkaku") 1 0)
                    (if (plist-get config :auto-pair) 1 0)))
    (insert "ERROR " (sumi-rules-b64 (mapconcat (lambda (e) (concat e "\n")) (plist-get config :errors) "")) "\n")
    (dolist (row rows) (insert row "\n"))))))
(princ "ENGINE-PARSER-ORACLE-PASS\n")
