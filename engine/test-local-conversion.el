;;; test-local-conversion.el --- Ordinary learning protocol tests -*- lexical-binding: t; -*-
;; GPL-3.0-or-later. Uses only a caller-provided private directory.
(require 'ert)
(require 'cl-lib)
(require 'skk-user-jisyo)
(defun nelisp--syscall-read-file (path)
  (when (file-readable-p path)
    (with-temp-buffer (insert-file-contents path) (buffer-string))))
(defun ddskk-engine--unhex (value)
  (when (and value (= (% (length value) 6) 0))
    (apply #'string
           (cl-loop for n from 0 below (length value) by 6
                    collect (string-to-number (substring value n (+ n 6)) 16)))))
(defun ddskk-engine--error-token (prefix err) (concat prefix " " (prin1-to-string err)))
(defvar skk-search-prog-list nil)
(defvar skk-update-jisyo-function nil)
(defvar skk-henkan-key "")
(defvar skk-henkan-okurigana nil)
(defvar skk-henkan-okuri-strictly nil)
(defvar skk-show-candidates-nth-henkan-char 5)
(defvar skk-henkan-number-to-display-candidates 7)
(defvar skk-henkan-show-candidates-keys '(97 115 100 102 106 107 108))
(defun nelisp--write-stdout-bytes (_line) nil)
(defun ddskk-engine-read-stdio-line ()
  (let ((path (ddskk-user-jisyo-path)))
    (rename-file (concat path ".local-checkpoint") path t)
    "LOCAL-PUBLISHED"))
(require 'skk-local-conversion)
(defmacro local-test (&rest body)
  `(let* ((directory (getenv "LOCAL_LEARNING_TEST_DIR"))
          (_ (make-directory directory t))
          (path (make-temp-file (expand-file-name "local-test-" directory) nil ".jisyo"))
          (ddskk-user-jisyo--table (make-hash-table :test 'equal))
          (ddskk-user-jisyo--okuri-blocks (make-hash-table :test 'equal))
          (ddskk-local-operations (make-hash-table :test 'equal))
          (ddskk-local-operations-loaded t)
          (ddskk-user-jisyo-local-revision 0)
          (ddskk-user-jisyo-learning-disabled nil)
          (skk-search-prog-list '((ddskk-user-jisyo-search) (ddskk-engine-server-search)))
          (skk-update-jisyo-function 'ddskk-user-jisyo--update))
     (make-directory directory t)
     (cl-letf (((symbol-function 'ddskk-user-jisyo-path) (lambda () path)))
       ,@body)))
(defconst local-test-one "LOCAL LEARN 0123456789abcdef0123456789abcdef.1 00304b00306a 004eee00540d")
(ert-deftest local-learning-persist-and-duplicate ()
  (local-test
   (should (equal (ddskk-local-learn local-test-one) "ACK 0123456789abcdef0123456789abcdef.1 1"))
   (should (equal (gethash "かな" ddskk-user-jisyo--table) '("仮名")))
   (let ((skk-henkan-key "かな")) (ddskk-user-jisyo--update "哉"))
   (should (equal (ddskk-local-learn local-test-one) "ACK 0123456789abcdef0123456789abcdef.1 1"))
   (should (equal (gethash "かな" ddskk-user-jisyo--table) '("哉" "仮名")))))
(ert-deftest local-learning-restart-watermark ()
  (local-test
   (ddskk-local-learn local-test-one)
   (setq ddskk-local-operations (make-hash-table :test 'equal)
         ddskk-local-operations-loaded nil ddskk-user-jisyo-local-revision 0)
   (ddskk-local-load-operations)
   (should (= ddskk-user-jisyo-local-revision 1))
   (should (equal (ddskk-local-learn local-test-one) "ACK 0123456789abcdef0123456789abcdef.1 1"))))
(ert-deftest local-learning-compaction-preserves-durable-identity ()
  (local-test
   (ddskk-local-learn local-test-one)
   (let ((skk-henkan-key "かな")) (ddskk-user-jisyo--update "哉"))
   (should (ddskk-user-jisyo-flush))
   (setq ddskk-local-operations (make-hash-table :test 'equal)
         ddskk-local-operations-loaded nil)
   (ddskk-local-load-operations)
   (should (equal (ddskk-local-learn local-test-one) "ACK 0123456789abcdef0123456789abcdef.1 1"))
   (should (equal (gethash "かな" ddskk-user-jisyo--table) '("哉" "仮名")))))
(ert-deftest local-learning-failed-storage-remains-unacked ()
  (local-test
   (cl-letf (((symbol-function 'ddskk-local-save) (lambda () nil)))
     (should (equal (ddskk-local-learn local-test-one) "ERR LOCAL STORAGE"))
     (should (= (hash-table-count ddskk-local-operations) 0)))))
(ert-deftest local-learning-publication-failure-preserves-checkpoint ()
  (local-test
   (write-region "old checkpoint" nil path)
   (cl-letf (((symbol-function 'ddskk-engine-read-stdio-line) (lambda () "ERR LOCAL STORAGE")))
     (should (equal (ddskk-local-learn local-test-one) "ERR LOCAL STORAGE"))
     (should (equal (nelisp--syscall-read-file path) "old checkpoint"))
     (should (= (hash-table-count ddskk-local-operations) 0)))))
(ert-deftest local-learning-disabled-and-hooks-use-provider ()
  (local-test
   (let ((ddskk-user-jisyo-learning-disabled t)) (should-not (ddskk-local-capability)))
   (let ((skk-search-prog-list '((skk-search-katakana-maybe)))) (should-not (ddskk-local-capability)))
   (should (equal (ddskk-local-learn "LOCAL LEARN malformed 00304b00306a 004eee00540d") "ERR LOCAL LEARN"))))
(ert-deftest local-learning-global-order-and-bounded-watermark ()
  (local-test
   (ddskk-local-learn local-test-one)
   (should (equal (ddskk-local-learn "LOCAL LEARN fedcba9876543210fedcba9876543210.1 00304b00306a 0054c9")
                  "ACK fedcba9876543210fedcba9876543210.1 2"))
   (should (equal (gethash "かな" ddskk-user-jisyo--table) '("哉" "仮名")))
   (should (equal (ddskk-local-learn "LOCAL LEARN 0123456789abcdef0123456789abcdef.2 00304b00306a 004eee00540d")
                  "ACK 0123456789abcdef0123456789abcdef.2 3"))
   (should (= (hash-table-count ddskk-local-operations) 2))
   (should (equal (gethash "かな" ddskk-user-jisyo--table) '("仮名" "哉")))))

(ert-deftest local-okuri-learning-block-order-and-restart ()
  (local-test
   (ddskk-user-jisyo--parse-into-table "かk /書/掛/[く/書/掛/]/[き/掛/書/]/\n" ddskk-user-jisyo--table)
   (should (equal (ddskk-local-learn "LOCAL LEARN 0123456789abcdef0123456789abcdef.1 00304b00006b 00639b 00304f")
                  "ACK 0123456789abcdef0123456789abcdef.1 1"))
   (should (equal (gethash "かk" ddskk-user-jisyo--table) '("掛" "書")))
   (should (equal (gethash "かk" ddskk-user-jisyo--okuri-blocks)
                  '(("く" "掛" "書") ("き" "掛" "書"))))
   (ddskk-user-jisyo-load)
   (should (equal (gethash "かk" ddskk-user-jisyo--okuri-blocks)
                  '(("く" "掛" "書") ("き" "掛" "書"))))
   (let ((skk-henkan-key "かk") (skk-henkan-okurigana "け"))
     (ddskk-user-jisyo--update "書"))
   (should (equal (gethash "かk" ddskk-user-jisyo--okuri-blocks)
                  '(("く" "掛" "書") ("き" "掛" "書") ("け" "書"))))))
(ert-deftest local-okuri-unsupported-options-select-provider ()
  (local-test
   (should (equal (ddskk-local-dispatch "LOCAL STATUS") "LOCAL 3 0"))
   (let ((skk-henkan-okuri-strictly t))
     (should (equal (ddskk-local-dispatch "LOCAL STATUS") "LOCAL 1 0"))
     (should (equal (ddskk-local-learn "LOCAL LEARN 0123456789abcdef0123456789abcdef.1 00304b00006b 00639b 00304f")
                    "ERR LOCAL LEARN")))))

(ert-deftest local-custom-candidate-menu-uses-engine ()
  (local-test
   (let ((skk-henkan-number-to-display-candidates 9))
     (should-not (ddskk-local-capability)))
   (let ((skk-show-candidates-nth-henkan-char 4))
     (should-not (ddskk-local-capability)))
   (let ((skk-henkan-show-candidates-keys '(97 115 100 102 106 107 108)))
     (should (ddskk-local-capability)))
   (let ((skk-henkan-show-candidates-keys '(97 115 100 102 106 107 120)))
     (should-not (ddskk-local-capability)))))
