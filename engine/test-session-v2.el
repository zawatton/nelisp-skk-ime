;;; test-session-v2.el --- Persistent session runtime suite -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
;; Caller supplies DDSKK_USER_JISYO and loads ddskk-engine.el first.
(defvar eg2-checks 0)
(defun eg2-check (condition label)
  (unless condition (error "EG2 session failure: %s" label))
  (setq eg2-checks (1+ eg2-checks)))
(defun eg2-request (id request)
  (ddskk-engine-dispatch-line (concat "SESSION " id " " request)))
(defun eg2-keys (keys)
  (mapconcat #'number-to-string (string-to-list keys) ","))
(defun eg2-prepare (id keys)
  (eg2-request id (concat "V2 PREPARE 2 " (eg2-keys keys))))
(defun eg2-convert (id keys)
  (eg2-request id (concat "V2 CONVERT-LIVE 2 " (eg2-keys keys))))
(defun ddskk-engine--server-request (midasi)
  (or (cdr (assoc midasi '(("かな" . "1/仮名/佳奈/") ("か" . "1/蚊/科/")
                         ("かk" . "1/書/描/[く/書/描/]/")
                         ("よm" . "1/読/詠/[む/読/詠/]/")))) "4"))

(eg2-check (equal (eg2-request "eg2-a" "OPEN 2") "OK OPEN 2") "open")
(eg2-check (equal (eg2-request "eg2-b" "OPEN 2") "OK OPEN 2") "second open")
;; Compare persistent and replay barriers over stock DDSKK input modes.
(dolist (keys '("Kana" "KaKu" "YoMu" "qKana" "/abc" "Kanaq" "Qkana" "Kana\b"))
  (eg2-request "eg2-a" "RESET")
  (eg2-request "eg2-b" "RESET")
  (eg2-prepare "eg2-a" (substring keys 0 1))
  (eg2-prepare "eg2-a" keys)
  (let ((actual (eg2-convert "eg2-a" keys))
        (expected (eg2-request "eg2-b" (concat "CONTROL CONVERT-KEYS " (eg2-keys keys)))))
    (unless (equal actual expected)
      (nelisp--write-stdout-bytes (concat "Mismatch " keys " actual=" actual " expected=" expected "\n")))
    (eg2-check (equal actual expected) (concat "replay equivalence " keys))))

;; Full readings must be fed once, even at the conversion barrier.
(defvar eg2-original-feed (symbol-function 'skk-ime-session-feed-string))
(defvar eg2-fed 0)
(fset 'skk-ime-session-feed-string
      (lambda (session keys)
        (setq eg2-fed (+ eg2-fed (length keys)))
        (funcall eg2-original-feed session keys)))
(eg2-request "eg2-a" "RESET")
(eg2-prepare "eg2-a" "K")
(eg2-prepare "eg2-a" "Ka")
(eg2-prepare "eg2-a" "Kana")
(eg2-convert "eg2-a" "Kana")
(eg2-check (= eg2-fed 4) "each raw key fed once")
(eg2-check (equal (eg2-request "eg2-a" "V2 SPACE 2")
                  (eg2-request "eg2-a" "V2 STATUS")) "already-fed Space does not advance okuri/candidates")
(eg2-check (= eg2-fed 4) "Space carries no raw keys")
(fset 'skk-ime-session-feed-string eg2-original-feed)

;; Client B may prepare while A is navigating; focus switches preserve A.
(let ((a (eg2-request "eg2-a" "V2 STATUS")))
  (eg2-request "eg2-b" "RESET")
  (eg2-prepare "eg2-b" "Ka")
  (eg2-check (equal a (eg2-request "eg2-a" "V2 STATUS")) "interleaved context")
  (eg2-check (not (equal a (eg2-request "eg2-b" "V2 STATUS"))) "no state leakage"))
(let ((first (eg2-request "eg2-a" "V2 STATUS")))
  (eg2-request "eg2-a" "V2 CONTROL CONVERT")
  (eg2-check (equal first (eg2-request "eg2-a" "V2 CONTROL PREVIOUS")) "next previous"))

(defvar eg2-original-checkpoint (symbol-function 'skk-ime-session-checkpoint))
(defvar eg2-checkpoint-count 0)
(fset 'skk-ime-session-checkpoint
      (lambda (session)
        (setq eg2-checkpoint-count (1+ eg2-checkpoint-count))
        (funcall eg2-original-checkpoint session)))
(eg2-request "eg2-a" "RESET")
(eg2-prepare "eg2-a" "Kana")
(setq eg2-checkpoint-count 0)
(eg2-request "eg2-a" "V2 SPACE 2")
(eg2-check (= eg2-checkpoint-count 0) "prepared Space reuses modal checkpoint")
(let ((first (eg2-request "eg2-a" "V2 STATUS")))
  (eg2-check (equal first (eg2-request "eg2-a" "V2 SPACE 2")) "repeated prepared Space does not advance"))
(eg2-request "eg2-a" "RESET")
(eg2-prepare "eg2-a" "Zzz")
(let ((registration (eg2-request "eg2-a" "V2 SPACE 2")))
  (eg2-check (equal (substring registration 0 19) "STATE registration ") "prepared missing reading registers")
  (eg2-check (equal registration (eg2-request "eg2-a" "V2 SPACE 2")) "registration Space preserves modal editor"))
(eg2-request "eg2-a" "RESET")
(fset 'skk-ime-session-checkpoint eg2-original-checkpoint)

;; Eviction is explicit for v2 peers, never an empty state masquerading as A.
(setq ddskk-engine--session-limit 2)
(eg2-request "eg2-a" "V2 STATUS")
(eg2-request "eg2-c" "OPEN 2")
(eg2-check (= (hash-table-count ddskk-engine--sessions) 2) "bounded LRU")
(eg2-check (equal (eg2-request "eg2-b" "V2 STATUS") "ERR SESSION LOST") "LRU victim")
(eg2-request "eg2-b" "OPEN 2")
(eg2-check (equal (eg2-convert "eg2-b" "Kana")
                  (eg2-request "eg2-b" (concat "CONTROL CONVERT-KEYS " (eg2-keys "Kana"))))
           "eviction reading fallback")

;; Process replacement discards all checkpoints. Test the same wire boundary.
(maphash (lambda (_ record) (skk-ime-session-destroy (aref record 0)))
         ddskk-engine--sessions)
(clrhash ddskk-engine--sessions)
(setq ddskk-engine--active-session-id nil)
(eg2-check (equal (eg2-convert "eg2-b" "Kana") "ERR SESSION LOST") "restart detection")
(eg2-request "eg2-b" "OPEN 2")
(eg2-check (equal (eg2-convert "eg2-b" "Kana")
                  (eg2-request "eg2-b" (concat "CONTROL CONVERT-KEYS " (eg2-keys "Kana"))))
           "restart reading fallback")
(eg2-request "eg2-new" "RESET")
(eg2-check (equal (eg2-request "eg2-new" "V2 STATUS") "ERR SESSION LOST") "replacement reset requires open")
(eg2-request "eg2-new" "CLOSE")
(eg2-check (equal (eg2-request "eg2-b" "CLOSE") "OK CLOSED") "close")
(eg2-check (= (hash-table-count ddskk-engine--sessions) 0) "close releases buffer")
(nelisp--write-stdout-bytes (concat "EG2 sessions: " (number-to-string eg2-checks) " checks PASS\n"))
