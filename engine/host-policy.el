;;; host-policy.el --- Private HP2 policy decisions -*- lexical-binding: t; -*-
;; This process has no engine, public pipe, publication or learning API.
;; Inputs are bounded decimal value fields; never read/eval IPC as Lisp.

(defvar host-policy-native-p nil "Set only after the private bundle loads all callables.")

(defun host-policy-decision (kind a b c)
  "Compute a policy decision from copied native policy inputs."
  (cond ((= kind 1) (if (or (= a 0) (= b 1)) a 0)) ; runner availability
        ((= kind 2) (if (= a 0) 0 (if (= b 0) 2 1))) ; file before server
        ((= kind 3) (if (= b 1) 1000 (min 30000 (* a 2))))
        ((= kind 4) (if (>= b (if (= a 1) 60000 2000)) 1 0))
        ((= kind 5) (if (and (= a 1) (= b 1) (= c 1)) 1 0))
        ((= kind 6) (if (and (= a 1) (= b 1)) 1 0)) ; ready FIFO head, or drain
        ((= kind 7) (if (and (= a 1) (or (= b 0) (= c 1))) 1 0)) ; safe swap
        ((= kind 8) (if (or (< a 256) (= b 1)) 1 0)) ; cache admission
        ((= kind 9) (if (and (= a 1) (= b 1) (> c 0)) 1 0)) ; valid changed intent
        ((= kind 10) (if (= a 1) (if (= b 1) 1 0) (if (= b 1) 2 0))) ; files then server
        ((= kind 11) (if (= a 0) 0 (if (= b 1) 2 (if (= c 1) 1 0)))) ; base or overlay payload
        ((= kind 12) (if (= a 1) 60000 2000)) ; SK1 hit/miss duration
        (t -1)))

(defun host-policy-frame-into (line size numbers numeric)
  "Validate SIZE bytes in LINE, reusing NUMBERS and decimal strings in NUMERIC.
Metadata slots 8..10 hold prefix end and the raw kind's start/end indices."
  (let ((pos 6) (field 0))
    (unless (and (<= size 4096) (> size 6)
                 (= (aref line 0) 72) (= (aref line 1) 80)
                 (= (aref line 2) 49) (= (aref line 3) 32)
                 (= (aref line 4) 81) (= (aref line 5) 32))
      (error "HP1 framing"))
    (while (< field 8)
      (let ((start pos) (digit 0))
        (while (and (< pos size) (/= (aref line pos) 32))
          (let ((char (aref line pos)))
            (unless (and (>= char 48) (<= char 57)) (error "HP1 numeric field")))
          (setq digit (1+ digit) pos (1+ pos)))
        (unless (and (> pos start) (< pos size)) (error "HP1 numeric field"))
        ;; Cache exact-length decimal strings. Padding changes the runtime's
        ;; integer fast path and overflow semantics; arithmetic accumulation
        ;; would also change them. Allocate once per observed field length.
        (let ((scratch (or (aref numeric digit)
                           (aset numeric digit (make-string digit 48))))
              (copy 0))
          (while (< copy digit)
            (aset scratch copy (aref line (+ start copy)))
            (setq copy (1+ copy)))
          (aset numbers field (string-to-number scratch)))
        (when (= field 4)
          (aset numbers 8 pos) (aset numbers 9 start) (aset numbers 10 pos))
        (setq pos (1+ pos) field (1+ field))))
    (let ((context-size (- size pos)))
      (unless (or (and (= context-size 1) (= (aref line pos) 45))
                  (and (> context-size 0) (<= context-size 2048)
                       (= (% context-size 2) 0)
                       (let ((valid t))
                         (while (and valid (< pos size))
                           (let ((char (aref line pos)))
                             (unless (or (and (>= char 48) (<= char 57))
                                         (and (>= char 97) (<= char 102)))
                               (setq valid nil)))
                           (setq pos (1+ pos)))
                         valid)))
        (error "HP1 context")))
    (unless (and (>= (aref numbers 4) 1) (<= (aref numbers 4) 12))
      (error "HP1 kind"))
    numbers))

(defun host-policy-frame (line)
  "Compatibility entry point for finite framing probes; not used by the loop."
  (let* ((numbers (host-policy-frame-into line (length line)
                                         (make-vector 11 0) (make-vector 4097 nil)))
         (prefix (substring line 6 (aref numbers 8)))
         (kind (substring line (aref numbers 9) (aref numbers 10))))
    (aset numbers 8 kind)
    (cons numbers prefix)))

(defun host-policy-range-equal (text start end other)
  "Compare an indexed byte range without allocating a substring."
  (and other (= (- end start) (length other))
       (let ((i 0) (same t))
         (while (and same (< start end))
           (unless (= (aref text start) (aref other i)) (setq same nil))
           (setq start (1+ start) i (1+ i)))
         same)))

(defun host-policy-write-reply (line numbers decision reply)
  "Reuse REPLY storage; the byte writer requires one exact-length string."
  (let ((src 6) (dst 6)
        (value (cond ((= decision 0) "0") ((= decision 1) "1")
                     ((= decision 2) "2") ((= decision 1000) "1000")
                     ((= decision 2000) "2000") ((= decision 60000) "60000")
                     (t (number-to-string decision))))
        (i 0))
    (while (< src (aref numbers 8))
      (aset reply dst (aref line src))
      (setq src (1+ src) dst (1+ dst)))
    (aset reply dst 32) (setq dst (1+ dst))
    (while (< i (length value))
      (aset reply dst (aref value i))
      (setq i (1+ i) dst (1+ dst)))
    (aset reply dst 10)
    (nelisp--write-stdout-bytes (substring reply 0 (1+ dst)))))

(defun host-policy-hp2-number (frame offset)
  "Decode one bounded three-digit base-64 value without scanning."
  (let ((a (- (aref frame offset) 32))
        (b (- (aref frame (+ offset 1)) 32))
        (c (- (aref frame (+ offset 2)) 32)))
    (unless (and (>= (min a b c) 0) (<= (max a b c) 63))
      (error "HP2 digit"))
    (+ (* a 4096) (* b 64) c)))

(defun host-policy-hp2-reply (frame pause-kind)
  "Validate the fixed envelope and return its copied ID and numeric decision."
  (unless (and (= (length frame) 23)
               (equal (substring frame 0 4) "HP2Q")
               (= (aref frame 22) 10)
               (>= (aref frame 15) 33) (<= (aref frame 15) 44))
    (error "HP2 framing"))
  (let* ((kind (- (aref frame 15) 32))
         (decision (host-policy-decision kind
                     (if (or (= kind 3) (= kind 8))
                         (host-policy-hp2-number frame 19) (- (aref frame 16) 32))
                     (if (= kind 4) (host-policy-hp2-number frame 19) (- (aref frame 17) 32))
                     (- (aref frame 18) 32))))
    (when (and pause-kind (= kind pause-kind))
      (let ((until (+ (float-time) 3)))
        (while (< (float-time) until))))
    (concat "HP2R" (substring frame 4 15)
            (cond ((= decision 0) "   \n")
                  ((= decision 1) "  !\n")
                  ((= decision 2) "  \"\n")
                  ((= decision 1000) " /H\n")
                  ((= decision 2000) " ?0\n")
                  ((= decision 60000) ".I@\n")
                  (t (string (+ 32 (/ decision 4096))
                             (+ 32 (% (/ decision 64) 64))
                             (+ 32 (% decision 64)) 10))))))

(defun host-policy-hn3-get (bytes at width)
  "Read a little-endian bounded integer; correlation/epochs remain opaque."
  (let ((n 0) (i 0))
    (while (< i width)
      (setq n (+ n (ash (aref bytes (+ at i)) (* 8 i))) i (1+ i))) n))

(defun host-policy-hn3-put (n width)
  ;; Unibyte before aset: interpreted strings enforce fixed character width.
  (let ((s (string-as-unibyte (make-string width 0))) (i 0))
    (while (< i width)
      (aset s i (logand n 255)) (setq n (ash n -8) i (1+ i)))
    (string-as-unibyte s)))

(defun host-policy-hn3-utf8 (s)
  "Reject split, overlong, surrogate and out-of-range UTF-8 fields."
  (let ((i 0) (valid t) (size (length s)))
    (while (and valid (< i size))
      (let ((c (aref s i)) (n 0) (minimum 0))
        (setq i (1+ i))
        (cond ((< c 128))
              ((and (>= c 194) (<= c 223)) (setq n 1 minimum 128 c (logand c 31)))
              ((and (>= c 224) (<= c 239)) (setq n 2 minimum 2048 c (logand c 15)))
              ((and (>= c 240) (<= c 244)) (setq n 3 minimum 65536 c (logand c 7)))
              (t (setq valid nil)))
        (when (> n 0)
          (if (> (+ i n) size) (setq valid nil)
            (while (and valid (> n 0))
              (let ((b (aref s i)))
                (if (/= (logand b 192) 128) (setq valid nil)
                  (setq c (+ (ash c 6) (logand b 63)) i (1+ i) n (1- n))))))
          (when (or (< c minimum) (> c 1114111) (and (>= c 55296) (<= c 57343)))
            (setq valid nil))))) valid))

(defun host-policy-hn3-number (s limit)
  (unless (and (> (length s) 0) (<= (length s) 10)
               (let ((i 0) (ok t))
                 (while (< i (length s))
                   (unless (and (>= (aref s i) 48) (<= (aref s i) 57)) (setq ok nil))
                   (setq i (1+ i))) ok)) (error "HN3 typed number"))
  (let ((n (string-to-number s)))
    (unless (<= n limit) (error "HN3 typed bound")) n))

(defun host-policy-hn3-startup (fields)
  "Reconstruct the copied typed snapshot; never read/eval payloads."
  (let* ((requested (= (host-policy-hn3-number (prog1 (car fields)
						 (unless fields (error "HN3 snapshot tail"))
						 (setq fields (cdr fields))) 1) 1)) (id (prog1 (car fields)
											  (unless fields (error "HN3 snapshot tail"))
											  (setq fields (cdr fields))))
						 (framework (= (host-policy-hn3-number (prog1 (car fields)
											 (unless fields (error "HN3 snapshot tail"))
											 (setq fields (cdr fields))) 1) 1)) (native (= (host-policy-hn3-number (prog1 (car fields)
											 (unless fields (error "HN3 snapshot tail"))
											 (setq fields (cdr fields))) 1) 1))
						 (registry-present (= (host-policy-hn3-number (prog1 (car fields)
												(unless fields (error "HN3 snapshot tail"))
												(setq fields (cdr fields))) 1) 1)) (expansion (= (host-policy-hn3-number (prog1 (car fields)
												(unless fields (error "HN3 snapshot tail"))
												(setq fields (cdr fields))) 1) 1))
						 (expanded (prog1 (car fields)
							     (unless fields (error "HN3 snapshot tail"))
							     (setq fields (cdr fields))))
						 (n (host-policy-hn3-number (prog1 (car fields)
									      (unless fields (error "HN3 snapshot tail"))
									      (setq fields (cdr fields))) 6))
						 (prior nil) (inherited nil) (registry nil))
    (while (> n 0) (push (prog1 (car fields)
			   (unless fields (error "HN3 snapshot tail"))
			   (setq fields (cdr fields))) prior) (setq n (1- n)))
    (setq n (host-policy-hn3-number (prog1 (car fields)
				      (unless fields (error "HN3 snapshot tail"))
				      (setq fields (cdr fields))) 7))
    (while (> n 0)
      (let* ((name (prog1 (car fields)
		     (unless fields (error "HN3 snapshot tail"))
		     (setq fields (cdr fields)))) (value (prog1 (car fields)
		     (unless fields (error "HN3 snapshot tail"))
		     (setq fields (cdr fields))))
		     (units (host-policy-hn3-number (prog1 (car fields)
						      (unless fields (error "HN3 snapshot tail"))
						      (setq fields (cdr fields))) 262144)))
        (push (list name value units) inherited)) (setq n (1- n)))
    (setq n (host-policy-hn3-number (prog1 (car fields)
				      (unless fields (error "HN3 snapshot tail"))
				      (setq fields (cdr fields))) 7))
    (while (> n 0)
      (let* ((name (prog1 (car fields)
		     (unless fields (error "HN3 snapshot tail"))
		     (setq fields (cdr fields)))) (present (= (host-policy-hn3-number (prog1 (car fields)
											(unless fields (error "HN3 snapshot tail"))
											(setq fields (cdr fields))) 1) 1))
		     (type (host-policy-hn3-number (prog1 (car fields)
						     (unless fields (error "HN3 snapshot tail"))
						     (setq fields (cdr fields))) 4294967295))
		     (size (host-policy-hn3-number (prog1 (car fields)
						     (unless fields (error "HN3 snapshot tail"))
						     (setq fields (cdr fields))) 4294967295))
		     (text (prog1 (car fields)
			     (unless fields (error "HN3 snapshot tail"))
			     (setq fields (cdr fields)))) (dword (host-policy-hn3-number (prog1 (car fields)
											   (unless fields (error "HN3 snapshot tail"))
											   (setq fields (cdr fields))) 4294967295)))
        (push (cons name (list :present present :type type :size size :text text :dword dword)) registry))
      (setq n (1- n)))
    (when fields (error "HN3 snapshot excess"))
    (let* ((snapshot (list :requested-present requested :requested-id id
                           :framework-available framework :native-entry native
                           :registry-present registry-present :expansion-ok expansion :expanded-path expanded
                           :prior-imported (nreverse prior) :inherited (nreverse inherited) :registry (nreverse registry)))
           (selection (host-native-select-engine snapshot))
           (plan (host-native-child-env-plan snapshot))
           (imports (plist-get plan :imported)) (ops (plist-get plan :ops))
           (result (append (list (symbol-name (plist-get selection :runner))
                                 (symbol-name (plist-get selection :entry))
                                 (plist-get selection :child-engine-id)
                                 (number-to-string (length imports)) (number-to-string (length ops))) imports)))
      (dolist (op ops)
        (setq result (append result (list (symbol-name (car op)) (cadr op) (or (nth 2 op) ""))))) result)))

(defun host-policy-hn3-reply (frame)
  "Decode complete HN3 v1 data, dispatch pure owners, echo envelope fences."
  (let* ((size (length frame)) (op (host-policy-hn3-get frame 8 2))
         (count (host-policy-hn3-get frame 44 4))
         (expected (host-policy-hn3-get frame 48 4))
         (at 52) (total 0) (fields nil) (status 0) (result nil))
    (unless (and (>= size 52) (equal (substring frame 0 4) "HN3Q")
                 (= (host-policy-hn3-get frame 4 4) (- size 8)) (<= (- size 52) 262144)
                 (>= op 1) (<= op 5) (= (host-policy-hn3-get frame 10 2) 0)
                 (<= count 4096) (<= expected 262144)) (error "HN3 envelope"))
    (while (> count 0)
      (unless (<= (+ at 4) size) (error "HN3 field header"))
      (let ((n (host-policy-hn3-get frame at 4)))
        (setq at (+ at 4))
        (unless (<= (+ at n) size) (error "HN3 field length"))
        (let ((raw (substring frame at (+ at n))))
          (unless (host-policy-hn3-utf8 raw) (error "HN3 UTF-8"))
          (push (decode-coding-string raw 'utf-8) fields))
        (setq at (+ at n) total (+ total n) count (1- count))))
    (unless (and (= at size) (= total expected)) (error "HN3 payload length"))
    (setq fields (nreverse fields))
    (condition-case nil
        (setq result
              (cond ((= op 1) (list (host-native-merge-builtins fields)))
                    ((= op 2) (unless (= (length fields) 2) (error "HN3 arity"))
                     (list (host-native-merge-server-reply (car fields) (cadr fields))))
                    ((= op 3) (unless (= (length fields) 1) (error "HN3 arity"))
                     (list (host-native-engine-dictionary-reply (car fields))))
                    ((= op 4) (unless (= (length fields) 1) (error "HN3 arity"))
                     (list (host-native-quote-engine-string (car fields))))
                    (t (host-policy-hn3-startup fields))))
      (error (setq status 1 result nil)))
    (let ((body "") (payload 0) (n (length result)))
      (dolist (value result)
        (let ((raw (encode-coding-string value 'utf-8)))
          (setq body (concat body (host-policy-hn3-put (length raw) 4) raw)
                payload (+ payload (length raw)))))
      (when (> (length body) 262144) (setq body "" payload 0 n 0 status 2))
      (concat "HN3R" (host-policy-hn3-put (+ 44 (length body)) 4)
              (substring frame 8 10) (host-policy-hn3-put status 2)
              (substring frame 12 44) (host-policy-hn3-put n 4)
              (host-policy-hn3-put payload 4) body))))

(defun host-policy-serve ()
  "Serve unchanged HP2 numeric frames and negotiated HN3 byte envelopes."
  ;; The private bundle driver installs every native function before entering
  ;; here. Reloading the sources would overwrite those authenticated callables.
  (unless host-policy-native-p
    (load "engine/host-native-skk.el" nil t t)
    (load "engine/host-native-startup.el" nil t t))
  (let* ((pending "") (bytes nil)
         (key (or (getenv "NATIVEIME_REGISTRY_KEY") ""))
         (pause-kind (and (equal (getenv "DDSKK_HARNESS_DIAGNOSTICS") "1")
                          (>= (length key) 24)
                          (equal (substring key 0 24) "Software\\NativeIME-test-")
                          (getenv "DDSKK_HOST_POLICY_TEST_PAUSE_KIND")
                          (string-to-number (getenv "DDSKK_HOST_POLICY_TEST_PAUSE_KIND")))))
    ;; Initialize every codec/decision branch before READY. The runtime lazily
    ;; allocates evaluator caches on first use; startup GC must follow that
    ;; initialization, rather than moving its growth collection into traffic.
    (let ((kind 1))
      (while (<= kind 12)
        (host-policy-hp2-reply
         (concat "HP2Q           " (string (+ 32 kind)) "!!\"___\n") nil)
        (setq kind (1+ kind))))
    (host-native-merge-builtins '("/warm;note/[x/skip/]/tail/" "/warm/next/"))
    (host-native-merge-server-reply "/warm/" "/warm;note/next/")
    (host-native-engine-dictionary-reply "1/warm/quote\"/back\\slash/")
    (host-native-quote-engine-string (string 0 10 34 92 127))
    (host-policy-hn3-startup '("0" "" "1" "0" "0" "0" "" "0" "0" "0"))
    (host-policy-hn3-utf8 (encode-coding-string "warm" 'utf-8))
    (host-policy-hn3-put 262143 4)
    (when (fboundp 'garbage-collect) (garbage-collect))
    (nelisp--write-stdout-bytes
     (if host-policy-native-p
         "HP2 READY HN3=1 native=1\n"
       (if (getenv "DDSKK_HOST_POLICY_BUNDLE")
           "HP2 READY HN3=1 native=0\n" "HP2 READY HN3=1\n")))
    ;; A bounded read avoids the old 4096-byte scratch allocation. The native
    ;; adapter owns one outstanding correlation ID and retires timed-out IPC.
    (while (setq bytes (read-stdin-bytes 4096))
      ;; The interpreted runtime returns a multibyte string even for byte IO.
      ;; Recover its exact UTF-8 octets before indexing binary lengths/fields;
      ;; raw-byte characters also round-trip across split input chunks.
      (when (multibyte-string-p bytes)
        (setq bytes (encode-coding-string bytes 'utf-8)))
      (setq pending (if (= (length pending) 0) bytes (concat pending bytes)))
      (let ((advance t))
        (while (and advance (>= (length pending) 4))
          (let ((hn3 (equal (substring pending 0 4) "HN3Q")) (size 23))
            (when hn3
              (if (< (length pending) 8) (setq advance nil)
                (setq size (+ 8 (host-policy-hn3-get pending 4 4)))
                (unless (and (>= size 52) (<= size (+ 52 262144))) (error "HN3 length bound"))))
            (if (or (not advance) (< (length pending) size)) (setq advance nil)
              (let ((frame (substring pending 0 size)))
                (nelisp--write-stdout-bytes
                 (if hn3 (host-policy-hn3-reply frame) (host-policy-hp2-reply frame pause-kind))))
              (setq pending (if (= (length pending) size) "" (substring pending size))))))))
    (unless (= (length pending) 0) (error "policy truncated"))))

(unless (getenv "DDSKK_HOST_POLICY_UNIT_ONLY") (host-policy-serve))
