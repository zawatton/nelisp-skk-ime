;;; test-okuri-input.el --- Stock DDSKK okuri oracle -*- lexical-binding: t; -*-

(require 'ert)
(require 'skk-ime-session)
(remove-hook 'kill-emacs-hook #'skk-save-jisyo)
(remove-hook 'kill-emacs-hook #'skk-record-jisyo-data)

(ert-deftest okuri-input-stock-oracle ()
  "Record stock DDSKK at every TSF checkpoint, including intermediate rules."
  (let* ((source (getenv "OKURI_DICTIONARY"))
         (output (getenv "OKURI_ARTIFACT_DIRECTORY"))
         (skk-jisyo (make-temp-file "okuri-stock-"))
         (skk-jisyo-code (if (string-suffix-p ".utf8" source) 'utf-8 'euc-jp))
         (skk-backup-jisyo nil) (skk-server-host nil)
         (skk-search-prog-list '((skk-search-jisyo-file skk-jisyo 0 t)))
         session records tokens)
    (copy-file source skk-jisyo t)
    (unwind-protect
        (progn
          (setq session (skk-ime-session-create))
          (skk-ime-session--with-buffer session
            (setq-local skk-search-prog-list
                        '((skk-search-jisyo-file skk-jisyo 0 t)))
            (setq-local skk-current-search-prog-list nil))
          (dolist (step '((write "KaKu") (next " ") (commit commit)
                         (disappear "KieRu") (disappear-commit commit)
                         (sokuon-prefix "KaT") (sokuon "t")
                         (sokuon-end "a") (sokuon-commit commit)
                         (n-prefix "SiN") (n-consonant "d")
                         (n-end "a") (n-commit commit)
                         (cancel-candidate "KaKu") (cancel quit)
                         (cancel-clear quit)
                         (back-prefix "KaK") (back backspace)
                         (back-retype "Ku") (back-commit commit)
                         (vowel "KaU") (vowel-cancel quit)
                         (vowel-clear quit)))
            (let* ((label (symbol-name (car step))) (action (cadr step))
                   (state (if (stringp action)
                              (skk-ime-session-feed-string session action)
                            (skk-ime-session-control session action)))
                   (text (plist-get state :text))
                   (hex (mapconcat (lambda (c) (format "%04x" c))
                                   (concat text (plist-get state :pending-romaji)) "")))
              (push (format "%s\t%s\t%s" label (plist-get state :mode) hex) records)
              (push (if (stringp action)
                        (mapconcat (lambda (c) (if (= c 32) "SPACE" (char-to-string c))) action " ")
                      (pcase action ('commit "ENTER") ('quit "CTRLG") ('backspace "BS"))) tokens)
              (push (concat "SETTLE30000:" label) tokens)
              (message "STOCK %s mode=%s text=%s" label (plist-get state :mode) hex)
              (when (memq (car step) '(write disappear sokuon-end n-end back-retype vowel))
                (should (eq (plist-get state :mode) 'candidate)))
              (when (eq (car step) 'write) (should (equal text "▼書く")))
              (when (eq (car step) 'next) (should (equal text "▼掛く")))
              (when (eq (car step) 'cancel)
                (should (string-suffix-p "▽かく" text)))))
          (let ((coding-system-for-write 'utf-8-unix))
            (write-region (concat (mapconcat #'identity (nreverse records) "\n") "\n")
                          nil (expand-file-name "oracle.tsv" output) nil 'silent)
            (write-region (mapconcat #'identity (nreverse tokens) " ")
                          nil (expand-file-name "harness.tokens" output) nil 'silent)))
      (when session (skk-ime-session-destroy session))
      (delete-file skk-jisyo))))
