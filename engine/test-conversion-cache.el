;;; test-conversion-cache.el --- Standalone encoding-cache regression checks
;; Run with a private DDSKK_USER_JISYO and the engine-test runtime.
(load "engine/ddskk-engine.el")
(let ((checked 0))
  (dolist (text '("" "ASCII" "かな" "漢字;annotation" "😀" "𠮷"))
    (unless (equal (ddskk-engine--hex text)
                   (ddskk-engine--hex-uncached text))
      (error "Cached encoding differs from original encoder"))
    (setq checked (1+ checked)))
  (let ((text (copy-sequence "abc")))
    (ddskk-engine--hex text)
    (aset text 0 ?z)
    (unless (equal (ddskk-engine--hex text) "00007a000062000063")
      (error "Input mutation returned a stale encoding"))
    (unless (equal (ddskk-engine--hex "abc") "000061000062000063")
      (error "Input mutation corrupted an existing cache key"))
    (setq checked (+ checked 2)))
  (dotimes (index 520)
    (let ((text (number-to-string index)))
      (unless (equal (ddskk-engine--hex text)
                     (ddskk-engine--hex-uncached text))
        (error "Encoding changed across cache eviction"))
      (setq checked (1+ checked))))
  (unless (<= (hash-table-count ddskk-engine--hex-cache) 512)
    (error "Encoding cache exceeded its bound"))
  (nelisp--write-stdout-bytes
   (concat "PASS conversion-cache checked=" (number-to-string checked) "\n")))
