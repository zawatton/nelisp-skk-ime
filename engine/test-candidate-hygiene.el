;;; test-candidate-hygiene.el --- Private CRLF regression checks -*- lexical-binding: t; -*-
(load "engine/ddskk-engine.el" nil t)
(let ((checks 0) (failures 0))
  (cl-labels ((check (value label)
                (setq checks (1+ checks))
                (unless value
                  (setq failures (1+ failures))
                  (nelisp--write-stdout-bytes (concat "FAIL " label "\n")))))
    (check (equal (gethash "crtest" ddskk-user-jisyo--table) '("Alpha" "Beta"))
           "CRLF base candidates")
    (check (equal (gethash "crtestk" ddskk-user-jisyo--table) '("Gamma"))
           "first CR candidate removed")
    (check (equal (gethash "journaltest" ddskk-user-jisyo--table) '("Delta"))
           "CRLF journal candidates")
    (let ((ddskk-engine--utf8-wire t))
      (check (equal (ddskk-engine--parse-server-reply
                     "LIST (\"Alpha\" \"\\015\" \" \\011\\177\" \"\")")
                    '("Alpha")) "quoted server controls filtered"))
    (check (equal (ddskk-engine--parse-server-reply "1/Alpha/\r/ \t/")
                  '("Alpha")) "legacy server controls filtered")
    (dolist (word '("" "\r" "\n" " \t\177" "　"))
      (ddskk-user-jisyo-record "badrecord" word)
      (let ((skk-henkan-key "badupdate")) (ddskk-user-jisyo--update word)))
    (check (null (gethash "badrecord" ddskk-user-jisyo--table)) "record rejects controls")
    (check (null (gethash "badupdate" ddskk-user-jisyo--table)) "learning rejects controls")
    (check (not (string-match "badrecord\\|badupdate"
                              (nelisp--syscall-read-file (ddskk-user-jisyo--journal-path))))
           "journal excludes invalid learning")
    (check (equal (ddskk-user-jisyo--clean-candidate "Al\r\npha;note") "Alpha;note")
           "substantive text and annotation preserved")
    (let ((table (make-hash-table :test 'equal)))
      (puthash "stale" '("Old") table)
      (ddskk-user-jisyo--parse-into-table "stale /\r/\r\nempty ///\n" table)
      (check (and (null (gethash "stale" table)) (null (gethash "empty" table)))
             "invalid-only journal snapshot removes stale entry"))
    (check (not (string-match "\r" (nelisp--syscall-read-file (ddskk-user-jisyo-path))))
           "base rewritten LF on load")
    (check (not (string-match "\r" (nelisp--syscall-read-file (ddskk-user-jisyo--journal-path))))
           "journal rewritten LF on load")
    (ddskk-user-jisyo-flush)
    (check (not (string-match "badrecord\\|badupdate\\|\r"
                              (nelisp--syscall-read-file (ddskk-user-jisyo-path))))
           "save excludes invalid learning")
    (nelisp--write-stdout-bytes
     (format "Candidate hygiene: %d checks, %d failures\n" checks failures))
    (when (> failures 0) (error "Candidate hygiene regression"))))
