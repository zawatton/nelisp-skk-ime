(require 'ert)
(require 'cl-lib)
(require 'skk-user-jisyo)

(ert-deftest eg2-learning-update-does-no-file-io ()
  (let ((ddskk-engine--learning-worker t)
        (ddskk-engine--learning-dirty nil)
        (ddskk-engine--learning-keys nil)
        (ddskk-user-jisyo-learning-disabled nil)
        (ddskk-user-jisyo--table (make-hash-table :test 'equal))
        (ddskk-user-jisyo--okuri-blocks (make-hash-table :test 'equal))
        (ddskk-user-jisyo--sections (make-hash-table :test 'equal))
        (skk-henkan-key "かk") (skk-henkan-okurigana "く"))
    (cl-letf (((symbol-function 'write-region) (lambda (&rest _) (ert-fail "learning did file I/O"))))
      (ddskk-user-jisyo--update "書")
      (should (equal (gethash "かk" ddskk-user-jisyo--table) '("書")))
      (should ddskk-engine--learning-dirty)
      (should (ddskk-user-jisyo-save))
      (should (ddskk-user-jisyo-flush))
      (ddskk-user-jisyo--update "書" t)
      (should-not (gethash "かk" ddskk-user-jisyo--table)))))

(ert-deftest eg2-checkpoint-supersedes-stale-journal ()
  (let* ((directory (make-temp-file (expand-file-name "eg2-learning-" (getenv "LOCAL_LEARNING_TEST_DIR")) t))
         (path (expand-file-name "user.jisyo" directory))
         (ddskk-user-jisyo--table (make-hash-table :test 'equal))
         (ddskk-user-jisyo--okuri-blocks (make-hash-table :test 'equal))
         (ddskk-user-jisyo--sections (make-hash-table :test 'equal))
         (saved (getenv "DDSKK_USER_JISYO")))
    (unwind-protect
        (progn
          (setenv "DDSKK_USER_JISYO" path)
          (write-region ";; EG2 checkpoint v2\n;; EG2 journal 8 00304b00306a00002000002f0053e400304400002f00000a\n;; okuri-nasi entries.\nかな /仮名/佳奈/\n" nil path)
          (write-region "かな /古い/\n" nil (concat path ".journal"))
          (ddskk-user-jisyo-load)
          (should (equal (gethash "かな" ddskk-user-jisyo--table) '("仮名" "佳奈")))
          ;; An old engine can learn after a clean v2 checkpoint. Its new
          ;; journal must be replayed, rather than discarded by the marker.
          (write-region "かな /新しい/\n" nil (concat path ".journal"))
          (ddskk-user-jisyo-load)
          (should (equal (gethash "かな" ddskk-user-jisyo--table) '("新しい"))))
      (setenv "DDSKK_USER_JISYO" saved)
      (delete-directory directory t))))

(require 'conversion-hot-path)
(ert-deftest eg2-marker-transition-stock-equivalence ()
  (dolist (text '("▽かな" "prefix▽かな" "▽カナ" "▽a" "▽😀"))
    (let (reference)
      (dolist (function '(skk-change-marker ddskk-engine--change-marker))
        (with-temp-buffer
          (insert text)
          (let ((skk-henkan-start-point (+ (or (string-match "▽" text) 0) 2))
                (skk-henkan-mode 'on) (buffer-undo-list nil))
            (goto-char (point-max))
            (funcall function)
            (let ((actual (list (buffer-string) (point) skk-henkan-mode buffer-undo-list)))
              (if reference (should (equal reference actual)) (setq reference actual)))))))))

(ert-deftest eg2-stock-search-order-and-numeric-bindings ()
  (dolist (context '(("かな" nil) ("かな" t) ("12" t) ("12" nil)))
    (let ((skk-current-search-prog-list '((ddskk-user-jisyo-search) (ddskk-engine-server-search) (list "extension")))
          (skk-henkan-key (car context)) (skk-use-numeric-conversion (cadr context))
          skk-search-state seen)
      (cl-letf (((symbol-function 'ddskk-user-jisyo-search)
                 (lambda () (push (cons 'user skk-use-numeric-conversion) seen) nil))
                ((symbol-function 'ddskk-engine-server-search)
                 (lambda () (push (cons 'server skk-use-numeric-conversion) seen) (list "仮名"))))
        (should (equal (skk-search) '("仮名")))
        (should (equal skk-current-search-prog-list '((list "extension"))))
        (should (equal (nth 1 skk-search-state) '(ddskk-engine-server-search)))
        (should (equal seen (if (and (equal (car context) "12") (cadr context))
                               '((server . t) (server) (user . t) (user))
                             '((server) (user)))))))))
