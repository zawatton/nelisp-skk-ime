;;; test-registration-nested.el --- RG1 runtime regression -*- lexical-binding: t; -*-
(unless (getenv "DDSKK_USER_JISYO") (error "Private DDSKK_USER_JISYO required"))
(load "engine/ddskk-engine.el")
(setq ddskk-engine--debug-errors t skk-search-prog-list '((ddskk-user-jisyo-search)))
(defvar rg1-checks 0)
(defun rg1-check (condition label)
  (unless condition (error "RG1: %s" label))
  (setq rg1-checks (1+ rg1-checks)))
(defun rg1-request (line)
  (let ((reply (ddskk-engine-dispatch-line (concat "SESSION rg1 " line))))
    (nelisp--write-stdout-bytes (concat line " => " reply "\n")) reply))
(defun rg1-feed (keys)
  (rg1-request (concat "CONTROL FEED-KEYS "
                       (mapconcat #'number-to-string (string-to-list keys) ","))))
(defun rg1-enter (exhaust)
  (rg1-request "RESET")
  (remhash "ぱぱぱ" ddskk-user-jisyo--table)
  (if exhaust (puthash "ぱぱぱ" '("既存") ddskk-user-jisyo--table))
  (let ((reply (rg1-request "CONTROL CONVERT-KEYS 80,97,112,97,112,97")))
    (if exhaust (setq reply (rg1-request "CONTROL CONVERT")))
    (rg1-check (string-match "STATE registration " reply) "registration entry")))
(puthash "あい" '("愛") ddskk-user-jisyo--table)
(puthash "かk" '("書") ddskk-user-jisyo--table)
(dolist (exhaust '(nil t))
  (dolist (nested '("Ai" "KaKu"))
    (dolist (following '(nil t))
      (rg1-enter exhaust)
      (rg1-feed "te")
      (rg1-feed nested)
      (when (equal nested "Ai") (rg1-request "CONTROL CONVERT"))
      (when following
        (dolist (key (string-to-list "suto"))
          (rg1-request (concat "KEY " (number-to-string key)))))
      (let* ((word (concat "て" (if (equal nested "Ai") "愛" "書く")
                           (if following "すと" "")))
             (reply (rg1-request "CONTROL COMMIT")))
        (rg1-check (not (string-match "STATE registration " reply)) "RET finishes nested registration")
        (rg1-check (equal reply (concat "STATE hiragana " (number-to-string (length word))
                                        " -1 " (ddskk-engine--hex word) " - -1 -")) "composed word exactly once")
        (rg1-check (equal (car (gethash "ぱぱぱ" ddskk-user-jisyo--table)) word) "learning")))))
;; Negative controls: cancellation never learns the composed outer word.
(dolist (exhaust '(nil t))
  (dolist (level '(idle prefix reading candidate okuri))
    (rg1-enter exhaust)
    (rg1-feed "te")
    (cond ((eq level 'prefix) (rg1-feed "k"))
          ((eq level 'reading) (rg1-feed "Ai"))
          ((eq level 'candidate) (rg1-feed "Ai") (rg1-request "CONTROL CONVERT"))
          ((eq level 'okuri) (rg1-feed "KaKu")))
    (let ((reply (rg1-request "CONTROL QUIT")))
      (if (eq level 'idle)
          (rg1-check (not (string-match "STATE registration " reply)) "idle quit exits registration")
        (rg1-check (string-match "STATE registration " reply) "nested quit retains registration")
        (when (memq level '(candidate okuri))
          (rg1-check (string-match "0025bd" reply) "candidate quit restores nested reading")
          (rg1-request "CONTROL QUIT"))
        (setq reply (rg1-request "CONTROL QUIT")))
      (rg1-check (equal reply
                        (if exhaust
                            "STATE candidate 3 1 0025bc0065e2005b58 - 0 0065e2005b58"
                          "STATE preedit 4 1 0025bd003071003071003071 - -1 -"))
                 "outer quit matches stock miss/exhaustion")
      (rg1-check (equal (gethash "ぱぱぱ" ddskk-user-jisyo--table)
                        (if exhaust '("既存") nil)) "cancel never learns"))))
(rg1-enter nil)
(rg1-request "KEY 116")
(rg1-request "KEY 101")
(rg1-check (equal (rg1-request "CONTROL QUIT")
                 "STATE preedit 4 1 0025bd003071003071003071 - -1 -")
           "completed kana C-g exits registration")
(rg1-check (equal (rg1-request "CONTROL QUIT") "STATE hiragana 0 -1 - - -1 -")
           "second C-g clears outer reading")
(rg1-check (not (gethash "ぱぱぱ" ddskk-user-jisyo--table)) "two C-g never learns")
(rg1-check (string-match "STATE preedit " (rg1-request "KEY 80"))
           "uppercase key starts fresh reading after cancellation")
(rg1-request "CONTROL QUIT")

(defun rg1-depth (depth reading)
  (let ((record (gethash "rg1" ddskk-engine--sessions)))
    (rg1-check (= (length (aref record 1)) depth) "frame depth")
    (when (> depth 0)
      (rg1-check (equal (aref (car (aref record 1)) 1) reading)
                 "innermost reading"))))
(defun rg1-editor (text cursor)
  (let ((editor (aref (car (aref (gethash "rg1" ddskk-engine--sessions) 1)) 3)))
    (rg1-check (equal (aref editor 0) text) "outer editor text")
    (rg1-check (= (aref editor 1) cursor) "outer editor cursor")))
(defun rg1-inner (exhaust &optional feed)
  (remhash "ぴぴぴ" ddskk-user-jisyo--table)
  (when exhaust (puthash "ぴぴぴ" '("内候補") ddskk-user-jisyo--table))
  (rg1-feed "Pipipi")
  (if feed (rg1-feed (if exhaust "  " " "))
    (progn
      (rg1-request "CONTROL CONVERT")
      (when exhaust (rg1-request "CONTROL CONVERT"))))
  (rg1-depth 2 "ぴぴぴ"))
;; The child result belongs at the saved cursor, even in the middle of text.
(dolist (exhaust '(nil t))
  (dolist (feed '(nil t))
    (rg1-enter nil)
    (rg1-feed "tesuto")
    (rg1-request "CONTROL HOME")
    (rg1-request "CONTROL RIGHT")
    (rg1-inner exhaust feed)
    (rg1-feed "ai")
    (rg1-request "CONTROL COMMIT")
    (rg1-depth 1 "ぱぱぱ")
    (rg1-editor "てあいすと" 3)
    (rg1-check (equal (gethash "ぴぴぴ" ddskk-user-jisyo--table)
                     (if exhaust '("あい" "内候補") '("あい"))) "inner learned")
    (rg1-request "CONTROL COMMIT")
    (rg1-depth 0 "")
    (rg1-check (equal (car (gethash "ぱぱぱ" ddskk-user-jisyo--table))
                     "てあいすと") "outer contains learned inner")))
;; Empty RET and idle QUIT restore the child's reading/candidate without learning.
(dolist (exhaust '(nil t))
  (dolist (finish '(nil t))
    (rg1-enter nil)
    (rg1-feed "tesuto")
    (rg1-request "CONTROL LEFT")
    (rg1-inner exhaust)
    (unless finish (rg1-feed "ai"))
    (let ((pending ddskk-user-jisyo--journal-pending)
          (reply (rg1-request (if finish "CONTROL COMMIT" "CONTROL QUIT"))))
      (rg1-depth 1 "ぱぱぱ")
      (rg1-editor "てすと" 2)
      (rg1-check (string-match (ddskk-engine--hex
                               (if exhaust "▼内候補" "▽ぴぴぴ")) reply)
                 "child cancel state")
      (rg1-check (= pending ddskk-user-jisyo--journal-pending) "cancel no journal")
      (rg1-check (equal (gethash "ぴぴぴ" ddskk-user-jisyo--table)
                       (if exhaust '("内候補") nil)) "child cancel no learning"))
    (when exhaust (rg1-request "CONTROL QUIT"))
    (rg1-request "CONTROL QUIT")
    (rg1-request "CONTROL QUIT")
    (rg1-request "CONTROL QUIT")
    (rg1-depth 0 "")
    (rg1-check (not (gethash "ぱぱぱ" ddskk-user-jisyo--table)) "cancel chain no outer learning")))
;; Three levels, both successful unwinding and complete cancellation.
(dolist (cancel '(nil t))
  (rg1-enter nil)
  (rg1-feed "te")
  (rg1-inner nil)
  (rg1-feed "su")
  (remhash "ぷぷぷ" ddskk-user-jisyo--table)
  (rg1-feed "Pupupu")
  (rg1-request "CONTROL CONVERT")
  (rg1-depth 3 "ぷぷぷ")
  (if cancel
      (let ((pending ddskk-user-jisyo--journal-pending))
        (dotimes (_ 6) (rg1-request "CONTROL QUIT"))
        (rg1-depth 0 "")
        (rg1-check (= pending ddskk-user-jisyo--journal-pending) "cancel chain no journal")
        (dolist (reading '("ぱぱぱ" "ぴぴぴ" "ぷぷぷ"))
          (rg1-check (not (gethash reading ddskk-user-jisyo--table)) "cancel chain never learns")))
    (progn
      (rg1-feed "to")
      (rg1-request "CONTROL COMMIT")
      (rg1-depth 2 "ぴぴぴ")
      (rg1-editor "すと" 2)
      (rg1-request "CONTROL COMMIT")
      (rg1-depth 1 "ぱぱぱ")
      (rg1-editor "てすと" 3)
      (rg1-request "CONTROL COMMIT")
      (rg1-depth 0 "")
      (dolist (entry '(("ぷぷぷ" . "と") ("ぴぴぴ" . "すと") ("ぱぱぱ" . "てすと")))
        (rg1-check (equal (car (gethash (car entry) ddskk-user-jisyo--table))
                         (cdr entry)) "three levels learned")))))
;; Automatic okuri conversion and a KEY SPACE also enter child registration.
(rg1-enter nil)
(remhash "ぴp" ddskk-user-jisyo--table)
(rg1-feed "PiPu")
(rg1-depth 2 "ぴp")
(rg1-feed "te")
(rg1-request "CONTROL COMMIT")
(rg1-editor "てぷ" 2)
(rg1-request "CONTROL QUIT")
(rg1-enter nil)
(remhash "ぴぴぴ" ddskk-user-jisyo--table)
(rg1-feed "Pipipi")
(rg1-request "KEY 32")
(rg1-depth 2 "ぴぴぴ")
(rg1-request "CONTROL QUIT")
(rg1-request "CONTROL QUIT")
(rg1-request "CONTROL QUIT")
;; The cap refuses one more prompt and leaves a cancellable reading at depth 8.
(rg1-enter nil)
(remhash "ぴぴぴ" ddskk-user-jisyo--table)
(dotimes (_ 7)
  (rg1-feed "Pipipi")
  (rg1-request "CONTROL CONVERT"))
(rg1-depth 8 "ぴぴぴ")
(rg1-feed "Pipipi")
(rg1-request "CONTROL CONVERT")
(rg1-depth 8 "ぴぴぴ")
(let ((pending ddskk-user-jisyo--journal-pending))
  (dotimes (_ 17) (rg1-request "CONTROL QUIT"))
  (rg1-depth 0 "")
  (rg1-check (= pending ddskk-user-jisyo--journal-pending) "depth refusal never learns"))

;; Client switches keep both the suspended editors and native child state.
(rg1-enter nil)
(rg1-feed "te")
(rg1-inner t)
(rg1-feed "su")
(ddskk-engine-dispatch-line "SESSION rg1-other RESET")
(ddskk-engine-dispatch-line "SESSION rg1-other KEY 97")
(rg1-request "CONTROL COMMIT")
(rg1-depth 1 "ぱぱぱ")
(rg1-editor "てす" 2)
(rg1-request "CONTROL QUIT")
;; Exhaustion also nests at depth 3, including a whole queued child input.
(rg1-enter nil)
(rg1-inner nil)
(rg1-feed "Ai")
(rg1-request "CONTROL CONVERT")
(rg1-request "CONTROL CONVERT")
(rg1-depth 3 "あい")
(rg1-feed "su")
(rg1-request "CONTROL COMMIT")
(rg1-depth 2 "ぴぴぴ")
(rg1-editor "す" 1)
(rg1-request "CONTROL COMMIT")
(rg1-request "CONTROL COMMIT")
(rg1-check (equal (car (gethash "ぱぱぱ" ddskk-user-jisyo--table)) "す")
           "depth 3 exhaustion outer learned")
(rg1-enter nil)
(remhash "ぴぴぴ" ddskk-user-jisyo--table)
(rg1-feed "Pipipi te")
(rg1-depth 2 "ぴぴぴ")
(rg1-editor "て" 1)
(rg1-request "CONTROL QUIT")
(rg1-request "CONTROL QUIT")
(rg1-request "CONTROL QUIT")
;; The existing learning worker stages inner and outer keys before each reply.
(rg1-enter nil)
(rg1-inner nil)
(let ((ddskk-engine--learning-worker t)
      (ddskk-engine--learning-keys nil)
      (ddskk-engine--learning-dirty nil))
  (rg1-feed "te")
  (rg1-request "CONTROL COMMIT")
  (rg1-check (equal ddskk-engine--learning-keys '("ぴぴぴ")) "inner learning queued before reply")
  (rg1-check ddskk-engine--learning-dirty "inner learning publication pending")
  (rg1-request "CONTROL COMMIT")
  (rg1-check (equal ddskk-engine--learning-keys '("ぱぱぱ" "ぴぴぴ"))
             "both learning operations queued"))
(nelisp--write-stdout-bytes (concat "PASS RG1 assertions=" (number-to-string rg1-checks) "\n"))
