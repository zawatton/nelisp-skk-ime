(require 'ert)
(require 'skk)
(load (expand-file-name "engine/skk-input-rules.el"))
(require 'skk-ime-session)

(ert-deftest input-rules-configured-prefix-precedes-shift-digit-fallback ()
  (with-temp-buffer
    (let* ((session (skk-ime-session--make :buffer (current-buffer)))
           (skk-input-rules-config (skk-input-rules-parse "width = zenkaku"))
           (skk-j-mode t) (skk-latin-mode nil) (skk-jisx0208-latin-mode nil)
           (skk-abbrev-mode nil) (skk-prefix "") (skk-current-rule-tree nil)
           (skk-j-mode-map (make-sparse-keymap)))
      (define-key skk-j-mode-map "!" 'skk-insert)
      (cl-letf (((symbol-function 'skk-ime-session--call-command)
                 (lambda (command)
                   (should (eq command 'skk-insert)) (insert "！")))
                ((symbol-function 'skk-ime-session-snapshot)
                 (lambda (_) (buffer-string))))
        (should (equal (skk-ime-session-feed-key session ?!) "！"))
        (should (equal (skk-ime-session-feed-key session ?3) "！3"))
        (setq skk-j-mode nil skk-latin-mode t)
        (should (equal (skk-ime-session-feed-key session ?!) "！3!"))))))

(ert-deftest input-rules-export-cache-invalidates-with-tree-and-options ()
  (let ((skk-input-rules--export-key nil) (skk-input-rules--export-value nil)
        (skk-input-rules-config (skk-input-rules-parse ""))
        (tree '(root)) (walks 0))
    (cl-letf (((symbol-function 'ddskk-engine--romaji-walk)
               (lambda (_) (setq walks (1+ walks)) '("record")))
              ((symbol-function 'ddskk-engine--hex) #'identity))
      (let ((first (skk-input-rules-export tree)))
        (should (eq first (skk-input-rules-export tree)))
        (should (= walks 1))
        (should (string-match "input-pair" first)))
      (setq skk-input-rules-config (skk-input-rules-parse "auto-pair = no"))
      (should-not (string-match "input-pair" (skk-input-rules-export tree)))
      (should (= walks 2))
      (skk-input-rules-export '(changed))
      (should (= walks 3)))))

(ert-deftest input-rules-defaults ()
  (let ((d (skk-input-rules-parse "")))
    (should (equal (plist-get d :width) "hankaku"))
    (should (plist-get d :auto-pair))
    (should-not (plist-get d :errors))
    (should (equal (cadr (assoc "." (cdr (assoc "symbols-hankaku" (plist-get d :tables))))) ". "))))
(ert-deftest input-rules-quoted-spaces-comments-and-escapes ()
  (let* ((d (skk-input-rules-parse "[symbols-hankaku]\n\"z \" = \" # \\\" \\\\ \" # note\n"))
         (row (assoc "z " (cdr (assoc "symbols-hankaku" (plist-get d :tables))))))
    (should-not (plist-get d :errors))
    (should (equal (nth 1 row) " # \" \\ "))))
(ert-deftest input-rules-errors-skip-only-the-bad-lines ()
  (let ((d (skk-input-rules-parse "width = bogus\nauto-pair = no\n[other]\nx = \"y\"\n[symbols-hankaku]\n. = \"custom\"\n! = unquoted\n")))
    (should (equal (plist-get d :width) "hankaku"))
    (should-not (plist-get d :auto-pair))
    (should (= (length (plist-get d :errors)) 4))
    (should (string-match "line 1:" (nth 0 (plist-get d :errors))))
    (should (string-match "line 3:" (nth 1 (plist-get d :errors))))
    (should (string-match "line 4:" (nth 2 (plist-get d :errors))))
    (should (string-match "line 7:" (nth 3 (plist-get d :errors))))
    (should (equal (cadr (assoc "." (cdr (assoc "symbols-hankaku" (plist-get d :tables))))) "custom"))))
(ert-deftest input-rules-idempotent-and-width-switch ()
  (let ((skk-rom-kana-rule-list (copy-tree skk-rom-kana-rule-list))
        (skk-input-rules--base nil) (skk-input-rules--base-saved nil)
        (skk-rule-tree nil))
    (skk-input-rules-apply (skk-input-rules-parse ""))
    (let ((first (copy-tree skk-rom-kana-rule-list)))
      (skk-input-rules-apply (skk-input-rules-parse ""))
      (should (equal first skk-rom-kana-rule-list)))
    (should (equal (nth 2 (assoc "." skk-rom-kana-rule-list)) ". "))
    (skk-input-rules-apply (skk-input-rules-parse "width = zenkaku"))
    (should (equal (nth 2 (assoc "." skk-rom-kana-rule-list)) "。"))
    (should (equal (nth 2 (assoc "{" skk-rom-kana-rule-list)) "｛"))
    (skk-input-rules-apply (skk-input-rules-parse ""))
    (should (equal (nth 2 (assoc "{" skk-rom-kana-rule-list)) "{"))))
(ert-deftest input-rules-special-midashi-exclusion ()
  (let ((skk-input-rules-config (skk-input-rules-parse "[pairs]\n? = \"?\" \"!\"\n")))
    (should-not (assoc "?" (skk-input-rules-pairs)))
    (should (equal (nth 2 (assoc "「" (skk-input-rules-pairs))) "」"))))
(ert-deftest input-rules-template-matches-defaults ()
  (let ((text (with-temp-buffer
                (let ((coding-system-for-read 'utf-8))
                  (insert-file-contents "windows/keymap/input-rules.conf"))
                (buffer-string))))
    (let ((d (skk-input-rules-parse text)))
      (should-not (plist-get d :errors))
      (dolist (table (plist-get (skk-input-rules-defaults) :tables))
        (should (= (length (cdr table)) (length (cdr (assoc (car table) (plist-get d :tables))))))
        (dolist (row (cdr table))
          (should (equal row (assoc (car row) (cdr (assoc (car table) (plist-get d :tables)))))))))))
(ert-deftest input-rules-file-path-and-missing-file ()
  (let ((process-environment (copy-sequence process-environment))
        (skk-input-rules--base-saved nil) (skk-input-rules--base nil)
        (skk-rom-kana-rule-list (copy-tree skk-rom-kana-rule-list)) (skk-rule-tree nil))
    (setenv "NELISP_IME_INPUT_RULES" "build/does-not-exist.conf")
    (should (equal (skk-input-rules-path) "build/does-not-exist.conf"))
    (skk-input-rules-load)
    (should (equal (nth 2 (assoc "." skk-rom-kana-rule-list)) ". "))
    (setenv "NELISP_IME_INPUT_RULES" nil) (setenv "APPDATA" "build/roaming")
    (should (string-match "NativeIME/input-rules.conf\\'" (skk-input-rules-path)))))
(ert-deftest input-rules-metadata-options ()
  (cl-letf (((symbol-function 'ddskk-engine--hex) #'identity))
    (let ((skk-input-rules-config (skk-input-rules-parse "")))
      (should (string-match "input-pair:)" (skk-input-rules-metadata))))
    (let ((skk-input-rules-config (skk-input-rules-parse "auto-pair = no")))
      (should-not (string-match "input-pair" (skk-input-rules-metadata)))
      (should (string-match "hankaku:no:input-options" (skk-input-rules-metadata))))))

(ert-deftest input-rules-native-reader-does-not-use-file-exists-stub ()
  (let ((process-environment (copy-sequence process-environment))
        (skk-input-rules--base-saved nil) (skk-input-rules--base nil)
        (skk-rom-kana-rule-list (copy-tree skk-rom-kana-rule-list)) (skk-rule-tree nil))
    (setenv "NELISP_IME_INPUT_RULES" "build/private.conf")
    (cl-letf (((symbol-function 'nelisp--syscall-read-file)
               (lambda (path)
                 (should (equal path "build/private.conf"))
                 "width = zenkaku\n[symbols-zenkaku]\n. = \"EDIT \"\n"))
              ((symbol-function 'file-exists-p) (lambda (_) nil)))
      (skk-input-rules-load)
      (should (equal (nth 2 (assoc "." skk-rom-kana-rule-list)) "EDIT ")))))

(ert-deftest input-rules-tree-outputs-match-full-ddskk-compiler ()
  (let ((skk-input-rules--base-saved nil) (skk-input-rules--base nil)
        (skk-rom-kana-rule-list (copy-tree skk-rom-kana-rule-list)) (skk-rule-tree nil))
    (dolist (width '("hankaku" "zenkaku"))
      (skk-input-rules-apply (skk-input-rules-parse (concat "width = " width)))
      (let ((full (skk-compile-rule-list skk-rom-kana-base-rule-list skk-rom-kana-rule-list)))
        (dolist (row (append (skk-input-rules-active-table "symbols")
                             (skk-input-rules-active-table "pairs")))
          (let ((actual skk-rule-tree) (expected full))
            (dolist (ch (string-to-list (car row)))
              (setq actual (assq ch (nth 4 actual)) expected (assq ch (nth 4 expected))))
            (should (equal (nth 2 actual) (nth 2 expected)))
            (should (equal (nth 3 actual) (nth 3 expected)))))))))

(ert-deftest input-rules-new-prefix-bindings-restore-on-width-switch ()
  (let ((skk-j-mode-map (copy-keymap skk-j-mode-map)) (skk-input-rules--bindings nil)
        (skk-input-rules--base-saved nil) (skk-input-rules--base nil)
        (skk-rom-kana-rule-list (copy-tree skk-rom-kana-rule-list)) (skk-rule-tree nil))
    (let ((original (lookup-key skk-j-mode-map "l")))
      (skk-input-rules-apply (skk-input-rules-parse "[symbols-hankaku]\nl = \"literal\"\n"))
      (should (eq (lookup-key skk-j-mode-map "!") 'skk-insert))
      (should (eq (lookup-key skk-j-mode-map "l") 'skk-insert))
      (skk-input-rules-apply (skk-input-rules-parse "width = zenkaku"))
      (should (equal (lookup-key skk-j-mode-map "l") original)))))
