;;; conversion-profile.el --- Opt-in phase tracing for private benchmarks
;; Loaded only when DDSKK_CONVERSION_PROFILE=1. No runtime clock required:
;; the host timestamps PHASE lines and records engine CPU per dispatch.
(defmacro ddskk-profile-wrap (name)
  (let ((saved (intern (concat "ddskk-profile-original-" (symbol-name name))))
        (enter (concat "enter:" (symbol-name name)))
        (leave (concat "leave:" (symbol-name name))))
    `(progn
       (defalias ',saved (symbol-function ',name))
       (defun ,name (&rest args)
         (ddskk-engine--phase ,enter)
         (unwind-protect (apply ',saved args)
           (ddskk-engine--phase ,leave))))))
(ddskk-profile-wrap ddskk-engine-dispatch-line)
(ddskk-profile-wrap skk-ime-session--call-command)
