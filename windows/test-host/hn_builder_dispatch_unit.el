;;; hn_builder_dispatch_unit.el --- Builder stream tests -*- lexical-binding: t; -*-
(require 'cl-lib)
(load (expand-file-name "../../engine/host-native-index.el"
                        (file-name-directory load-file-name)) nil t t)

(when (equal (getenv "HN_BUILDER_DISPATCH_CONTROL") "strip-bom")
  (fset 'host-native-parse-jisyo-batch
        (let ((original (symbol-function 'host-native-parse-jisyo-batch)))
          (lambda (lines &optional _first-line) (funcall original lines t)))))

(let ((checks 0))
  (cl-labels
      ((check (value label)
         (setq checks (1+ checks))
         (unless value (error "builder dispatch check %s: %s" checks label)))
       (frame (lines &optional seq flags generation)
         (let ((payload (mapconcat
                         (lambda (line) (concat (host-native-index--put (length line) 4) line))
                         lines "")))
           (concat "HNBQ" (host-native-index--put (+ 32 (length payload)) 4)
                   (unibyte-string 1 0 0 0) (or generation (apply #'unibyte-string (make-list 8 255)))
                   (host-native-index--put 7 4) (host-native-index--put (or seq 0) 4)
                   (host-native-index--put (or flags 1) 4)
                   (host-native-index--put (length lines) 4)
                   (host-native-index--put (length payload) 4) payload)))
       (reject (wire label)
         (check (condition-case nil (progn (host-native-index--reply wire) nil) (error t)) label)))
    (let* ((bom (unibyte-string 239 187 191))
           (wire (frame (list (concat bom "key /tail/\r") ";;skip" "bad" " /")))
           (reply (host-native-index--reply wire)))
      (check (equal (substring reply 0 4) "HNBR") "reply magic")
      (check (= (host-native-index--get reply 10 2) 0) "reply status")
      (check (equal (substring reply 12 28) (substring wire 12 28)) "opaque echoes")
      (check (= (host-native-index--get reply 32 4) 2) "skipped records")
      (check (= (host-native-index--get reply 40 4) 6) "second BOM preserved")
      (dolist (seq '(0 1))
        (let ((bad (host-native-index--reply (frame '("a /b/") seq (if (= seq 0) 0 1)))))
          (check (= (host-native-index--get bad 10 2) 1) "first flag iff seq zero")
          (check (= (length bad) 40) "status without records")))
      (let ((bad (host-native-index--reply (frame '("a /b/") 0 3))))
        (check (= (host-native-index--get bad 10 2) 1) "unknown flags"))
      (dolist (offset '(0 4 8 10 32 36 40))
        (let ((bad (copy-sequence wire)))
          (aset bad offset (logxor (aref bad offset) 128))
          (reject bad "corrupt field")))
      (reject (substring wire 0 39) "short header")
      (reject (substring wire 0 (1- (length wire))) "truncated payload")
      (reject (frame '("a\n /b/")) "line contains LF")
      (reject (frame (list (make-string 65537 ?x))) "overlong")
      (check (= (host-native-index--get (host-native-index--reply
                                        (frame (list (concat "a /" (make-string 65533 ?x)))))
                                       10 2) 0) "exact line cap")
      (reject (frame (list (make-string 65536 ?x) (make-string 65536 ?x)
                           (make-string 65536 ?x) (make-string 65536 ?x))) "payload cap")
      (let ((bad (concat wire "x")))
        (setq bad (concat (substring bad 0 4) (host-native-index--put (- (length bad) 8) 4)
                          (substring bad 8 36) (host-native-index--put (- (length bad) 40) 4)
                          (substring bad 40)))
        (reject bad "extra payload byte")))
    ;; Fragmentation, resets, reply-before-reclaim, and truncated EOF use the
    ;; real serve loop with IO mocks. Invalid harness env must stay inert.
    (let* ((a (frame '("a /one/"))) (b (frame '("b /two/") 1 0))
           (c (frame '("c /three/") 0 1 (make-string 8 1)))
           (chunks (list (substring a 0 3) (substring a 3 39) (substring a 39) b c))
           (events nil) (resets 0) (notes 0)
           (process-environment (copy-sequence process-environment)))
      (setenv "DDSKK_HARNESS_DIAGNOSTICS" "1")
      (setenv "NATIVEIME_REGISTRY_KEY" "Software\\NativeIME")
      (setenv "DDSKK_HOST_BUILDER_TEST_FAULT" "midstream")
      (cl-letf (((symbol-function 'read-stdin-bytes) (lambda (_) (pop chunks)))
                ((symbol-function 'nelisp--write-stdout-bytes) (lambda (value) (push value events)))
                ((symbol-function 'host-native-index-reset-reclaim) (lambda () (setq resets (1+ resets))))
                ((symbol-function 'host-native-index-note-batch)
                 (lambda (bytes)
                   (check (and (stringp (car events)) (> bytes 0)) "reply before note")
                   (setq notes (1+ notes)))))
        (host-native-index-serve)
        (check (= resets 2) "reset once per generation")
        (check (= notes 3) "note every batch")
        (check (equal (car (last events)) "HNB READY version=1\n") "READY")
        (setq chunks (list (substring a 0 39)))
        (check (condition-case nil (progn (host-native-index-serve) nil) (error t)) "truncated EOF")
        (setenv "NATIVEIME_REGISTRY_KEY" "Software\\NativeIME-test-unit")
        (setenv "DDSKK_HARNESS_DIAGNOSTICS" "0")
        (setq chunks (list a))
        (host-native-index-serve)
        (check (= notes 4) "diagnostics off fault inert")
        (setenv "DDSKK_HARNESS_DIAGNOSTICS" "1")
        (setq chunks (list a b))
        (let ((before (length events)))
          (check (condition-case nil (progn (host-native-index-serve) nil) (error t)) "guarded midstream")
          (check (= (length events) (+ 2 before)) "midstream abort after first reply")
          (check (= notes 5) "failed second batch not accounted"))
        (setenv "DDSKK_HOST_BUILDER_TEST_FAULT" "timeout")
        (setq chunks (list a))
        (let ((times '(0 21)))
          (cl-letf (((symbol-function 'float-time) (lambda (&rest _) (pop times))))
            (host-native-index-serve)))
        (check (= notes 6) "guarded stall branch")))
    (princ (format "PASS HN builder dispatch checks=%s\n" checks))))
