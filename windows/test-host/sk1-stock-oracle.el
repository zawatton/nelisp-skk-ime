;;; SK1 stock oracle -*- lexical-binding: t; -*-
;; Actual fixture network, private files and learning.
(require 'cl-lib)
(require 'skk)
(require 'skk-server)
(let* ((dir (getenv "LOCAL_ORACLE_DIR"))
       (skk-jisyo (expand-file-name "sk1-user.utf8" dir))
       (skk-large-jisyo (cons (expand-file-name "sk1-files.utf8" dir) 'utf-8))
       (skk-jisyo-code 'utf-8)
       (skk-server-host "127.0.0.1")
       (skk-server-portnum (string-to-number (getenv "SK1_FIXTURE_PORT")))
       (skk-server-inhibit-startup-server t)
       (skk-share-private-jisyo nil)
       (skk-jisyo-save-count nil)
       (skk-search-prog-list '((skk-search-jisyo-file skk-jisyo 0 t)
                               (skk-search-jisyo-file skk-large-jisyo 0 t)
                               (skk-search-server nil 0 t)))
       (output ""))
  (make-directory dir t)
  (let ((coding-system-for-write 'utf-8-unix))
    (with-temp-file skk-jisyo
      (insert ";; okuri-ari entries.\n;; okuri-nasi entries.\nかな /user/\n"))
    (with-temp-file (car skk-large-jisyo)
      (insert ";; okuri-ari entries.\n;; okuri-nasi entries.\nかな /仮名/哉/\n")))
  (cl-labels ((hex (word) (mapconcat (lambda (c) (format "%06x" c)) word ""))
              (collect (reading)
                (let ((skk-henkan-key reading) (skk-okuri-char nil)
                      (skk-henkan-okurigana nil)
                      (skk-current-search-prog-list (copy-tree skk-search-prog-list)) words)
                  (while skk-current-search-prog-list
                    (setq words (skk-nunion words (skk-search))))
                  (unless words (error "Missing fixture candidates: %s" reading))
                  (setq output (concat output (hex reading) " "
                                       (hex (concat "/" (mapconcat #'identity words "/") "/")) "\n"))
                  (princ (format "STOCK %s %S\n" reading words)))))
    (with-temp-buffer
      (collect "かな") (collect "なぞ")
      (let ((skk-henkan-key "かな") (skk-henkan-okurigana nil)
            (skk-okuri-char nil) (skk-okuri-index-min -1))
        (skk-update-jisyo-original "serverExtra" nil))
      (collect "かな") (collect "なぞ")
      (let ((coding-system-for-write 'utf-8-unix))
        (with-current-buffer (skk-get-jisyo-buffer skk-jisyo)
          (write-region (point-min) (point-max) (expand-file-name "sk1-learned.utf8" dir) nil 'silent)))))
  (let ((coding-system-for-write 'utf-8-unix))
    (with-temp-file (expand-file-name "sk1-stock.oracle" dir) (insert output)))
  (when (process-live-p skkserv-process) (delete-process skkserv-process))
  (princ "PASS SK1 stock oracle rows=4 readings=2 learning=1\n"))
