;;; local-navigation-stock-oracle.el --- Stock previous/menu oracle -*- lexical-binding: t; -*-
;; GPL-3.0-or-later. Only synthetic buffers and caller-provided output directory.
(require 'skk)
(skk-setup-keymap)
(skk-setup-j-mode-map-options)
(remove-hook 'kill-emacs-hook #'skk-save-jisyo)
(remove-hook 'kill-emacs-hook #'skk-record-jisyo-data)
(let* ((directory (getenv "LOCAL_ORACLE_DIR"))
       (words '("仮名" "佳奈" "加奈" "可奈" "哉" "金" "香奈" "花菜" "奏" "叶" "華奈" "河南"))
       (skk-show-annotation nil) (skk-use-face nil)
       (skk-verbose nil) (skk-verbose-message nil) rows)
  (make-directory directory t)
  ;; Invoke stock's actual previous command, including the transition to ▽.
  (dotimes (count (length words))
    (with-temp-buffer
      (insert "▼")
      (let* ((skk-henkan-mode 'active) (skk-henkan-key "かな")
             (skk-henkan-count count) (skk-henkan-list words)
             (skk-okuri-char nil) (skk-abbrev-mode nil) (skk-katakana nil)
             (skk-henkan-start-point (copy-marker 2))
             (skk-henkan-end-point (copy-marker 2 t)))
        (insert (nth count words))
        (set-marker skk-henkan-end-point (point))
        (skk-previous-candidate)
        (push (format "previous %d %d %s" count skk-henkan-count
                      (mapconcat (lambda (c) (format "%06x" c)) (buffer-string) "")) rows))))
  ;; Drive the stock candidate menu itself: next page, previous page, select.
  (dolist (events '((32 120 97) (32 16 97) (120) (16)))
    (with-temp-buffer
      (let* ((skk-henkan-list words) (skk-henkan-count 4)
             (skk-current-search-prog-list nil) (skk-henkan-key "かな")
             (skk-henkan-start-point (copy-marker 1))
             (skk-henkan-end-point (copy-marker 1))
             (skk-henkan-mode 'active) (skk-exit-show-candidates nil)
             (queue (copy-sequence events)) pages)
        (cl-letf (((symbol-function 'read-event) (lambda (&rest _) (or (pop queue) (error "Oracle event underflow"))))
                  ((symbol-function 'skk-henkan-show-candidate-subr)
                   (lambda (_keys candidates) (push (- (length words) (length candidates)) pages)
                     (min 7 (length candidates)))))
          (catch 'unread (skk-henkan-show-candidates)))
        (push (format "menu %s %s %d" (mapconcat #'number-to-string events ",")
                      (mapconcat #'number-to-string (nreverse pages) ",") skk-henkan-count) rows))))
  (let ((coding-system-for-write 'utf-8-unix))
    (with-temp-file (expand-file-name "navigation.oracle" directory)
      (insert (mapconcat #'identity (nreverse rows) "\n") "\n")))
  (princ "PASS stock navigation oracle previous=12 menus=4 rows=16\n"))
