;;; host-policy-test.el --- S3 independent policy branches -*- lexical-binding: t; -*-
(require 'ert)
(setenv "DDSKK_HOST_POLICY_UNIT_ONLY" "1")
(load "engine/host-policy.el")
(ert-deftest host-policy-config ()
  (should (= (host-policy-decision 1 0 0 0) 0))
  (should (= (host-policy-decision 1 1 0 0) 0))
  (should (= (host-policy-decision 1 1 1 0) 1)))
(ert-deftest host-policy-source-order ()
  (should (= (host-policy-decision 2 0 1 0) 0))
  (should (= (host-policy-decision 2 1 1 0) 1))
  (should (= (host-policy-decision 2 1 0 0) 2)))
(ert-deftest host-policy-backoff ()
  (should (= (host-policy-decision 3 1000 0 0) 2000))
  (should (= (host-policy-decision 3 16000 0 0) 30000))
  (should (= (host-policy-decision 3 30000 1 0) 1000)))
(ert-deftest host-policy-cache-expiry ()
  (should (= (host-policy-decision 4 1 59999 0) 0))
  (should (= (host-policy-decision 4 1 60000 0) 1))
  (should (= (host-policy-decision 4 0 1999 0) 0))
  (should (= (host-policy-decision 4 0 2000 0) 1)))
(ert-deftest host-policy-publication ()
  (should (= (host-policy-decision 5 1 1 1) 1))
  (should (= (host-policy-decision 5 0 1 1) 0))
  (should (= (host-policy-decision 5 1 0 1) 0))
  (should (= (host-policy-decision 5 1 1 0) 0)))
(ert-deftest host-policy-invalid-kind ()
  (should (= (host-policy-decision 0 1 1 1) -1)))

(ert-deftest host-policy-learning-schedule ()
  (should (= (host-policy-decision 6 1 1 0) 1))
  (should (= (host-policy-decision 6 0 1 0) 0)))
(ert-deftest host-policy-replacement ()
  (should (= (host-policy-decision 7 1 1 0) 0))
  (should (= (host-policy-decision 7 1 1 1) 1))
  (should (= (host-policy-decision 7 0 0 1) 0)))
(ert-deftest host-policy-capacity ()
  (should (= (host-policy-decision 8 255 0 0) 1))
  (should (= (host-policy-decision 8 256 0 0) 0))
  (should (= (host-policy-decision 8 256 1 0) 1)))
(ert-deftest host-policy-intent ()
  (should (= (host-policy-decision 9 1 1 0) 0))
  (should (= (host-policy-decision 9 1 1 1) 1))
  (should (= (host-policy-decision 9 1 1 2) 1))
  (should (= (host-policy-decision 9 1 0 2) 0)))
(ert-deftest host-policy-order ()
  (should (= (host-policy-decision 10 1 1 0) 1))
  (should (= (host-policy-decision 10 0 1 0) 2))
  (should (= (host-policy-decision 10 1 0 0) 0)))

(ert-deftest host-policy-publication-payload ()
  (should (= (host-policy-decision 11 1 1 0) 2))
  (should (= (host-policy-decision 11 1 0 1) 1))
  (should (= (host-policy-decision 11 1 0 0) 0))
  (should (= (host-policy-decision 11 0 1 1) 0)))

(ert-deftest host-policy-cache-duration ()
  (should (= (host-policy-decision 12 1 0 0) 60000))
  (should (= (host-policy-decision 12 0 0 0) 2000)))
