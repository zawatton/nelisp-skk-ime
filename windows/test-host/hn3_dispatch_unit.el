;;; -*- lexical-binding: t; -*-
;; Batch-only data tests: no child, host, registry or dictionary access.
(setenv "DDSKK_HOST_POLICY_UNIT_ONLY" "1")
(load "engine/host-policy.el" nil t t)
(load "engine/host-native-skk.el" nil t t)
(load "engine/host-native-startup.el" nil t t)
(defvar hn3-test-checks 0)
(defun hn3-test-check (value)
  (setq hn3-test-checks (1+ hn3-test-checks))
  (unless value (error "HN3 check %d" hn3-test-checks)))
(defun hn3-test-frame (op fields)
  (let ((body "") (bytes 0))
    (dolist (field fields)
      (let ((raw (encode-coding-string field 'utf-8)))
        (setq body (concat body (host-policy-hn3-put (length raw) 4) raw)
              bytes (+ bytes (length raw)))))
    (concat "HN3Q" (host-policy-hn3-put (+ 44 (length body)) 4)
            (host-policy-hn3-put op 2) (host-policy-hn3-put 0 2)
            (apply #'unibyte-string (make-list 32 255)) (host-policy-hn3-put (length fields) 4)
            (host-policy-hn3-put bytes 4) body)))
(defun hn3-test-fields (reply)
  (let ((at 52) (n (host-policy-hn3-get reply 44 4)) (fields nil))
    (while (> n 0)
      (let ((size (host-policy-hn3-get reply at 4)))
        (setq at (+ at 4))
        (push (decode-coding-string (substring reply at (+ at size)) 'utf-8) fields)
        (setq at (+ at size) n (1- n))))
    (hn3-test-check (= at (length reply))) (nreverse fields)))
(dolist (case '((1 ("/仮名;one/[し/skip/]/" "/仮名;two/次/") ("/仮名;one/次/"))
                (2 ("/word/" "/word;note/next/") ("1/word/word;note/next/"))
                (3 ("1/a//tail") ("LIST (\"a\" )"))
                (4 ("a\"\\\n") ("\"a\\\"\\\\\\012\""))
                (5 ("0" "" "1" "0" "0" "0" "" "0" "0" "0")
                   ("ddskk" "load" "ddskk" "0" "1" "set" "NELISP_IME_ENGINE" "ddskk"))))
  (let* ((frame (hn3-test-frame (car case) (cadr case))) (reply (host-policy-hn3-reply frame)))
    (hn3-test-check (equal (substring reply 0 4) "HN3R"))
    (hn3-test-check (equal (substring frame 12 44) (substring reply 12 44)))
    (hn3-test-check (= (host-policy-hn3-get reply 10 2) 0))
    (hn3-test-check (equal (hn3-test-fields reply) (nth 2 case)))))
(dolist (bytes '((192 175) (227 129) (237 160 128) (244 144 128 128) (128)))
  (hn3-test-check (not (host-policy-hn3-utf8 (apply #'unibyte-string bytes)))))
(hn3-test-check (host-policy-hn3-utf8 (encode-coding-string "仮名" 'utf-8)))
(let* ((raw (hn3-test-frame 2 '("a"))) (reply (host-policy-hn3-reply raw)))
  (hn3-test-check (= (host-policy-hn3-get reply 10 2) 1)))
;; Mock stdio to exercise one-byte fragmentation, HP2/HN3 interleaving and READY.
(let* ((hp2 "HP2Q           ! !!   \n")
       (hn3 (hn3-test-frame 3 '("4")))
       (input (concat hp2 hn3 hp2)) (at 0) (output nil))
  (cl-letf (((symbol-function 'read-stdin-bytes)
             (lambda (_limit) (when (< at (length input))
                               (prog1 (substring input at (1+ at)) (setq at (1+ at))))))
            ((symbol-function 'nelisp--write-stdout-bytes)
             (lambda (bytes) (push bytes output))))
    (host-policy-serve))
  (setq output (nreverse output))
  (hn3-test-check (equal (car output) "HP2 READY HN3=1\n"))
  (hn3-test-check (= (length output) 4))
  (hn3-test-check (equal (nth 1 output) (host-policy-hp2-reply hp2 nil)))
  (hn3-test-check (equal (hn3-test-fields (nth 2 output)) '("LIST nil")))
  (hn3-test-check (equal (nth 3 output) (nth 1 output))))
(princ (format "PASS HN3 dispatch checks=%d stacks=0\n" hn3-test-checks))
