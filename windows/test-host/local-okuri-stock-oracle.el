;;; local-okuri-stock-oracle.el --- Stock candidate/learning oracle -*- lexical-binding: t; -*-
;; GPL-3.0-or-later. All fixtures and output use the caller's private directory.
(let ((home (expand-file-name "home" (getenv "LOCAL_ORACLE_DIR"))))
  (make-directory home t)
  (setenv "HOME" home)
  (setq user-emacs-directory (expand-file-name ".emacs.d/" home)))
(require 'skk)
(remove-hook 'kill-emacs-hook #'skk-save-jisyo)
(remove-hook 'kill-emacs-hook #'skk-record-jisyo-data)
(let* ((directory (getenv "LOCAL_ORACLE_DIR"))
       (personal (expand-file-name "lf3-stock-user.jisyo" directory))
       (shared (expand-file-name "lf3-stock-shared.jisyo" directory))
       (skk-jisyo personal) (skk-jisyo-code 'utf-8)
       (skk-jisyo-save-count nil) (skk-backup-jisyo nil)
       (skk-share-private-jisyo nil) (skk-num-convert-code nil)
       (skk-numeric-conversion nil) (skk-process-okuri-early nil)
       (skk-henkan-okuri-strictly nil) (skk-henkan-strict-okuri-precedence nil)
       (skk-large-jisyo (cons shared 'utf-8))
       (skk-search-prog-list '((skk-search-jisyo-file skk-jisyo 0 t)
                               (skk-search-jisyo-file skk-large-jisyo 0 t)))
       (skk-update-jisyo-function 'skk-update-jisyo-original)
       (corpus '(("ていこうち" . nil) ("おーむ" . nil) ("あたい" . nil) ("かんじ" . nil)
                 ("かk" . "く") ("かt" . "った") ("かu" . "う")
                 ("きえr" . "る") ("しn" . "んだ")))
       output confirmations)
  (make-directory directory t)
  (let ((coding-system-for-write 'utf-8-unix))
    (with-temp-file personal (insert ";; okuri-ari entries.\n;; okuri-nasi entries.\n"))
    ;; This is the configured server tier's canonical, first-source merge.
    ;; The unsorted/two-file importer is independently tested by the TSF stress
    ;; fixture against full L; stock below controls union, notes and learning.
    (with-temp-file shared
      (insert ";; okuri-ari entries.\nしn /死/[んだ/死/]/\nきえr /消え/[る/消え/]/\n"
              "かu /買/[う/買/]/\nかt /買/飼/[った/買/飼/]/\nかk /書/掛/[く/書/掛/]/\n"
              ";; okuri-nasi entries.\nあたい /値/価;price/\nおーむ /Ω/オーム/王蟲/\n"
              "かんじ /漢字/\nていこうち /抵抗値/\n")))
  (cl-labels ((hex (text) (mapconcat (lambda (c) (format "%06x" c)) text "")))
    (with-temp-buffer
      (dotimes (phase 2)
        (dolist (entry corpus)
          (let* ((skk-henkan-key (car entry)) (skk-henkan-okurigana (cdr entry))
                 (skk-okuri-char (and (cdr entry) (substring (car entry) -1)))
                 (skk-current-search-prog-list (copy-tree skk-search-prog-list)) words)
            (while skk-current-search-prog-list
              (setq words (skk-nunion words (skk-search))))
            (unless words (error "Stock lookup miss: %S" entry))
            (let* ((word (car (last words)))
                   (commit (concat (car (skk-treat-strip-note-from-word word)) (or (cdr entry) ""))))
              (push (format "%d %s %s %s %s" phase (hex (car entry))
                            (if (cdr entry) (hex (cdr entry)) "-")
                            (hex (concat "/" (mapconcat #'identity words "/") "/"))
                            (hex commit)) output)
              (when (= phase 0) (push (list (car entry) (cdr entry) word) confirmations)))))
        (when (= phase 0)
          (dolist (confirmation (nreverse confirmations))
            (let ((skk-henkan-key (nth 0 confirmation))
                  (skk-henkan-okurigana (nth 1 confirmation))
                  (skk-okuri-char (and (nth 1 confirmation) (substring (nth 0 confirmation) -1)))
                  (skk-okuri-index-min -1))
              (skk-update-jisyo-original (nth 2 confirmation) nil)))
          (let ((contents (with-current-buffer (skk-get-jisyo-buffer skk-jisyo) (buffer-string)))
                (coding-system-for-write 'utf-8-unix))
            (with-temp-file personal (insert contents)))))))
  (let ((coding-system-for-write 'utf-8-unix))
    (with-temp-file (expand-file-name "lf3-stock.oracle" directory)
      (insert (mapconcat #'identity (nreverse output) "\n") "\n")))
  (princ "PASS stock DDSKK LF3 oracle rows=18 readings=9 before/after ordinary+okuri learning\n"))
