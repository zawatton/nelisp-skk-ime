;;; core-e2e-client.el --- key/compartment client for the native core (S3h)  -*- lexical-binding: t; -*-

;;; Commentary:

;; Builds core-e2e.exe, an STA host on wine's real msctf that loads the native
;; shim (DDSKK_HARNESS_DLL_PATH, DllGetClassObject) and activates it through a
;; DirectThreadMgr proxy (as shim-activate-client.el does).  The shim loads the
;; sibling ddskk-ime-core.dll, built by ddskk-core.el with the CoreProbe* test
;; exports; the client resolves the probes from DDSKK_CORE_PATH (same file, so
;; the same module instance).
;;
;; Scenarios (printed line by line, compared with golden/core-e2e*.golden):
;;   open/close  compartment SetValue through the real wine thread manager +
;;               explicit ITfCompartmentEventSink::OnChange on the TIP
;;   keys        OnTestKeyDown/OnTestKeyUp/OnKeyDown/OnKeyUp/OnPreservedKey
;;               through the TIP's ITfKeyEventSink under modifier states set
;;               with SetKeyboardState
;;   translate   TranslateKey under a fixed US layout (LoadKeyboardLayoutW)
;;   engine id   NI_ENGINE_ID via CoreProbeEngineId (registry + watcher)
;; DDSKK_CE_MODE=short (env value 1 of DDSKK_CE_SHORT) runs only the state and
;; the A/1 claims (used with the registry Engine=passthrough pre-set).

;;; Code:

(require 'cl-lib)
(require 'tsf-test-common)
(require 'ddskk-shim)

(defconst core-e2e-imports
  (append tsf-host-imports
          '(("user32.dll" "LoadKeyboardLayoutW" "ActivateKeyboardLayout" "GetKeyState"))))

(defun ce/cp (i) `(call-ptr (ptr-read-u64 (data-addr ce_fn) 0) ,i))
(defun ce/cps (i v) `(call-ptr (ptr-read-u64 (data-addr ce_fn) 0) ,(+ (* 4096 (1+ i)) v)))

(defun core-e2e-forms ()
  (let ((g #'tsf/g) (gs #'tsf/gs))
    (append
     (list (nelisp-com-wstr-blob 'w_envcore "DDSKK_CORE_PATH")
           (nelisp-com-wstr-blob 'w_envshort "DDSKK_CE_SHORT")
           (nelisp-com-wstr-blob 'w_layout "00000409")
           (nelisp-com-ascii-blob 'a_ce_names "CoreProbe")
           (nelisp-com-ascii-blob 'a_ce_set "CoreProbeSet")
           (nelisp-com-ascii-blob 'a_ce_tr "CoreProbeTranslate")
           (nelisp-com-ascii-blob 'a_ce_eid "CoreProbeEngineId")
           (nelisp-com-ascii-blob 'a_ce_lbl "CoreProbeLabel")
           (nelisp-com-ascii-blob 'a_ce_ro "CoreProbeReadOpen")
           (nelisp-com-ascii-blob 'a_ce_passthrough "passthrough")
           (nelisp-com-ascii-blob 'a_ce_lattice "lattice")
           (nelisp-com-ascii-blob 'a_ce_ddskk "ddskk")
           (nelisp-com-zero-blob 'ce_fn 64)
           (nelisp-com-zero-blob 'ce_var 32) (nelisp-com-zero-blob 'ce_kb 256) (nelisp-com-zero-blob 'ce_tmp 64)
           `(data-blob px_obj ,(make-list 16 0) data ((0 px_vt 0)))
           `(data-blob km_obj ,(make-list 8 0) data ((0 km_vt 0)))
           `(data-blob kmst ,(make-list 64 0) data)
           (nelisp-com-vtable 'px_vt '(px_qi px_addref px_release))
           (nelisp-com-vtable 'km_vt '(km_qi km_addref km_release km_advise km_unadvise)))
     (nelisp-com-msctf-blobs '(IID_ITfThreadMgr CLSID_TF_ThreadMgr IID_ITfCompartmentMgr
                               IID_ITfCompartmentEventSink GUID_COMPARTMENT_KEYBOARD_OPENCLOSE))
     `((defun px_qi (this riid ppv)
         (if (= ppv 0) ,nelisp-com-e-pointer
           (if ,(nelisp-com-guid= 'riid 'IID_ITfKeystrokeMgr)
               (seq (ptr-write-u64 ppv 0 (data-addr km_obj)) 0)
             (let ((real (ptr-read-u64 this 8)))
               ,(nelisp-com-call 'real 0 'riid 'ppv)))))
       (defun px_addref (this) 2)
       (defun px_release (this) 1)
       (defun km_qi (this riid ppv) (seq (ptr-write-u64 ppv 0 0) ,nelisp-com-e-nointerface))
       (defun km_addref (this) 2)
       (defun km_release (this) 1)
       (defun km_advise (this tid sink fg)
         (seq (atomic-fetch-add (data-addr kmst) 1) ,(nelisp-com-call 'sink 1) 0))
       (defun km_unadvise (this tid) (seq (atomic-fetch-add (+ (data-addr kmst) 8) 1) 0))
       ;; ---- helpers ----
       (defun gp (m name idx)
         (let ((p (extern-call GetProcAddress m name))) (seq (ptr-write-u64 (data-addr ce_fn) idx p) 0)))
       (defun resolve ()
         (if (> (extern-call GetEnvironmentVariableW (data-addr w_envcore) (data-addr pathbuf) 520) 0)
             (let ((m (extern-call LoadLibraryW (data-addr pathbuf))))
               (seq (gp m (data-addr a_ce_names) 0)
                    (gp m (data-addr a_ce_set) 8)
                    (gp m (data-addr a_ce_tr) 16)
                    (gp m (data-addr a_ce_eid) 24)
                    (gp m (data-addr a_ce_lbl) 32)
                    (gp m (data-addr a_ce_ro) 40)
                    0))
           0))
       ;; modifier state through SetKeyboardState (GetKeyState reads it back)
       (defun mods (ctrl shift)
         (let ((kb (data-addr ce_kb)))
           (seq (extern-call GetKeyboardState kb)
                (ptr-write-u8 kb 17 (* 128 ctrl)) (ptr-write-u8 kb 16 (* 128 shift))
                (extern-call SetKeyboardState kb)
                0)))
       (defun key (sink slot vk)
         (seq (ptr-write-u32 (data-addr tmpbuf) 32 3735928559)
              (let ((hr (call-ptr (ptr-read-u64 (ptr-read-u64 sink 0) (* 8 slot))
                                  sink 0 vk 1 (+ (data-addr tmpbuf) 32))))
                (if (/= hr 0)
                    (seq ,(tsf/p "  hr=") (ob_hexn hr 8) 0)
                  0))
              (ptr-read-u32 (data-addr tmpbuf) 32)))
       (defun tk (sink vk)
         (let ((e (key sink 4 vk)))
           (seq ,(tsf/p "TKD vk=") (ob_hexn vk 2) ,(tsf/p " eaten=") (ob_hexn e 8) (ob_nl) (ob_flush))))
       (defun tkm (sink vk ctrl shift)
         (seq (mods ctrl shift)
              ,(tsf/p "C") (ob_hex ctrl) ,(tsf/p "S") (ob_hex shift) ,(tsf/p " ")
              (tk sink vk)
              (mods 0 0)
              0))
       (defun st (name)
         (seq (ob_flush) ,(tsf/p "STATE ") (ob_s name)
              ,(tsf/p " open=") (ob_hex ,(ce/cp 0)) ,(tsf/p " kana=") (ob_hex ,(ce/cp 1))
              ,(tsf/p " closed_kana=") (ob_hex ,(ce/cp 2)) ,(tsf/p " ddskk=") (ob_hex ,(ce/cp 3))
              ,(tsf/p " kind=") (ob_hex ,(ce/cp 4)) ,(tsf/p " pending=") (ob_hex ,(ce/cp 7))
              ,(tsf/p " hira=") (ob_hex ,(ce/cp 10)) ,(tsf/p " cand=") (ob_hex ,(ce/cp 9))
              (ob_nl)))
       (defun lbl ()
         (seq ,(tsf/p "LABEL ") (ob_hexn (call-ptr (ptr-read-u64 (data-addr ce_fn) 32) 0) 4)
              (ob_ch 32) (ob_hexn (call-ptr (ptr-read-u64 (data-addr ce_fn) 32) 1) 4) (ob_nl) (ob_flush)))
       (defun comp_set (tm tid v)
         (seq
          (ptr-write-u64 (data-addr ce_tmp) 0 0)
          (ptr-write-u64 (data-addr ce_tmp) 8 0)
          (if ,(nelisp-com-succeeded
                (nelisp-com-call 'tm 0 '(data-addr IID_ITfCompartmentMgr) '(+ (data-addr ce_tmp) 0)))
              (let ((mgr (ptr-read-u64 (data-addr ce_tmp) 0)))
                (seq
                 (if ,(nelisp-com-succeeded
                       (nelisp-com-call 'mgr 3 '(data-addr GUID_COMPARTMENT_KEYBOARD_OPENCLOSE)
                                        '(+ (data-addr ce_tmp) 8)))
                     (let ((c (ptr-read-u64 (data-addr ce_tmp) 8)))
                       (seq (ptr-write-u64 (data-addr ce_var) 0 0) (ptr-write-u64 (data-addr ce_var) 8 0)
                            (ptr-write-u64 (data-addr ce_var) 16 0)
                            (ptr-write-u16 (data-addr ce_var) 0 3)
                            (ptr-write-u32 (data-addr ce_var) 8 v)
                            (let ((hr ,(nelisp-com-call 'c 3 'tid '(data-addr ce_var))))
                              (seq ,(tsf/p "SETVALUE ") (ob_hex v) ,(tsf/p " hr=") (ob_hexn hr 8) (ob_nl)))
                            ,(nelisp-com-call 'c 2)
                            0))
                   0)
                 ,(nelisp-com-call 'mgr 2)
                 0))
            0)
          0))
       ;; explicit OnChange on the TIP's compartment event sink
       (defun comp_notify (tip)
         (seq (ptr-write-u64 (data-addr ce_tmp) 16 0)
              (if ,(nelisp-com-succeeded
                    (nelisp-com-call 'tip 0 '(data-addr IID_ITfCompartmentEventSink)
                                     '(+ (data-addr ce_tmp) 16)))
                  (let ((s (ptr-read-u64 (data-addr ce_tmp) 16)))
                    (let ((hr ,(nelisp-com-call 's 3 '(data-addr GUID_COMPARTMENT_KEYBOARD_OPENCLOSE))))
                      (seq ,(tsf/p "ONCHANGE hr=") (ob_hexn hr 8) (ob_nl)
                           ,(nelisp-com-call 's 2) 0)))
                (seq ,(tsf/p "ONCHANGE no sink") (ob_nl) 0))
              0))
       (defun tr (vk ctrl shift)
         (seq (mods ctrl shift)
              ,(tsf/p "TR vk=") (ob_hexn vk 2) (ob_flush) ,(tsf/p " ctrl=") (ob_hex ctrl)
              ,(tsf/p " shift=") (ob_hex shift) ,(tsf/p " ch=")
              (ob_hexn (call-ptr (ptr-read-u64 (data-addr ce_fn) 16) vk) 8) (ob_nl)
              (mods 0 0) 0))
       ;; the claim table: letters, digits, OEM, idle navigation
       (defun table_idle (sink)
         (seq (tk sink 65) (tk sink 66) (tk sink 89) (tk sink 90) (tk sink 48) (tk sink 49) (tk sink 57)
              (tk sink 186) (tk sink 187) (tk sink 192) (tk sink 193) (tk sink 218) (tk sink 219)
              (tk sink 223) (tk sink 224) (tk sink 226)
              (tk sink 32) (tk sink 8) (tk sink 13) (tk sink 27) (tk sink 37) (tk sink 39)
              (tk sink 38) (tk sink 40) (tk sink 46) (tk sink 33) (tk sink 117) (tk sink 118)
              (tk sink 112) (tk sink 91) (tk sink 96) (tk sink 111) 0))
       (defun table_composing (sink)
         (seq (tk sink 65) (tk sink 32) (tk sink 8) (tk sink 13) (tk sink 27) (tk sink 37)
              (tk sink 39) (tk sink 38) (tk sink 117) (tk sink 118) (tk sink 119) (tk sink 121)
              (tk sink 122) (tk sink 46)
              (tkm sink 37 0 1) (tkm sink 39 0 1) 0))
       (defun table_ctrl (sink)
         (seq (tkm sink 71 1 0) (tkm sink 74 1 0) (tkm sink 67 1 0) (tkm sink 65 1 0)
              (tkm sink 71 0 0) (tkm sink 74 0 0) (tkm sink 74 1 1) (tkm sink 190 1 0) 0))
       (defun run_full (sink tip tm tid)
         (seq
          (st ,(tsf/s "initial")) (lbl)
          (seq ,(tsf/p "-- idle claim table (open, kana, ddskk)") (ob_nl) (table_idle sink))
          (seq ,(tsf/p "-- ctrl chords idle") (ob_nl) (table_ctrl sink))
          (seq ,(tsf/p "-- composing") (ob_nl) ,(ce/cps 1 1) (st ,(tsf/s "composing")) (table_composing sink)
               (table_ctrl sink) ,(ce/cps 1 0))
          (seq ,(tsf/p "-- wide latin idle space") (ob_nl) ,(ce/cps 4 1) (tk sink 32) (tk sink 8) ,(ce/cps 4 0))
          (seq ,(tsf/p "-- candidate mode (no realtime claim)") (ob_nl) ,(ce/cps 5 1) (st ,(tsf/s "candidate"))
               (tk sink 65) (tkm sink 74 1 0) (tk sink 49) ,(ce/cps 5 0))
          (seq ,(tsf/p "-- registration mode") (ob_nl) ,(ce/cps 2 1)
               (tk sink 65) (tk sink 32) (tk sink 8) (tk sink 46) (tk sink 38) (tk sink 117) (tk sink 119)
               (tk sink 33) (tkm sink 71 1 0) (tkm sink 67 1 0) (tkm sink 74 1 0) ,(ce/cps 2 0))
          (seq ,(tsf/p "-- kana off") (ob_nl) ,(ce/cps 0 0) (st ,(tsf/s "kana-off")) (lbl)
               (tk sink 65) (tkm sink 74 1 0) (tk sink 32) ,(ce/cps 0 1))
          (seq ,(tsf/p "-- lattice engine kind (composing arrows/F6-F10)") (ob_nl)
               ,(ce/cps 9 1) ,(ce/cps 1 1) (tk sink 37) (tk sink 117) (tk sink 121) (tkm sink 37 0 1)
               ,(ce/cps 1 0) ,(ce/cps 9 0))
          (seq ,(tsf/p "-- close via compartment") (ob_nl)
               (comp_set tm tid 0) (comp_notify tip) (st ,(tsf/s "closed")) (lbl)
               (tk sink 65) (tkm sink 74 1 0) (tk sink 49)
               (comp_set tm tid 1) (comp_notify tip) (st ,(tsf/s "reopened")) (lbl) (tk sink 65))
          (seq ,(tsf/p "-- close with kana off, reopen restores kana") (ob_nl)
               ,(ce/cps 0 0) (comp_set tm tid 0) (comp_notify tip) (st ,(tsf/s "closed-kana-off"))
               (comp_set tm tid 1) (comp_notify tip) (st ,(tsf/s "reopened-kana-off")) (tk sink 65) ,(ce/cps 0 1))
          (seq ,(tsf/p "-- close while composing resets pending") (ob_nl)
               ,(ce/cps 1 1) (comp_set tm tid 0) (comp_notify tip) (st ,(tsf/s "closed-composing"))
               (comp_set tm tid 1) (comp_notify tip) (st ,(tsf/s "reopened")))
          (seq ,(tsf/p "-- ReadKeyboardOpen fallback") (ob_nl)
               ,(tsf/p "RO ") (ob_hex (call-ptr (ptr-read-u64 (data-addr ce_fn) 40) 0))
               (ob_ch 32) (ob_hex (call-ptr (ptr-read-u64 (data-addr ce_fn) 40) 1)) (ob_nl))
          (seq ,(tsf/p "-- TranslateKey (US layout)") (ob_nl)
               (tr 65 0 0) (tr 65 0 1) (tr 49 0 0) (tr 49 0 1) (tr 186 0 0) (tr 186 0 1)
               (tr 187 0 0) (tr 187 0 1) (tr 32 0 0) (tr 117 0 0) (tr 65 1 0) (tr 48 0 1))
          (seq ,(tsf/p "-- key up / down / preserved") (ob_nl)
               (mods 1 0)
               (tk sink 74)
               ,(tsf/p "CTRLSNAP after TKD ") (ob_hex ,(ce/cp 11)) (ob_nl)
               (key sink 5 74) ,(tsf/p "TKU eaten=") (ob_hexn (ptr-read-u32 (data-addr tmpbuf) 32) 8) (ob_nl)
               ,(tsf/p "CTRLSNAP after TKU ") (ob_hex ,(ce/cp 11)) (ob_nl)
               (tk sink 74)
               (key sink 7 74) ,(tsf/p "KU eaten=") (ob_hexn (ptr-read-u32 (data-addr tmpbuf) 32) 8) (ob_nl)
               ,(tsf/p "CTRLSNAP after KU ") (ob_hex ,(ce/cp 11)) (ob_nl)
               (mods 0 0)
               (key sink 6 65) ,(tsf/p "KD ctx=0 eaten=") (ob_hexn (ptr-read-u32 (data-addr tmpbuf) 32) 8) (ob_nl)
               (ptr-write-u32 (data-addr tmpbuf) 32 3735928559)
               (let ((hr ,(nelisp-com-call 'sink 8 0 '(data-addr g_clsid_tip) '(+ (data-addr tmpbuf) 32))))
                 (seq ,(tsf/p "PRESERVED hr=") (ob_hexn hr 8) ,(tsf/p " eaten=")
                      (ob_hexn (ptr-read-u32 (data-addr tmpbuf) 32) 8) (ob_nl))))
          (seq ,(tsf/p "-- engine id through NI_ENGINE_ID") (ob_nl)
               (call-ptr (ptr-read-u64 (data-addr ce_fn) 24) (data-addr a_ce_lattice)) (st ,(tsf/s "lattice"))
               ,(ce/cps 1 1) (tk sink 37) (tk sink 121) ,(ce/cps 1 0)
               (call-ptr (ptr-read-u64 (data-addr ce_fn) 24) (data-addr a_ce_passthrough)) (st ,(tsf/s "passthrough"))
               (tk sink 65) (tkm sink 74 1 0)
               (call-ptr (ptr-read-u64 (data-addr ce_fn) 24) (data-addr a_ce_ddskk)) (st ,(tsf/s "ddskk"))
               (tk sink 65))
          0))
       (defun run_short (sink)
         (seq (st ,(tsf/s "initial")) (tk sink 65) (tk sink 49) (tkm sink 74 1 0)  0))
       (defun fail (n hr)
         (seq ,(tsf/p "FAIL step=") (ob_hex n) ,(tsf/p " hr=") (ob_hexn hr 8) (ob_nl)
              (ob_flush) (extern-call ExitProcess n)))
       (defun stc (n hr) (if (/= (logand hr 2147483648) 0) (fail n hr) 0))
       (defun _start ()
         (seq
          (if (/= (buf_init) 0) (extern-call ExitProcess 2) 0)
          (stc 1 (extern-call CoInitializeEx 0 2))
          (stc 2 (extern-call CoCreateInstance (data-addr CLSID_TF_ThreadMgr) 0 1
                              (data-addr IID_ITfThreadMgr) ,(tsf/ga 'tmp)))
          (let ((tm ,(funcall g 'tmp)))
            (seq ,(funcall gs 'tm 'tm)
                 (stc 3 ,(nelisp-com-call 'tm 3 (tsf/ga 'tid)))
                 (ptr-write-u64 (data-addr px_obj) 8 tm)
                 (let ((h (extern-call LoadKeyboardLayoutW (data-addr w_layout) 1)))
                   (seq (extern-call ActivateKeyboardLayout h 0) 0))
                 (let ((tip (load_tip)))
                   (if (= tip 0) (seq ,(tsf/p "FAIL no TIP loaded") (ob_nl) (ob_flush) (extern-call ExitProcess 3))
                     (seq (resolve) 
                          (let ((hr ,(nelisp-com-call 'tip 3 '(data-addr px_obj) (tsf/g 'tid))))
                            (seq ,(tsf/p "HR Activate=") (ob_hexn hr 8) (ob_nl) (ob_flush)
                                 (if ,(nelisp-com-failed 'hr) 0
                                   (let ((hr3 ,(nelisp-com-call 'tip 0 '(data-addr IID_ITfKeyEventSink)
                                                                '(+ (data-addr tmpbuf) 16))))
                                     (if ,(nelisp-com-failed 'hr3) ,(tsf/p "FAIL no ITfKeyEventSink")
                                       (let ((sink (ptr-read-u64 (data-addr tmpbuf) 16)))
                                         (seq (if (= (env_is_one (data-addr w_envshort)) 1)
                                                  (run_short sink)
                                                (run_full sink tip tm ,(tsf/g 'tid)))
                                              ,(nelisp-com-call 'sink 2)
                                              0)))))
                                 (let ((hrd ,(nelisp-com-call 'tip 4)))
                                   (seq ,(tsf/p "HR Deactivate=") (ob_hexn hrd 8) (ob_nl)))
                                 ,(nelisp-com-call 'tip 2)
                                 (ob_flush)
                                 (extern-call ExitProcess 0))))))))))))))

(defun core-e2e-client-build (path)
  "Build the client PATH."
  (let ((tsf--lits nil))
    (let ((forms (append (tsf/core-forms) (core-e2e-forms))))
      (setq max-lisp-eval-depth (max max-lisp-eval-depth 100000))
      (nelisp-com-build-exe path (append (tsf/lit-blobs) forms) core-e2e-imports))))

(provide 'core-e2e-client)
;;; core-e2e-client.el ends here
