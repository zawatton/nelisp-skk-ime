(defun scl/lock-main ()
  `(seq
    (let ((n (extern-call GetEnvironmentVariableW (data-addr w_envdll) (data-addr pathbuf) 520)))
      (let ((m (extern-call LoadLibraryW (data-addr pathbuf))))
        (let ((lk (extern-call GetProcAddress m (data-addr a_lock))))
          (seq (if (= lk 0) (extern-call ExitProcess 90) 0)
               (ptr-write-u64 (data-addr lkg) 0 lk)
               (ptr-write-u64 (data-addr lkg) 8 0)
               (let ((h1 (extern-call CreateThread 0 0 (addr-of lk_thread) 3000 0 0))
                     (h2 (extern-call CreateThread 0 0 (addr-of lk_thread) 3000 0 0)))
                 (seq (ptr-write-u64 (data-addr lkg) 16 h1) (ptr-write-u64 (data-addr lkg) 24 h2)
                      (extern-call WaitForMultipleObjects 2 (+ (data-addr lkg) 16) 1 60000)))
               ,(scl/line "LOCK counter=" (scl/h '(ptr-read-u64 (data-addr lkg) 8)) (scl/p " expected=") (scl/h 6000))
               0))))))

(defun scl/forms ()
  (let ((fnames (length scl-exports)))
    (append
     (list `(data-blob fnt ,(make-list (* 8 fnames) 0) data)
           `(data-blob obuf ,(make-list 65536 0) data)
           `(data-blob olen ,(make-list 8 0) data)
           `(data-blob hexb ,(make-list 32 0) data)
           `(data-blob cg ,(make-list 64 0) data)
           `(data-blob ck ,(make-list 16 0) data)
           `(data-blob lkg ,(make-list 64 0) data)
           `(data-blob pathbuf ,(make-list 1040 0) data)
           `(data-blob binblob ,(make-list 16 17) data)
           `(data-blob valbuf ,(make-list 600 0) data)
           (nelisp-com-wstr-blob 'w_envdll "DDSKK_HARNESS_DLL_PATH")
           (nelisp-com-wstr-blob 'w_envprobe "SETTINGS_PROBE_DLL")
           (nelisp-com-wstr-blob 'w_envmode "SETTINGS_MODE")
           (nelisp-com-wstr-blob 'w_envkey "NATIVEIME_REGISTRY_KEY")
           (nelisp-com-wstr-blob 'cpath "\\Clients\\")
           (nelisp-com-wstr-blob 'nm_open "open") (nelisp-com-wstr-blob 'nm_comp "composing")
           (nelisp-com-wstr-blob 'nm_seq "sequence") (nelisp-com-wstr-blob 'nm_rev "revision")
           (nelisp-com-wstr-blob 'nm_mode "mode")
           (nelisp-com-ascii-blob 'a_lock "DdskkShimPubLock")
           (nelisp-com-ascii-blob 'lit_thr " thread/stop="))
     (cl-loop for n in scl-exports for i from 0
              collect (nelisp-com-ascii-blob (intern (format "an_%d" i)) n))
     (nelisp-com-wstr-lib-forms)
     `((defun ob_ch (c)
         (let ((n (ptr-read-u64 (data-addr olen) 0)))
           (if (< n 65000)
               (seq (ptr-write-u8 (data-addr obuf) n c) (ptr-write-u64 (data-addr olen) 0 (+ n 1)) 0)
             0)))
       (defun ob_s (p) (let ((i 0)) (while (/= (ptr-read-u8 p i) 0) (seq (ob_ch (ptr-read-u8 p i)) (setq i (+ i 1))))))
       (defun ob_nl () (seq (ob_ch 10) (ob_flush)))
       (defun ob_nibble (d) (ob_ch (if (< d 10) (+ 48 d) (+ 87 d))))
       (defun ob_hexn (v n)
         (let ((i 0) (x v))
           (seq (while (< i n)
                  (seq (ptr-write-u8 (data-addr hexb) i (logand x 15)) (setq x (/ x 16)) (setq i (+ i 1))))
                (while (> i 0) (seq (setq i (- i 1)) (ob_nibble (ptr-read-u8 (data-addr hexb) i))))
                0)))
       (defun ob_hex (v)
         (if (< v 0) (seq (ob_ch 45) (ob_hex (- 0 v)))
           (let ((n 1) (x (/ v 16)))
             (seq (while (> x 0) (seq (setq n (+ n 1)) (setq x (/ x 16)))) (ob_hexn v n)))))
       (defun ob_hex16 (v)
         (let ((lo (logand v 4294967295)))
           (let ((hi (logand (/ (- v lo) 4294967296) 4294967295)))
             (seq (ob_hexn hi 8) (ob_hexn lo 8)))))
       (defun ob_w (p) (let ((i 0)) (while (/= (ptr-read-u16 p (* 2 i)) 0)
                                      (seq (ob_ch (logand (ptr-read-u16 p (* 2 i)) 255)) (setq i (+ i 1))))))
       (defun ob_flush ()
         (seq (extern-call WriteFile (extern-call GetStdHandle (- 0 11)) (data-addr obuf)
                           (ptr-read-u64 (data-addr olen) 0) (data-addr cg) 0)
              (ptr-write-u64 (data-addr olen) 0 0) 0))
       (defun handles ()
         (seq (ptr-write-u64 (data-addr cg) 8 0)
              (extern-call GetProcessHandleCount (- 0 1) (+ (data-addr cg) 8))
              (ptr-read-u32 (data-addr cg) 8)))
       ;; ---- registry helpers (relative to NATIVEIME_REGISTRY_KEY) ----
       (defun rg_path (rel)
         (let ((w (wbuf_new 1024)))
           (seq (ptr-write-u64 (+ w 8) 0
                               (logand (extern-call GetEnvironmentVariableW (data-addr w_envkey) (wbuf_ptr w) 1024)
                                       4294967295))
                (wbuf_append_w w rel) w)))
       (defun rg_open (rel)
         (let ((p (rg_path rel)))
           (seq (extern-call RegCreateKeyExW ,nelisp-com-hkey-current-user (wbuf_ptr p) 0 0 0 131078 0
                             (+ (data-addr cg) 16) 0)
                (wbuf_free p)
                (ptr-read-u64 (data-addr cg) 16))))
       (defun rg_reset ()
         (let ((p (rg_path (data-addr w_empty0))))
           (seq (extern-call RegDeleteTreeW ,nelisp-com-hkey-current-user (wbuf_ptr p)) (wbuf_free p) 0)))
       (defun rg_dw (hk name v)
         (seq (ptr-write-u32 (data-addr cg) 32 v)
              (extern-call RegSetValueExW hk name 0 4 (+ (data-addr cg) 32) 4)))
       (defun rg_sz (hk name str)
         (extern-call RegSetValueExW hk name 0 1 str (* 2 (+ 1 (wbuf_wcslen str)))))
       (defun rg_bin (hk name p n) (extern-call RegSetValueExW hk name 0 3 p n))
       ;; Clients\<pid> relative to the settings key; the pid is appended here.
       (defun rg_clients (rel)
         (let ((p (rg_path rel)))
           (seq (wbuf_append_u64 p (logand (extern-call GetCurrentProcessId) 4294967295)) p)))
       (defun rg_getdw (rel name)
         (let ((p (rg_clients rel)) (r 1099511627776))
           (seq (if (= (extern-call RegOpenKeyExW ,nelisp-com-hkey-current-user (wbuf_ptr p) 0 1 (+ (data-addr cg) 16)) 0)
                    (let ((hk (ptr-read-u64 (data-addr cg) 16)))
                      (seq (ptr-write-u32 (data-addr cg) 40 0) (ptr-write-u32 (data-addr cg) 44 4)
                           (if (= (extern-call RegQueryValueExW hk name 0 (+ (data-addr cg) 48) (+ (data-addr cg) 40)
                                               (+ (data-addr cg) 44))
                                  0)
                               (setq r (ptr-read-u32 (data-addr cg) 40)) 0)
                           (extern-call RegCloseKey hk)))
                  0)
                (wbuf_free p) r)))
       (defun rg_has (rel)
         (let ((p (rg_clients rel)) (r 0))
           (seq (if (= (extern-call RegOpenKeyExW ,nelisp-com-hkey-current-user (wbuf_ptr p) 0 1 (+ (data-addr cg) 16)) 0)
                    (seq (setq r 1) (extern-call RegCloseKey (ptr-read-u64 (data-addr cg) 16))) 0)
                (wbuf_free p) r)))
       (defun rg_print_sz (rel name)
         (let ((p (rg_clients rel)))
           (seq (cs_zero_v)
                (if (= (extern-call RegOpenKeyExW ,nelisp-com-hkey-current-user (wbuf_ptr p) 0 1 (+ (data-addr cg) 16)) 0)
                    (let ((hk (ptr-read-u64 (data-addr cg) 16)))
                      (seq (ptr-write-u32 (data-addr cg) 44 512)
                           (extern-call RegQueryValueExW hk name 0 (+ (data-addr cg) 48) (data-addr valbuf) (+ (data-addr cg) 44))
                           (extern-call RegCloseKey hk)))
                  0)
                ,(scl/p "PUB reg mode=") (ob_w (data-addr valbuf)) (ob_nl)
                (wbuf_free p) 0)))
       (defun cs_zero_v () (let ((i 0)) (while (< i 600) (seq (ptr-write-u8 (data-addr valbuf) i 0) (setq i (+ i 1))))))
       (defun wait_ready (w)
         (let ((i 0)) (while (and (< i 100) (/= ,(scl/f 'ProbeWkGet 'w 2) 1))
                        (seq (extern-call Sleep 50) (setq i (+ i 1))))))
       (defun wait_dirty (w its)
         (let ((i 0)) (while (and (< i its) (/= ,(scl/f 'ProbeWkGet 'w 0) 1))
                        (seq (extern-call Sleep 50) (setq i (+ i 1))))))
       (defun dump (s)
         (seq ,(scl/p "engine=") (ob_w ,(scl/f 'ProbeEngine 's))
              ,(scl/p " ddskk=") (ob_hex ,(scl/f 'ProbeGet 's 1))
              ,(scl/p " kana=") (ob_hex ,(scl/f 'ProbeGet 's 0))
              ,(scl/p " debug=") (ob_hex ,(scl/f 'ProbeGet 's 2))
              ,(scl/p " ms=") (ob_hex ,(scl/f 'ProbeGet 's 3))
              ,(scl/p " ind=") (ob_hex ,(scl/f 'ProbeGet 's 4))
              ,(scl/p " scale=") (ob_hex ,(scl/f 'ProbeGet 's 5))
              ,(scl/p " col=") (ob_hexn ,(scl/f 'ProbeGet 's 12) 6) (ob_ch 44)
              (ob_hexn ,(scl/f 'ProbeGet 's 13) 6) (ob_ch 44) (ob_hexn ,(scl/f 'ProbeGet 's 14) 6) (ob_ch 44)
              (ob_hexn ,(scl/f 'ProbeGet 's 15) 6) (ob_ch 44) (ob_hexn ,(scl/f 'ProbeGet 's 16) 6)
              ,(scl/p " open_mode=") (ob_w ,(scl/f 'ProbeOpenMode 's))
              ,(scl/p " app=") (ob_w ,(scl/f 'ProbeAppName 's))
              ,(scl/p " pub=") (ob_hex ,(scl/f 'ProbeGet 's 6))
              ,(scl/p " reg=") (ob_hex ,(scl/f 'ProbeGet 's 7))
              ,(scl/p " act=") (ob_hex ,(scl/f 'ProbeGet 's 8))
              (ob_nl)))
       (defun lk_thread (n)
         (let ((i 0) (lk (ptr-read-u64 (data-addr lkg) 0)))
           (seq (while (< i n)
                  (seq (call-ptr lk 1)
                       (let ((v (ptr-read-u64 (data-addr lkg) 8)))
                         (seq (extern-call Sleep 0) (ptr-write-u64 (data-addr lkg) 8 (+ v 1))))
                       (call-ptr lk 0)
                       (setq i (+ i 1))))
                0)))
       (defun _start ()
         (seq
          (let ((n (extern-call GetEnvironmentVariableW (data-addr w_envprobe) (data-addr pathbuf) 520)))
            (let ((m (extern-call LoadLibraryW (data-addr pathbuf))))
              (seq
               ,@(cl-loop for i from 0 below (1- fnames)
                          collect `(let ((p (extern-call GetProcAddress m (data-addr ,(intern (format "an_%d" i))))))
                                      (if (= p 0) (extern-call ExitProcess ,(+ 91 i))
                                        (ptr-write-u64 (data-addr fnt) ,(* 8 i) p))))
               (let ((mode (extern-call GetEnvironmentVariableW (data-addr w_envmode) (data-addr valbuf) 16)))
                 (let ((c (ptr-read-u16 (data-addr valbuf) 0)))
                   (if (= m 0) (seq ,(scl/p "FAIL LoadLibraryW probe") (ob_nl) 0)
                     (if (= c 115) ,(scl/settings-main)
                     (if (= c 102) ,(scl/fp-main)
                     (if (= c 119) ,(scl/wk-main)
                     (if (= c 112) ,(scl/pub-main)
                     (if (= c 99) ,(scl/conc-main)
                     (if (= c 118) ,(scl/wk0-main)
                     (if (= c 108) ,(scl/lock-main)
                       0)))))))))))))
          (ob_flush)
          (extern-call ExitProcess 0)))))))

(defun settings-client-build (path)
  "Build settings-client.exe at PATH."
  (let ((scl--wlits nil) (tsf--lits nil))
    (let* ((forms (scl/forms))
           (all (append (tsf/lit-blobs) (scl/wblobs)
                        (list (nelisp-com-wstr-blob 'w_empty0 ""))
                        forms)))
      (setq max-lisp-eval-depth (max max-lisp-eval-depth 100000))
      (nelisp-com-build-exe path all
                            (cons (cons "kernel32.dll"
                                        (delete-dups (append (cdr (assoc "kernel32.dll" scl-imports))
                                                             '("GetCurrentProcessId"))))
                                  (cdr scl-imports))))))

