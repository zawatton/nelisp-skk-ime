;;; settings-client.el --- test EXE for the S3e settings probe DLL  -*- lexical-binding: t; -*-

;;; Commentary:

;; Builds settings-client.exe.  It writes registry values with RegSetValueExW
;; into the private key named by NATIVEIME_REGISTRY_KEY, calls the exports of
;; settings-probe.dll (SETTINGS_PROBE_DLL) and prints facts for the e2e script.
;; Mode (env SETTINGS_MODE, first letter): s settings scenarios, f fingerprint,
;; w watcher, p publication, c concurrent queue, l shim publication lock
;; (DDSKK_HARNESS_DLL_PATH = shim built with NELISP_SHIM_TEST_EXPORTS=1).

;;; Code:

(require 'cl-lib)
(require 'tsf-test-common)
(require 'settings-probe)

(defconst scl-exports (append settings-probe-exports '("DdskkShimPubLock")))
(defconst scl-imports
  '(("kernel32.dll" "ExitProcess" "GetProcessHeap" "HeapAlloc" "HeapFree" "HeapReAlloc"
     "WriteFile" "GetStdHandle" "LoadLibraryW" "GetProcAddress" "GetEnvironmentVariableW"
     "Sleep" "CreateThread" "WaitForMultipleObjects" "CloseHandle" "GetProcessHandleCount"
     "GetLastError")
    ("advapi32.dll" "RegCreateKeyExW" "RegSetValueExW" "RegDeleteTreeW" "RegCloseKey"
     "RegOpenKeyExW" "RegQueryValueExW")))

(defvar scl--wlits nil)
(defun scl/w (str)
  "Form giving the address of the wide literal STR."
  (let ((e (assoc str scl--wlits)))
    (unless e
      (setq e (cons str (intern (format "sw_%d" (length scl--wlits)))))
      (push e scl--wlits))
    `(data-addr ,(cdr e))))
(defun scl/wblobs ()
  (mapcar (lambda (e) (nelisp-com-wstr-blob (cdr e) (car e))) (reverse scl--wlits)))
(defun scl/f (name &rest args)
  "Call the probe export NAME."
  (let ((i (cl-position (symbol-name name) scl-exports :test #'equal)))
    `(call-ptr (ptr-read-u64 (data-addr fnt) ,(* 8 i)) ,@args)))
(defun scl/p (str) (tsf/p str))
(defun scl/h (v) `(ob_hex ,v))
(defun scl/k (rel &rest forms)
  `(let ((hk (rg_open ,(scl/w rel)))) (seq ,@forms (extern-call RegCloseKey hk) 0)))
(defun scl/dw (name v) `(rg_dw hk ,(scl/w name) ,v))
(defun scl/sz (name str) `(rg_sz hk ,(scl/w name) ,(scl/w str)))
(defun scl/bin (name n) `(rg_bin hk ,(scl/w name) (data-addr binblob) ,n))
(defun scl/line (label &rest forms) `(seq ,(scl/p label) ,@forms (ob_nl)))
(defun scl/kv (label v) `(seq ,(scl/p label) ,(scl/h v)))

(defun scl/scenario (label activated writes)
  `(seq (rg_reset)
        ,@writes
        ,(scl/p label)
        (let ((s ,(scl/f 'ProbeNew)))
          (seq ,(scl/f 'ProbeSetActivated 's activated)
               ,(scl/f 'ProbeLoad 's)
               (dump s)
               ,(scl/f 'ProbeRemove 's)
               ,(scl/f 'ProbeFree 's)
               0))))

