(defun scl/wait-dirty (w) `(wait_dirty ,w 100))
(defun scl/wk-main ()
  `(seq
    (rg_reset) ,(scl/k "" (scl/sz "Engine" "ddskk"))
    (let ((w1 ,(scl/f 'ProbeWkNew 1)) (w2 ,(scl/f 'ProbeWkNew 0)))
      (seq
       ,(scl/line "WK start=" (scl/h (scl/f 'ProbeWkStart 'w1)) '(ob_ch 44) (scl/h (scl/f 'ProbeWkStart 'w2)))
       (wait_ready w1) (wait_ready w2)
       ,(scl/line "WK ready=" (scl/h (scl/f 'ProbeWkGet 'w1 2)) '(ob_ch 44) (scl/h (scl/f 'ProbeWkGet 'w2 2)))
       ,(scl/line "WK initial_take=" (scl/h (scl/f 'ProbeWkTake 'w1)) '(ob_ch 44) (scl/h (scl/f 'ProbeWkTake 'w2)))
       ,(scl/line "WK after_take=" (scl/h (scl/f 'ProbeWkGet 'w1 0)) '(ob_ch 44) (scl/h (scl/f 'ProbeWkGet 'w2 0)))
       (let ((b1 ,(scl/f 'ProbeWkGet 'w1 1)) (b2 ,(scl/f 'ProbeWkGet 'w2 1)))
         (seq
          ,(scl/k "\\Clients\\x" (scl/dw "v" 1))
          (extern-call Sleep 1500)
          ,(scl/line "WK clients_dirty=" (scl/h (scl/f 'ProbeWkGet 'w1 0)) '(ob_ch 44) (scl/h (scl/f 'ProbeWkGet 'w2 0)))
          ,(scl/line "WK clients_woke=" (scl/h `(if (> ,(scl/f 'ProbeWkGet 'w1 1) b1) 1 0)) '(ob_ch 44)
                     (scl/h `(if (> ,(scl/f 'ProbeWkGet 'w2 1) b2) 1 0)))))
       (let ((b2 ,(scl/f 'ProbeWkGet 'w2 1)))
         (seq
          ,(scl/k "" (scl/sz "CoreDll" "C:\\core.dll"))
          (wait_dirty w1 100)
          (extern-call Sleep 1000)
          ,(scl/line "WK coredll_dirty=" (scl/h (scl/f 'ProbeWkGet 'w1 0)) '(ob_ch 44) (scl/h (scl/f 'ProbeWkGet 'w2 0)))
          ,(scl/line "WK coredll_w2_woke=" (scl/h `(if (> ,(scl/f 'ProbeWkGet 'w2 1) b2) 1 0)))))
       ,(scl/f 'ProbeWkTake 'w1)
       ,(scl/k "" (scl/sz "Engine" "passthrough"))
       (wait_dirty w1 100) (wait_dirty w2 100)
       ,(scl/line "WK engine_dirty=" (scl/h (scl/f 'ProbeWkGet 'w1 0)) '(ob_ch 44) (scl/h (scl/f 'ProbeWkGet 'w2 0)))
       ,(scl/line "WK fp_changed=" (scl/h `(if (/= ,(scl/f 'ProbeWkGet 'w1 6) ,(scl/f 'ProbeWkGet 'w2 6)) 1 0)))
       (let ((r1 ,(scl/f 'ProbeWkStop 'w1 10000)) (r2 ,(scl/f 'ProbeWkStop 'w2 10000)))
         ,(scl/line "WK stop=" (scl/h 'r1) '(ob_ch 44) (scl/h 'r2)))
       ,(scl/line "WK exited=" (scl/h (scl/f 'ProbeWkGet 'w1 3)) '(ob_ch 44) (scl/h (scl/f 'ProbeWkGet 'w2 3))
                  '(ob_s (data-addr lit_thr)) (scl/h (scl/f 'ProbeWkGet 'w1 4)) '(ob_ch 44) (scl/h (scl/f 'ProbeWkGet 'w1 5)))
       ,(scl/f 'ProbeWkFree 'w1) ,(scl/f 'ProbeWkFree 'w2)
       ;; Start/Stop cycles must not leak handles.
       (let ((before (handles)) (i 0) (bad 0))
         (seq (while (< i 20)
                (let ((w ,(scl/f 'ProbeWkNew 1)))
                  (seq ,(scl/f 'ProbeWkStart 'w)
                       (wait_ready w)
                       (if (/= ,(scl/f 'ProbeWkStop 'w 10000) 0) (setq bad (+ bad 1)) 0)
                       (if (/= ,(scl/f 'ProbeWkGet 'w 3) 1) (setq bad (+ bad 1)) 0)
                       ,(scl/f 'ProbeWkFree 'w)
                       (setq i (+ i 1)))))
              ,(scl/line "WK cycles bad=" (scl/h 'bad) (scl/p " handle_delta=") (scl/h '(- (handles) before)))))))))

(defun scl/pub-main ()
  `(seq
    (rg_reset)
    ,(scl/k "\\Apps\\settings-client.exe" (scl/dw "PublishState" 1))
    (let ((s ,(scl/f 'ProbeNew)) (s2 ,(scl/f 'ProbeNew)))
      (seq
       ,(scl/f 'ProbeSetActivated 's 1) ,(scl/f 'ProbeSetActivated 's2 1)
       ,(scl/f 'ProbeLoad 's) ,(scl/f 'ProbeLoad 's2)
       ,(scl/line "PUB registered=" (scl/h (scl/f 'ProbeGet 's 7)) '(ob_ch 44) (scl/h (scl/f 'ProbeGet 's2 7))
                  (scl/p " publishers=") (scl/h (scl/f 'ProbeGet 's 18)))
       ,(scl/f 'ProbeSetOpen 's 1)
       ,(scl/line "PUB q1=" (scl/h (scl/f 'ProbeQueue 's 0)))
       ,(scl/f 'ProbeSetMode 's (scl/w "katakana"))
       ,(scl/line "PUB q2=" (scl/h (scl/f 'ProbeQueue 's 1)))
       ,(scl/line "PUB q2dup=" (scl/h (scl/f 'ProbeQueue 's 99)))
       ,(scl/f 'ProbeSetOpen 's 0)
       ,(scl/line "PUB q3=" (scl/h (scl/f 'ProbeQueue 's 2)))
       ,(scl/line "PUB ring_count=" (scl/h (scl/f 'ProbeGet 's 11)))
       ,(scl/f 'ProbeFlush 's)
       ,(scl/line "PUB trace=" (scl/h (scl/f 'ProbeTrace 's 0)) '(ob_ch 44) (scl/h (scl/f 'ProbeTrace 's 1))
                  '(ob_ch 44) (scl/h (scl/f 'ProbeTrace 's 2)) (scl/p " n=") (scl/h (scl/f 'ProbeGet 's 10))
                  (scl/p " flushed=") (scl/h (scl/f 'ProbeGet 's 19)) (scl/p " ring=") (scl/h (scl/f 'ProbeGet 's 11)))
       ,(scl/line "PUB reg open=" (scl/h '(rg_getdw (data-addr cpath) (data-addr nm_open)))
                  (scl/p " composing=") (scl/h '(rg_getdw (data-addr cpath) (data-addr nm_comp)))
                  (scl/p " sequence=") (scl/h '(rg_getdw (data-addr cpath) (data-addr nm_seq)))
                  (scl/p " revision=") (scl/h '(rg_getdw (data-addr cpath) (data-addr nm_rev))))
       (rg_print_sz (data-addr cpath) (data-addr nm_mode))
       ;; Skip-already-flushed: queue 2 transitions, pretend the first was flushed.
       ,(scl/f 'ProbeSetOpen 's 1)
       ,(scl/f 'ProbeSetMode 's (scl/w "latin"))
       (let ((a ,(scl/f 'ProbeQueue 's 0)))
         (let ((b ,(scl/f 'ProbeQueue 's 1)))
           (seq ,(scl/f 'ProbeSetFlushed 's 'a)
                ,(scl/f 'ProbeFlush 's)
                ,(scl/line "PUB skip seqs=" (scl/h 'a) '(ob_ch 44) (scl/h 'b)
                           (scl/p " trace4=") (scl/h (scl/f 'ProbeTrace 's 3))
                           (scl/p " n=") (scl/h (scl/f 'ProbeGet 's 10))
                           (scl/p " reg_sequence=") (scl/h '(rg_getdw (data-addr cpath) (data-addr nm_seq)))))))
       ;; Two publishers: the first Remove keeps the key, the last deletes it.
       ,(scl/f 'ProbeRemove 's)
       ,(scl/line "PUB remove1 key=" (scl/h '(rg_has (data-addr cpath))) (scl/p " publishers=")
                  (scl/h (scl/f 'ProbeGet 's 18)) (scl/p " registered=") (scl/h (scl/f 'ProbeGet 's 7)))
       ,(scl/f 'ProbeRemove 's2)
       ,(scl/line "PUB remove2 key=" (scl/h '(rg_has (data-addr cpath))) (scl/p " publishers=")
                  (scl/h (scl/f 'ProbeGet 's2 18)))
       ;; Queue after Remove is a no-op; turning PublishState off via LoadSettings removes the key.
       ,(scl/line "PUB q_after_remove=" (scl/h (scl/f 'ProbeQueue 's 0)))
       ,(scl/f 'ProbeLoad 's)
       ,(scl/f 'ProbeSetOpen 's 1)
       ,(scl/f 'ProbeQueue 's 2) ,(scl/f 'ProbeFlush 's)
       ,(scl/line "PUB reregistered=" (scl/h (scl/f 'ProbeGet 's 7)) (scl/p " key=") (scl/h '(rg_has (data-addr cpath))))
       ,(scl/k "\\Apps\\settings-client.exe" (scl/dw "PublishState" 0))
       ,(scl/f 'ProbeLoad 's)
       ,(scl/line "PUB disabled registered=" (scl/h (scl/f 'ProbeGet 's 7)) (scl/p " key=")
                  (scl/h '(rg_has (data-addr cpath))) (scl/p " publish=") (scl/h (scl/f 'ProbeGet 's 6)))
       ,(scl/f 'ProbeFree 's) ,(scl/f 'ProbeFree 's2)
       0))))

(defun scl/conc-main ()
  `(seq
    (rg_reset)
    ,(scl/k "\\Apps\\settings-client.exe" (scl/dw "PublishState" 1))
    (let ((s ,(scl/f 'ProbeNew)))
      (seq
       ,(scl/f 'ProbeSetActivated 's 1) ,(scl/f 'ProbeLoad 's)
       ,(scl/f 'ProbeYield 1)
       (if (= (ptr-read-u16 (data-addr valbuf) 2) 113)
           ,(scl/f 'ProbeSeq 's 300)
         ,(scl/line "CONC wait=" (scl/h (scl/f 'ProbeConcurrent 's 300))))
       (let ((n ,(scl/f 'ProbeGet 's 11)) (i 0) (dense 1) (order 1) (first 0))
         (seq
          (ptr-write-u64 (data-addr ck) 0 0) (ptr-write-u64 (data-addr ck) 8 0)
          (if (> n 0) (setq first ,(scl/f 'ProbeRing 's 0 0)) 0)
          (while (< i n)
            (let ((sq ,(scl/f 'ProbeRing 's 'i 0)) (tt ,(scl/f 'ProbeRing 's 'i 1))
                  (c ,(scl/f 'ProbeRing 's 'i 2)))
              (seq (if (/= sq (+ first i)) (setq dense 0) 0)
                   (if (or (< tt 1) (> tt 2)) (setq order 0)
                     (seq (if (<= c (ptr-read-u64 (data-addr ck) (* 8 (- tt 1)))) (setq order 0) 0)
                          (ptr-write-u64 (data-addr ck) (* 8 (- tt 1)) c)))
                   (setq i (+ i 1)))))
          ,(scl/line "CONC count=" (scl/h 'n) (scl/p " dense=") (scl/h 'dense) (scl/p " order=") (scl/h 'order))
          ,(scl/line "CONC first=" (scl/h (scl/f 'ProbeRing 's 0 1)) '(ob_ch 47) (scl/h (scl/f 'ProbeRing 's 0 2))
                     '(ob_ch 32) (scl/h (scl/f 'ProbeRing 's 1 1)) '(ob_ch 47) (scl/h (scl/f 'ProbeRing 's 1 2))
                     '(ob_ch 32) (scl/h (scl/f 'ProbeRing 's 299 1)) '(ob_ch 47) (scl/h (scl/f 'ProbeRing 's 299 2))
                     '(ob_ch 32) (scl/h (scl/f 'ProbeRing 's 300 1)) '(ob_ch 47) (scl/h (scl/f 'ProbeRing 's 300 2))
                     '(ob_ch 32) (scl/h (scl/f 'ProbeRing 's 257 1)) '(ob_ch 47) (scl/h (scl/f 'ProbeRing 's 257 2))
                     '(ob_ch 32) (scl/h (scl/f 'ProbeRing 's 2 1)) '(ob_ch 47) (scl/h (scl/f 'ProbeRing 's 2 2)))
          ,(scl/f 'ProbeFlush 's)
          ,(scl/line "CONC flushed=" (scl/h (scl/f 'ProbeGet 's 19)) (scl/p " ring=") (scl/h (scl/f 'ProbeGet 's 11))
                     (scl/p " reg_sequence=") (scl/h '(rg_getdw (data-addr cpath) (data-addr nm_seq))))))
       ,(scl/f 'ProbeRemove 's) ,(scl/f 'ProbeFree 's)
       0))))

