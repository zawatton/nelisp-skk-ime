;;; engine-client-hosts.el --- test EXEs for the engine client (S3f)  -*- lexical-binding: t; -*-

;;; Commentary:

;; Builds, with nelisp, two Windows EXEs for engine-client-e2e.sh:
;;
;;  ec-client.exe  links ddskk-engine-client.el.  env EC_SCENARIO selects
;;                 b(asic) a(bsent) s(ilent/corrupt recovery) h(ost spawn);
;;                 EC_MUTANT=1 skips the RESET after a failed transaction,
;;                 EC_MUTANT=2 disables the spawn throttle.
;;  ec-stub.exe    named-pipe engine host (message mode, re-listens after a
;;                 client disconnects).  Replies by request prefix after the
;;                 "SESSION <id> " prefix, from the S4.1 goldens
;;                 (TLV_GOLDEN_DIR) when TLV was negotiated, else as text.
;;                 env: DDSKK_PIPE_NAME, ECS_LOG (request log, appended),
;;                 TLV_STUB_NOTLV=1, ECS_SILENT_AT=n (no reply to the n-th non-HELLO
;;                 request, sleep ECS_SLEEP_MS), ECS_CORRUPT_AT=n (corrupt the
;;                 length of the first record of the n-th reply),
;;                 ECS_DELAY_MS (sleep before creating the pipe).

;;; Code:

(require 'cl-lib)
(let ((root (or (getenv "NELISP_ROOT") (error "set NELISP_ROOT to a NeLisp checkout"))))
  (add-to-list 'load-path (expand-file-name "lisp" root)))
(require 'nelisp-com-dsl)
(require 'nelisp-com-wstr-lib)
(add-to-list 'load-path (expand-file-name ".." (file-name-directory (or load-file-name buffer-file-name))))
(require 'ddskk-engine-client)
(require 'tlv-hosts)

(defun ecp (str) (th/p str))

(defun ech/blobs ()
  (append
   (list (nelisp-com-zero-blob 'stst 80) (nelisp-com-zero-blob 'wbuf3 1040)
         (nelisp-com-zero-blob 'cst 16) (nelisp-com-zero-blob 'kbuf 32)
         (nelisp-com-wstr-blob 'w_scen "EC_SCENARIO") (nelisp-com-wstr-blob 'w_mutant "EC_MUTANT")
         (nelisp-com-wstr-blob 'w_silent "ECS_SILENT_AT") (nelisp-com-wstr-blob 'w_sleepms "ECS_SLEEP_MS")
         (nelisp-com-wstr-blob 'w_corrupt "ECS_CORRUPT_AT") (nelisp-com-wstr-blob 'w_delay "ECS_DELAY_MS")
         (nelisp-com-wstr-blob 'w_log "ECS_LOG"))))

;;;; client

(defun ech/client-forms ()
  `((defun show (ec es)
      (seq (if (= es 0)
               (seq ,(ecp "NULL status=") (o_dec (ec_status ec))
                    ,(ecp " derr=") (o_dec (ec_derr ec))
                    ,(ecp " resync=") (o_dec (ec_needs_resync ec)))
             (seq (dump_msg (ec_state_data es) (ec_state_tlv es)) (ec_state_free es)))
           (o_nl) 0))
    (defun show_enc (ec n)
      (seq (o_dec n) (o_ch 32)
           (if (= n 0) ,(ecp "(none)")
             (let ((i 0)) (while (< i (- n 1)) (seq (o_ch (ptr-read-u8 (ec_line_ptr ec) i)) (setq i (+ i 1))))))
           (o_nl) 0))
    (defun tick () (extern-call GetTickCount64))
    (defun sc_basic (ec)
      (let ((t0 (tick)))
        (let ((ok (ec_connect ec 350)))
          (seq ,(ecp "CONNECT ok=") (o_dec ok) ,(ecp " tlv=") (o_dec (ec_is_tlv ec)) (o_nl)
               (ptr-write-u32 (data-addr kbuf) 0 97) (ptr-write-u32 (data-addr kbuf) 4 98)
               (ptr-write-u32 (data-addr kbuf) 8 128512) (ptr-write-u32 (data-addr kbuf) 12 55296)
               ,(ecp "ENC KEY 97: ") (show_enc ec (ec_enc_key ec 97))
               ,(ecp "ENC KEY 1114112: ") (show_enc ec (ec_enc_key ec 1114112))
               ,(ecp "ENC CONVERT-KEYS: ") (show_enc ec (ec_enc_convert_keys ec (data-addr kbuf) 3))
               ,(ecp "ENC FEED-KEYS 2: ") (show_enc ec (ec_enc_feed_keys ec (data-addr kbuf) 2))
               ,(ecp "ENC FEED-KEYS surrogate: ") (show_enc ec (ec_enc_feed_keys ec (data-addr kbuf) 4))
               ,(ecp "ENC FEED-KEYS empty: ") (show_enc ec (ec_enc_feed_keys ec (data-addr kbuf) 0))
               ,@(cl-loop for i in '(0 1 9 14 19 20) collect
                          `(seq ,(ecp (format "ENC CONTROL %d: " i)) (show_enc ec (ec_enc_control ec ,i))))
               ,(ecp "KEY 97: ") (show ec (ec_send_key ec 97 350))
               ,(ecp "CONTROL CONVERT: ") (show ec (ec_send_control ec 1 1500))
               ,(ecp "RESET: ") (show ec (ec_reset ec 350))
               ,(ecp "SELECT ddskk: ") (o_dec (ec_select_engine ec ,(th/s "ddskk") 1000)) (o_nl)
               ,(ecp "SELECT bad id: ") (o_dec (ec_select_engine ec ,(th/s "dd skk") 1000)) (o_nl)
               ,(ecp "PING: ") (o_dec (ec_ping ec 1000)) (o_nl)
               ,(ecp "FEED-KEYS: ") (show ec (ec_send_keys ec (data-addr kbuf) 2 1500))
               (ec_txn ec (ec_enc_lit ec ,(th/s "SHUTDOWN")) 1000)
               0))))
    (defun sc_absent (ec)
      (let ((t0 (tick)))
        (let ((ok (ec_connect ec 350)))
          (seq ,(ecp "CONNECT ok=") (o_dec ok) ,(ecp " status=") (o_dec (ec_status ec))
               ,(ecp " ms=") (o_dec (- (tick) t0)) (o_nl)
               (let ((t1 (tick)))
                 (seq ,(ecp "KEY: ") (show ec (ec_send_key ec 97 350))
                      ,(ecp "KEY ms=") (o_dec (- (tick) t1)) (o_nl)))
               0))))
    ;; silent/corrupt stub: first KEY fails, the next transaction must RESET first
    (defun sc_silent (ec)
      (let ((t0 (tick)))
        (seq (ec_connect ec 350)
             (let ((t1 (tick)))
               (seq ,(ecp "KEY 97: ") (show ec (ec_send_key ec 97 350))
                    ,(ecp "KEY ms=") (o_dec (- (tick) t1)) (o_nl)))
             ,(ecp "RESYNC after: ") (o_dec (ec_needs_resync ec)) (o_nl)
             (extern-call Sleep 900)
             ,(ecp "CONTROL CONVERT: ") (show ec (ec_send_control ec 1 1500))
             ,(ecp "RESYNC end: ") (o_dec (ec_needs_resync ec)) (o_nl)
             (ec_txn ec (ec_enc_lit ec ,(th/s "SHUTDOWN")) 1000)
             0)))
    (defun sc_host (ec)
      (let ((i 0) (ok 0))
        (seq ,(ecp "ENSURE1: ") (o_dec (ec_ensure_host ec 2000)) (o_nl)
             ,(ecp "ENSURE2: ") (o_dec (ec_ensure_host ec (ptr-read-u64 (data-addr cst) 0))) (o_nl)
             (while (and (< i 40) (= ok 0))
               (seq (setq ok (ec_connect ec 250)) (if (= ok 0) (extern-call Sleep 100) 0) (setq i (+ i 1))))
             ,(ecp "CONNECTED: ") (o_dec ok) (o_nl)
             ,(ecp "KEY 97: ") (show ec (ec_send_key ec 97 350))
             (ec_txn ec (ec_enc_lit ec ,(th/s "SHUTDOWN")) 1000)
             0)))
    (defun _start ()
      (let ((ec (ec_new)))
        (seq (if (= ec 0) ,(ecp "FAIL ec_new")
               (seq (ptr-write-u64 (data-addr cst) 0 2000)
                    (if (> (env_w (data-addr w_mutant) (data-addr wbuf2) 8) 0)
                        (if (= (ptr-read-u16 (data-addr wbuf2) 0) 49) (ec_set_skip_reset ec 1)
                          (if (= (ptr-read-u16 (data-addr wbuf2) 0) 50) (ptr-write-u64 (data-addr cst) 0 0) 0))
                      0)
                    (env_w (data-addr w_scen) (data-addr wbuf1) 8)
                    (let ((c (ptr-read-u16 (data-addr wbuf1) 0)))
                      (if (= c 98) (sc_basic ec)
                        (if (= c 97) (sc_absent ec)
                          (if (= c 115) (sc_silent ec)
                            (if (= c 104) (sc_host ec) ,(ecp "FAIL scenario"))))))
                    (ec_free ec)))
             (o_nl) (o_flush) (extern-call ExitProcess 0)))))) 

;;;; stub host

(defun ech/stub-forms ()
  `((defun spfx (req off n lit len)
      (let ((i 0) (ok (if (>= (- n off) len) 1 0)))
        (seq (while (and (= ok 1) (< i len))
               (seq (if (/= (ptr-read-u8 req (+ off i)) (ptr-read-u8 lit i)) (setq ok 0) 0) (setq i (+ i 1))))
             ok)))
    (defun slen (p) (let ((n 0)) (seq (while (/= (ptr-read-u8 p n) 0) (setq n (+ n 1))) n)))
    (defun st_get (i) (ptr-read-u64 (data-addr stst) (* 8 i)))
    (defun st_set (i v) (seq (ptr-write-u64 (data-addr stst) (* 8 i) v) 0))
    (defun env_int (wname)
      (let ((n (env_w wname (data-addr wbuf3) 20)) (i 0) (v 0))
        (seq (while (< i n)
               (seq (setq v (+ (* v 10) (- (ptr-read-u16 (data-addr wbuf3) (* 2 i)) 48))) (setq i (+ i 1))))
             v)))
    (defun log_bytes (p n)
      (let ((h (st_get 5)))
        (if (= h 0) 0
          (seq (extern-call WriteFile h p n (+ (data-addr ostate) 24) 0)
               (extern-call WriteFile h ,(th/s "\n") 1 (+ (data-addr ostate) 24) 0)
               0))))
    (defun send (pipe p n) (extern-call WriteFile pipe p n (+ (data-addr ostate) 24) 0))
    (defun send_str (pipe p) (send pipe p (slen p)))
    ;; Build wide "<dir>\<name>.bin" in wbuf1.
    (defun golden_path (name nlen)
      (let ((n (env_w (data-addr w_gdir) (data-addr wbuf1) 520)) (i 0))
        (seq (ptr-write-u16 (data-addr wbuf1) (* 2 n) 92) (setq n (+ n 1))
             (while (< i nlen)
               (seq (ptr-write-u16 (data-addr wbuf1) (* 2 (+ n i)) (ptr-read-u8 name i)) (setq i (+ i 1))))
             (setq n (+ n nlen))
             (setq i 0)
             (while (< i 4)
               (seq (ptr-write-u16 (data-addr wbuf1) (* 2 (+ n i)) (ptr-read-u8 ,(th/s ".bin") i)) (setq i (+ i 1))))
             (ptr-write-u16 (data-addr wbuf1) (* 2 (+ n 4)) 0)
             0)))
    (defun send_golden (pipe name nlen out nreq)
      (seq (golden_path name nlen)
           (let ((sz (read_file (data-addr wbuf1) out 65536)))
             (if (< sz 0) (send_str pipe ,(th/s "ERR stub-missing-golden"))
               (seq (if (= (st_get 3) nreq)
                        (seq (ptr-write-u8 out 14 255) (ptr-write-u8 out 15 255)
                             (ptr-write-u8 out 16 255) (ptr-write-u8 out 17 127))
                      0)
                    (send pipe out sz))))))
    ;; "OK ENGINE <id>" for "ENGINE SET <id>" at REQ+OFF (id ends at N).
    (defun send_engine_ok (pipe req off n tlv out)
      (let ((m 10) (i 0) (idn (- n (+ off 11))))
        (seq (ec_copy out 18 ,(th/s "OK ENGINE ") 0 10)
             (while (< i idn) (seq (ptr-write-u8 out (+ 18 m) (ptr-read-u8 req (+ off (+ 11 i)))) (setq m (+ m 1)) (setq i (+ i 1))))
             (if (= tlv 1)
                 (seq (ptr-write-u32 out 0 #x56545344) (ptr-write-u32 out 4 (+ 18 m))
                      (ptr-write-u8 out 8 1) (ptr-write-u8 out 9 2) (ptr-write-u16 out 10 0)
                      (ptr-write-u16 out 12 32) (ptr-write-u32 out 14 m)
                      (send pipe out (+ 18 m)))
               (send pipe (+ out 18) m)))))
    (defun reply (pipe req off n tlv out nreq)
      (if (spfx req off n ,(th/s "KEY ") 4)
          (if (= tlv 1) (send_golden pipe ,(th/s "state_preedit") 13 out nreq)
            (send_str pipe ,(th/s "STATE preedit 1 0 003042 00006b -1 -")))
        (if (spfx req off n ,(th/s "CONTROL CONVERT") 15)
            (if (= tlv 1) (send_golden pipe ,(th/s "state_candidate") 15 out nreq)
              (send_str pipe ,(th/s "STATE candidate 2 0 006f22005b57 - 1 006f22005b57,020bb70091ce,005e7e005b57")))
          (if (spfx req off n ,(th/s "RESET") 5)
              (if (= tlv 1) (send_golden pipe ,(th/s "state_idle") 10 out nreq)
                (send_str pipe ,(th/s "STATE hiragana 0 -1 - - -1 -")))
            (if (spfx req off n ,(th/s "ENGINE SET ") 11) (send_engine_ok pipe req off n tlv out)
              (if (= tlv 1) (send_golden pipe ,(th/s "raw_ok") 6 out nreq)
                (send_str pipe ,(th/s "OK"))))))))
    ;; Offset of the request line after an optional "SESSION <id> " prefix.
    (defun line_off (req n)
      (if (spfx req 0 n ,(th/s "SESSION ") 8)
          (let ((i 8)) (seq (while (and (< i n) (/= (ptr-read-u8 req i) 32)) (setq i (+ i 1))) (+ i 1)))
        0))
    (defun _start ()
      (let ((pipe 0) (req (heap_new 9000)) (out (heap_new 70000)) (go 1) (tlv 0) (inner 0))
        (seq (st_set 4 (env_int (data-addr w_notlv))) (st_set 1 (env_int (data-addr w_silent)))
             (st_set 2 (env_int (data-addr w_sleepms))) (st_set 3 (env_int (data-addr w_corrupt)))
             (st_set 6 (env_int (data-addr w_delay)))
             (if (> (env_w (data-addr w_log) (data-addr wbuf3) 520) 0)
                 (st_set 5 (extern-call CreateFileW (data-addr wbuf3) 4 7 0 4 128 0))
               0)
             (log_bytes ,(th/s "#start") 6)
             (if (> (st_get 6) 0) (extern-call Sleep (st_get 6)) 0)
             (env_w (data-addr w_pipe) (data-addr wbuf2) 520)
             (setq pipe (extern-call CreateNamedPipeW (data-addr wbuf2) 3 6 1 65536 65536 0 0))
             (if (= pipe (- 0 1)) (extern-call ExitProcess 3) 0)
             (while (= go 1)
               (seq (extern-call ConnectNamedPipe pipe 0)
                    (log_bytes ,(th/s "#connect") 8)
                    (setq tlv 0) (setq inner 1)
                    (while (= inner 1)
                      (seq (ptr-write-u64 (data-addr ostate) 16 0)
                           (if (= (extern-call ReadFile pipe req 9000 (+ (data-addr ostate) 16) 0) 0) (setq inner 0)
                             (let ((n (logand (ptr-read-u64 (data-addr ostate) 16) 4294967295)))
                               (seq (while (and (> n 0) (or (= (ptr-read-u8 req (- n 1)) 10) (= (ptr-read-u8 req (- n 1)) 13)))
                                      (setq n (- n 1)))
                                    (log_bytes req n)
                                    (let ((off (line_off req n)))
                                      (if (spfx req off n ,(th/s "SHUTDOWN") 8)
                                          (seq (send_str pipe ,(th/s "OK")) (setq inner 0) (setq go 0))
                                        (if (spfx req off n ,(th/s "HELLO TLV") 9)
                                            (if (= (st_get 4) 1) (send_str pipe ,(th/s "ERR unknown-request"))
                                              (seq (setq tlv 1) (send_str pipe ,(th/s "OK TLV 1"))))
                                          (seq (st_set 7 (+ (st_get 7) 1))
                                               (if (= (st_get 1) (st_get 7))
                                                   (extern-call Sleep (st_get 2))
                                                 (reply pipe req off n tlv out (st_get 7)))))))))))) 
                    (extern-call DisconnectNamedPipe pipe)))
             (extern-call ExitProcess 0)))))) 

(defun ech-build (path kind)
  "Build the EXE of KIND (client or stub) at PATH."
  (let ((th--lits nil))
    (setq max-lisp-eval-depth (max max-lisp-eval-depth 100000))
    (let* ((forms (append (th/common)
                          (if (eq kind 'client)
                              (append (ech/client-forms) (ddskk-engine-client-all-forms))
                            (append (ech/stub-forms) (ddskk-engine-client-all-forms)))))
           (imports (ddskk-engine-client-all-imports))
           (k32 (assoc "kernel32.dll" imports)))
      (setcdr k32 (delete-dups (append (cdr k32) (cdr (assoc "kernel32.dll" th-imports)))))
      (nelisp-com-build-exe
       path (append (th/lit-blobs) (th/blobs) (ech/blobs) forms) imports))))

(provide 'engine-client-hosts)
