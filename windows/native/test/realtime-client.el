;;; realtime-client.el --- test EXE for ddskk-realtime.el  -*- lexical-binding: t; -*-

;;; Commentary:

;; Builds an EXE that links `ddskk-realtime-forms' and runs a compiled-in
;; program (the OP lines of a realtime case file, see
;; tools/extract-realtime-cases.py).  For every op it prints one trace line
;; (format documented in tools/realtime-check.py), identical to what the C++
;; oracle (realtime-oracle.cpp) prints.  CHECK lines are NOT interpreted here:
;; tools/realtime-check.py evaluates them against the trace on the Linux side.
;;
;;   emacs --batch -L $NELISP_ROOT/lisp -L native -L native/test \
;;     -l realtime-client.el --eval '(realtime-client-build "out.exe" "cases.txt")'
;; The rule-table build hook DDSKK_REALTIME_MUTATE applies to this build too.

;;; Code:

(require 'cl-lib)
(let ((d (or (getenv "NELISP_ROOT") (error "Set NELISP_ROOT"))))
  (add-to-list 'load-path (expand-file-name "lisp" d)))
(require 'nelisp-com-dsl)
(require 'nelisp-com-wstr-lib)
(require 'ddskk-realtime)

(defconst realtime-client-ops
  '(("NEW" . 0) ("CONT" . 1) ("FEED" . 2) ("BS" . 3) ("COMMIT" . 4) ("QUIT" . 5)
    ("RESTORE" . 6) ("KATA" . 7) ("CKATA" . 8) ("HIRA" . 9) ("RESET" . 10)))

(defconst realtime-client-imports
  `(("kernel32.dll" "ExitProcess" "WriteFile" "GetStdHandle"
     ,@(cdr (car ddskk-realtime-imports)))))

(defun realtime-client-program (cases-file)
  "Return the byte list of the program for CASES-FILE (4 bytes per op)."
  (let (bytes (ids (make-hash-table :test 'equal)) (next 0))
    (with-temp-buffer
      (insert-file-contents cases-file)
      (dolist (line (split-string (buffer-string) "\n" t))
        (let* ((f (split-string line)) (op (assoc (car f) realtime-client-ops)))
          (cond
           ((or (string-prefix-p "#" line) (equal (car f) "CHECK")))
           ((null op) (error "Unknown case line: %s" line))
           (t (when (equal (car f) "NEW")
                (when (>= next 128) (error "More than 128 objects"))
                (puthash (nth 1 f) next ids) (setq next (1+ next)))
              (let ((id (gethash (nth 1 f) ids)))
                (unless id (error "Object used before NEW: %s" line))
                (let ((arg (cond ((equal (car f) "FEED") (string-to-number (nth 2 f) 16))
                                 ((equal (car f) "CONT") (string-to-number (nth 2 f)))
                                 (t 0))))
                  (setq bytes (append bytes (list (cdr op) id (logand arg 255)
                                                  (ash arg -8)))))))))))
    bytes))

(defun realtime-client-forms (cases-file)
  (let ((prog (realtime-client-program cases-file)))
    (append
     (ddskk-realtime-blobs)
     (list `(data-blob rc_prog ,(or prog '(0)) rodata)
           `(data-blob rc_objs ,(make-list 1024 0) data)
           `(data-blob rc_obuf ,(make-list 65536 0) data)
           `(data-blob rc_olen ,(make-list 8 0) data)
           `(data-blob rc_hex ,(make-list 32 0) data)
           `(data-blob rc_wr ,(make-list 16 0) data)
           (nelisp-com-ascii-blob 'rc_t "T ")
           (nelisp-com-ascii-blob 'rc_r " r=")
           (nelisp-com-ascii-blob 'rc_m " m=")
           (nelisp-com-ascii-blob 'rc_c " c=")
           (nelisp-com-ascii-blob 'rc_tx " t=")
           (nelisp-com-ascii-blob 'rc_p " p=")
           (nelisp-com-ascii-blob 'rc_f " f=")
           (nelisp-com-ascii-blob 'rc_v " v=")
           (nelisp-com-ascii-blob 'rc_raw " raw="))
     (ddskk-realtime-forms)
     `((defun ob_ch (c)
         (seq (if (>= (ptr-read-u64 (data-addr rc_olen) 0) 60000) (ob_flush) 0)
              (let ((n (ptr-read-u64 (data-addr rc_olen) 0)))
                (seq (ptr-write-u8 (data-addr rc_obuf) n c)
                     (ptr-write-u64 (data-addr rc_olen) 0 (+ n 1))
                     0))))
       (defun ob_s (p)
         (let ((i 0))
           (while (/= (ptr-read-u8 p i) 0)
             (seq (ob_ch (ptr-read-u8 p i)) (setq i (+ i 1))))))
       (defun ob_hexn (v n)
         (let ((i 0) (x v))
           (seq (while (< i n)
                  (seq (ptr-write-u8 (data-addr rc_hex) i (logand x 15))
                       (setq x (/ x 16)) (setq i (+ i 1))))
                (while (> i 0)
                  (seq (setq i (- i 1))
                       (let ((d (ptr-read-u8 (data-addr rc_hex) i)))
                         (ob_ch (if (< d 10) (+ 48 d) (+ 87 d))))))
                0)))
       (defun ob_hex (v)
         (let ((n 1) (x (/ v 16)))
           (seq (while (> x 0) (seq (setq n (+ n 1)) (setq x (/ x 16))))
                (ob_hexn v n))))
       (defun ob_flush ()
         (let ((h (extern-call GetStdHandle (- 0 11))))
           (seq (extern-call WriteFile h (data-addr rc_obuf)
                             (ptr-read-u64 (data-addr rc_olen) 0) (data-addr rc_wr) 0)
                (ptr-write-u64 (data-addr rc_olen) 0 0)
                0)))
       (defun ob_units (p n)
         (if (= n 0) (ob_ch 45)
           (let ((i 0))
             (while (< i n)
               (seq (if (> i 0) (ob_ch 46) 0)
                    (ob_hexn (ptr-read-u16 p (* 2 i)) 4)
                    (setq i (+ i 1)))))))
       (defun ob_ascii (p n)
         (if (= n 0) (ob_ch 45)
           (let ((i 0))
             (while (< i n) (seq (ob_ch (ptr-read-u8 p i)) (setq i (+ i 1)))))))
       (defun rc_trace (i f r)
         (seq (ob_s (data-addr rc_t)) (ob_hex i) (ob_s (data-addr rc_r)) (ob_ch (+ 48 r))
              (if (= r 1)
                  (seq (ob_s (data-addr rc_m)) (ob_ch (+ 48 (rtf_out_mode f)))
                       (ob_s (data-addr rc_c))
                       (if (< (rtf_out_cstart f) 0) (seq (ob_ch 45) (ob_ch 49)) (ob_ch 48))
                       (ob_s (data-addr rc_tx))
                       (ob_units (rtf_out_text_ptr f) (rtf_out_text_len f))
                       (ob_s (data-addr rc_p))
                       (ob_ascii (rtf_out_pend_ptr f) (rtf_out_pend_len f)))
                0)
              (ob_s (data-addr rc_f))
              (ob_ch (+ 48 (rtf_composing f))) (ob_ch (+ 48 (rtf_preedit f)))
              (ob_ch (+ 48 (rtf_katakana f))) (ob_ch (+ 48 (rtf_latin f)))
              (ob_ch (+ 48 (rtf_wide_latin f)))
              (ob_s (data-addr rc_v))
              (ob_units (rtf_preview_ptr f) (rtf_preview_len f))
              (ob_s (data-addr rc_raw))
              (if (= (rtf_raw_len f) 0) (ob_ch 45)
                (let ((k 0))
                  (while (< k (rtf_raw_len f))
                    (seq (if (> k 0) (ob_ch 46) 0)
                         (ob_hexn (rtf_raw_at f k) 2)
                         (setq k (+ k 1))))))
              (ob_ch 10)
              0))
       (defun rc_step (op f arg)
         (if (= op 1) (seq (rtf_set_continuous f arg) 0)
           (if (= op 2) (rtf_feed f arg)
             (if (= op 3) (rtf_backspace f)
               (if (= op 4) (rtf_commit f)
                 (if (= op 5) (rtf_quit f)
                   (if (= op 6) (rtf_restore_preedit f)
                     (if (= op 7) (rtf_to_katakana f)
                       (if (= op 8) (rtf_commit_katakana f)
                         (if (= op 9) (rtf_to_hiragana f)
                           (if (= op 10) (seq (rtf_reset f) 0) 0)))))))))))
       (defun _start ()
         (let ((i 0) (n ,(/ (length prog) 4)))
           (seq (while (< i n)
                  (let* ((rec (+ (data-addr rc_prog) (* 4 i)))
                         (op (ptr-read-u8 rec 0)) (id (ptr-read-u8 rec 1))
                         (arg (+ (ptr-read-u8 rec 2) (* 256 (ptr-read-u8 rec 3)))))
                    (seq (if (= op 0)
                             (ptr-write-u64 (data-addr rc_objs) (* 8 id) (rtf_new))
                           0)
                         (let* ((f (ptr-read-u64 (data-addr rc_objs) (* 8 id)))
                                (r (if (= op 0) 0 (rc_step op f arg))))
                           (rc_trace i f r))
                         (setq i (+ i 1)))))
                (ob_flush)
                (extern-call ExitProcess 0))))))))

(defun realtime-client-build (path cases-file)
  "Link the test EXE for CASES-FILE at PATH."
  (setq max-lisp-eval-depth (max max-lisp-eval-depth 100000))
  (nelisp-com-build-exe path (realtime-client-forms cases-file) realtime-client-imports))

(provide 'realtime-client)
;;; realtime-client.el ends here
