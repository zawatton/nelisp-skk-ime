        (should (eq authenticated nelisp-ime-emacs--inline-client))
        (should (equal (substring-no-properties (nelisp-ime-emacs-inline-test--display)) "current"))))))

(ert-deftest nelisp-ime-emacs-inline-s21-move-and-minibuffer ()
  (nelisp-ime-emacs-inline-test--with-server
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (insert "abcdef")
      (goto-char 2)
      (let ((client (nelisp-ime-emacs-inline-test--client)))
        (push client test-clients)
        (nelisp-ime-emacs-inline-test--hello client)
        (process-send-string client "PREEDIT 1 1 ▽かな\n")
        (nelisp-ime-emacs-inline-test--sequence 1)
        (goto-char 5)
        (run-hooks 'post-command-hook)
        (should (= (overlay-start nelisp-ime-emacs--inline-overlay) 5))
        (let ((other (split-window)))
          (select-window other)
          (set-window-point other 3)
          (run-hook-with-args 'window-selection-change-functions (selected-frame))
          (should (eq (overlay-get nelisp-ime-emacs--inline-overlay 'window) other))
          (should (= (overlay-start nelisp-ime-emacs--inline-overlay) 3)))
        (select-window (minibuffer-window))
        (should (minibufferp (window-buffer)))
        (with-current-buffer (window-buffer)
          (let ((undo buffer-undo-list) (modified (buffer-modified-p))
                (buffer-read-only t))
            (run-hooks 'post-command-hook)
            (should (eq (overlay-buffer nelisp-ime-emacs--inline-overlay) (current-buffer)))
            (should (= (overlay-start nelisp-ime-emacs--inline-overlay) (window-point)))
            (should (eq undo buffer-undo-list))
            (should (eq modified (buffer-modified-p)))))))))

(ert-deftest nelisp-ime-emacs-inline-s21-disable-cleans-all-connections ()
  (nelisp-ime-emacs-inline-test--with-server
    (let ((authenticated (nelisp-ime-emacs-inline-test--client))
          (pending (nelisp-ime-emacs-inline-test--client))
          (file nelisp-ime-emacs--inline-file))
      (setq test-clients (list authenticated pending))
      (nelisp-ime-emacs-inline-test--hello authenticated)
      (process-send-string pending "HEL")
      (nelisp-ime-emacs-inline-test--wait
       (lambda () (= (length nelisp-ime-emacs--inline-connections) 2)))
      (let ((connections (copy-sequence nelisp-ime-emacs--inline-connections)))
        (nelisp-ime-emacs-mode -1)
        (should-not (cl-some #'process-live-p connections)))
      (should-not (file-exists-p file))
      (should-not (memq #'nelisp-ime-emacs--inline-update post-command-hook))
      (should-not (memq #'nelisp-ime-emacs--inline-stop kill-emacs-hook))
      (should-not nelisp-ime-emacs--inline-connections))))

(ert-deftest nelisp-ime-emacs-inline-s21-filter-errors-contained-once ()
  (nelisp-ime-emacs-inline-test--with-server
    (let ((warnings 0))
      (cl-letf (((symbol-function 'display-warning) (lambda (&rest _) (cl-incf warnings)))
                ((symbol-function 'nelisp-ime-emacs--inline-render)
                 (lambda (&rest _) (error "Injected renderer failure"))))
        (dotimes (_ 2)
          (let ((client (nelisp-ime-emacs-inline-test--client)))
            (push client test-clients)
            (nelisp-ime-emacs-inline-test--hello client)
            (process-send-string client "PREEDIT 1 0 a\n")
            (nelisp-ime-emacs-inline-test--wait (lambda () (not (process-live-p client))))))
        (should (= warnings 1))))))

(ert-deftest nelisp-ime-emacs-inline-s21-startup-failure-cleans-discovery ()
