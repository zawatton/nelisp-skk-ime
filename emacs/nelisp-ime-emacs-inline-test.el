(require 'ert)
(require 'cl-lib)
(require 'nelisp-ime-emacs)

(defmacro nelisp-ime-emacs-inline-test--with-server (&rest body)
  (declare (indent 0) (debug t))
  `(let* ((directory (make-temp-file "nelisp-inline-test-" t))
          (process-environment (copy-sequence process-environment))
          (nelisp-ime-emacs-inline-directory directory)
          (nelisp-ime-emacs-inline-preedit t)
          (nelisp-ime-emacs--inline-test-pid 4242)
          (nelisp-ime-emacs--inline-server nil)
          (nelisp-ime-emacs--inline-client nil)
          (nelisp-ime-emacs--inline-connections nil)
          (nelisp-ime-emacs--inline-overlay nil)
          (nelisp-ime-emacs--inline-file nil)
          (nelisp-ime-emacs--inline-token nil)
          (nelisp-ime-emacs--inline-warned nil)
          (nelisp-ime-emacs--timer nil)
          (nelisp-ime-emacs--warned t)
          (nelisp-ime-emacs--cursors (make-hash-table :test #'eq))
          (nelisp-ime-emacs-mode nil)
          (test-clients nil))
     (setenv "NELISP_IME_INLINE_DIR" nil)
     (cl-letf (((symbol-function 'nelisp-ime-emacs--focused-frame) #'ignore))
       (unwind-protect
           (save-window-excursion
             (nelisp-ime-emacs-mode 1)
             (should (process-live-p nelisp-ime-emacs--inline-server))
             ,@body)
         (dolist (client test-clients) (delete-process client))
         (nelisp-ime-emacs-mode -1)
         (delete-directory directory t)))))

(defun nelisp-ime-emacs-inline-test--wait (predicate)
  (let ((deadline (+ (float-time) 3)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.01))
    (should (funcall predicate))))

(defun nelisp-ime-emacs-inline-test--client ()
  (make-network-process
   :name "fake-inline-core" :host "127.0.0.1" :family 'ipv4
   :service (process-contact nelisp-ime-emacs--inline-server :service)
   :coding 'utf-8-unix :noquery t
   :filter (lambda (client text)
             (process-put client 'received
                          (concat (process-get client 'received) text)))))

(defun nelisp-ime-emacs-inline-test--hello (client)
  (process-send-string client (format "HELLO 1 %s %d\n"
                                      nelisp-ime-emacs--inline-token
                                      (nelisp-ime-emacs--inline-pid)))
  (nelisp-ime-emacs-inline-test--wait
   (lambda () (string-prefix-p "OK 1 pair\n" (or (process-get client 'received) "")))))

(defun nelisp-ime-emacs-inline-test--sequence (sequence)
  (nelisp-ime-emacs-inline-test--wait
   (lambda () (and nelisp-ime-emacs--inline-client
                   (= sequence (process-get nelisp-ime-emacs--inline-client 'sequence))))))

(defun nelisp-ime-emacs-inline-test--display ()
  (overlay-get nelisp-ime-emacs--inline-overlay 'after-string))

(ert-deftest nelisp-ime-emacs-inline-s21-discovery-and-reenable ()
  (nelisp-ime-emacs-inline-test--with-server
    (let* ((file nelisp-ime-emacs--inline-file)
           (server nelisp-ime-emacs--inline-server)
           (token nelisp-ime-emacs--inline-token)
           (data (with-temp-buffer
                   (insert-file-contents file)
                   (json-parse-buffer :object-type 'alist))))
      (should (equal (file-name-nondirectory file) "4242.json"))
      (should (= (alist-get 'version data) 1))
      (should (= (alist-get 'port data) (process-contact server :service)))
      (should (equal (alist-get 'token data) token))
      (should (string-match-p "\\`[0-9a-f]\\{32\\}\\'" token))
      (should (equal (process-contact server :local)
                     (vector 127 0 0 1 (alist-get 'port data))))
      (unless (eq system-type 'windows-nt)
        (should (= (logand (file-modes file) #o777) #o600)))
      (nelisp-ime-emacs-mode -1)
      (should-not (process-live-p server))
      (should-not (file-exists-p file))
      (nelisp-ime-emacs-mode 1)
      (should-not (equal token nelisp-ime-emacs--inline-token))
      (should-not (eq server nelisp-ime-emacs--inline-server))
      (run-hooks 'kill-emacs-hook)
      (should-not (file-exists-p file))
      (should-not nelisp-ime-emacs--inline-server))))

(ert-deftest nelisp-ime-emacs-inline-s21-atomic-replacement ()
  (nelisp-ime-emacs-inline-test--with-server
    (let ((original-rename (symbol-function 'rename-file)) renamed)
      (cl-letf (((symbol-function 'rename-file)
                 (lambda (source target &optional replace)
                   (should (equal (file-name-directory source) (file-name-directory target)))
                   (should (file-exists-p target))
                   (should replace)
                   (let ((old (with-temp-buffer
                                (insert-file-contents target)
                                (json-parse-buffer :object-type 'alist)))
                         (new (with-temp-buffer
                                (insert-file-contents source)
                                (json-parse-buffer :object-type 'alist))))
                     (should-not (equal (alist-get 'token old) (alist-get 'token new))))
                   (setq renamed t)
                   (funcall original-rename source target replace))))
        (setq nelisp-ime-emacs--inline-token (nelisp-ime-emacs--inline-random-token))
        (nelisp-ime-emacs--inline-write-discovery directory))
      (should renamed)
      (should (equal (directory-files directory nil "^[^.]") '("4242.json")))
      (should-not (directory-files directory nil "\\`\\.inline-")))))

(ert-deftest nelisp-ime-emacs-inline-s21-opt-in-and-directory-precedence ()
  (let ((process-environment (copy-sequence process-environment))
        (system-type 'gnu/linux)
        (nelisp-ime-emacs-inline-directory nil))
    (setenv "NELISP_IME_INLINE_DIR" nil)
    (setenv "LOCALAPPDATA" "windows-local")
    (should-not (nelisp-ime-emacs--inline-directory))
    (nelisp-ime-emacs--inline-start)
    (should-not nelisp-ime-emacs--inline-server)
    (let ((system-type 'windows-nt))
      (should (equal (nelisp-ime-emacs--inline-directory)
                     (expand-file-name "DDSKK/emacs-inline" "windows-local"))))
    (setq nelisp-ime-emacs-inline-directory "custom-inline")
    (should (equal (nelisp-ime-emacs--inline-directory) "custom-inline"))
    (setenv "NELISP_IME_INLINE_DIR" "env-inline")
    (should (equal (nelisp-ime-emacs--inline-directory) "env-inline")))
  (nelisp-ime-emacs-inline-test--with-server
    (nelisp-ime-emacs-mode -1)
    (setq nelisp-ime-emacs-inline-preedit nil)
    (nelisp-ime-emacs-mode 1)
    (should-not nelisp-ime-emacs--inline-server)))

(ert-deftest nelisp-ime-emacs-inline-s21-handshake-rejections ()
  (nelisp-ime-emacs-inline-test--with-server
    (dolist (line (list (format "HELLO 1 %s 4242\n" (make-string 32 ?0))
                       (format "HELLO 2 %s 4242\n" nelisp-ime-emacs--inline-token)
                       (format "HELLO 1 %s 4243\n" nelisp-ime-emacs--inline-token)
                       (format "HELLO 1 %s 4242 extra\n" nelisp-ime-emacs--inline-token)
                       (format "HELLO 1 %s 4242\r\n" nelisp-ime-emacs--inline-token)
                       "PREEDIT 1 0 x\n" "HELLO\n"))
      (let ((client (nelisp-ime-emacs-inline-test--client)))
        (push client test-clients)
        (process-send-string client line)
        (nelisp-ime-emacs-inline-test--wait (lambda () (not (process-live-p client))))
        (should-not (process-get client 'received))
        (should-not nelisp-ime-emacs--inline-client)))))

(ert-deftest nelisp-ime-emacs-inline-s21-customization-lifecycle ()
  (nelisp-ime-emacs-inline-test--with-server
    (let ((setter (get 'nelisp-ime-emacs-inline-preedit 'custom-set))
          (original (default-value 'nelisp-ime-emacs-inline-preedit))
          (file nelisp-ime-emacs--inline-file)
          (token nelisp-ime-emacs--inline-token))
      (unwind-protect
          (progn
            (funcall setter 'nelisp-ime-emacs-inline-preedit nil)
            (should-not nelisp-ime-emacs--inline-server)
            (should-not (file-exists-p file))
            (funcall setter 'nelisp-ime-emacs-inline-preedit t)
            (should (process-live-p nelisp-ime-emacs--inline-server))
            (should-not (equal token nelisp-ime-emacs--inline-token)))
        (set-default 'nelisp-ime-emacs-inline-preedit original)))))

(ert-deftest nelisp-ime-emacs-inline-s21-directory-customization ()
  (nelisp-ime-emacs-inline-test--with-server
    (let ((setter (get 'nelisp-ime-emacs-inline-directory 'custom-set))
          (original (default-value 'nelisp-ime-emacs-inline-directory))
          (file nelisp-ime-emacs--inline-file)
          (new-directory (expand-file-name "new" directory)))
      (unwind-protect
          (progn
            (funcall setter 'nelisp-ime-emacs-inline-directory new-directory)
            (should-not (file-exists-p file))
            (should (equal nelisp-ime-emacs--inline-file
                           (expand-file-name "4242.json" new-directory)))
            (should (file-exists-p nelisp-ime-emacs--inline-file)))
