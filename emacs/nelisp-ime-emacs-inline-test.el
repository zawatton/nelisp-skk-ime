(ert-deftest nelisp-ime-emacs-inline-s21-render-and-stale-sequences ()
  (nelisp-ime-emacs-inline-test--with-server
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (buffer-enable-undo)
      (insert "unchanged buffer")
      (goto-char 4)
      (set-buffer-modified-p nil)
      (let ((buffer-read-only t) (undo buffer-undo-list) (tick (buffer-chars-modified-tick))
            (client (nelisp-ime-emacs-inline-test--client)))
        (push client test-clients)
        (nelisp-ime-emacs-inline-test--hello client)
        (process-send-string client "PREEDIT 1 2 ▽かな%20%25%0D%0A😀\n")
        (nelisp-ime-emacs-inline-test--sequence 1)
        (let ((display (nelisp-ime-emacs-inline-test--display)))
          (should (equal (substring-no-properties display) "▽かな %\r\n😀"))
          (should (eq (get-text-property 0 'face display) 'nelisp-ime-emacs-preedit))
          (should (eq (face-attribute 'nelisp-ime-emacs-preedit :inherit) 'underline))
          (should (eql (get-text-property 2 'cursor display) 1))
          (should-not (get-text-property 1 'cursor display)))
        (should (= (overlay-start nelisp-ime-emacs--inline-overlay) 4))
        (should (= (overlay-end nelisp-ime-emacs--inline-overlay) 4))
        (should (eq (overlay-get nelisp-ime-emacs--inline-overlay 'window) (selected-window)))
        (process-send-string client "PREEDIT 1 0 stale\nCLEAR 0\nPREEDIT 2 1 ▼漢字\n")
        (nelisp-ime-emacs-inline-test--sequence 2)
        (should (equal (substring-no-properties (nelisp-ime-emacs-inline-test--display)) "▼漢字"))
        (process-send-string client "PREEDIT 1 0 stale\nCLEAR 2\nPREEDIT 3 0 ▼漢字\n")
        (nelisp-ime-emacs-inline-test--sequence 3)
        (should (get-text-property 0 'cursor (nelisp-ime-emacs-inline-test--display)))
        (let ((overlay nelisp-ime-emacs--inline-overlay))
          (process-send-string client "CLEAR 4\n")
          (nelisp-ime-emacs-inline-test--sequence 4)
          (should-not (overlay-buffer overlay))
          (should-not nelisp-ime-emacs--inline-overlay))
        (should (equal (buffer-string) "unchanged buffer"))
        (should-not (buffer-modified-p))
        (should (eq undo buffer-undo-list))
        (should (= tick (buffer-chars-modified-tick)))))))

(ert-deftest nelisp-ime-emacs-inline-s21-cursor-endpoints-and-empty-text ()
  (nelisp-ime-emacs-inline-test--with-server
    (let ((client (nelisp-ime-emacs-inline-test--client)))
      (push client test-clients)
      (nelisp-ime-emacs-inline-test--hello client)
      (process-send-string client "PREEDIT 0 3 ▽かな\n")
      (nelisp-ime-emacs-inline-test--sequence 0)
      (let ((display (nelisp-ime-emacs-inline-test--display)))
        (should (equal (substring-no-properties display 0 3) "▽かな"))
        (should (eql (get-text-property 3 'cursor display) 1))
        (should (equal (get-text-property 3 'display display) '(space :width 0))))
      (process-send-string client "PREEDIT 1 0 \n")
      (nelisp-ime-emacs-inline-test--sequence 1)
      (should (eql (get-text-property 0 'cursor (nelisp-ime-emacs-inline-test--display)) 1))
      (process-send-string client "PREEDIT 2 1 ▽%0Aかな\n")
      (nelisp-ime-emacs-inline-test--sequence 2)
      (let ((display (nelisp-ime-emacs-inline-test--display)))
        (should (eql (get-text-property 1 'cursor display) 1))
        (should (equal (get-text-property 1 'display display) '(space :width (1))))
        (should (equal (concat (substring-no-properties display 0 1)
                              (substring-no-properties display 2)) "▽\nかな"))))))

(ert-deftest nelisp-ime-emacs-inline-s21-fragments-and-multiple-lines ()
  (nelisp-ime-emacs-inline-test--with-server
    (let ((client (nelisp-ime-emacs-inline-test--client)))
      (push client test-clients)
      (process-send-string client "HEL")
      (nelisp-ime-emacs-inline-test--wait
       (lambda () (and nelisp-ime-emacs--inline-connections
                       (equal "HEL" (process-get (car nelisp-ime-emacs--inline-connections) 'pending)))))
      (should-not nelisp-ime-emacs--inline-client)
      (process-send-string client (format "LO 1 %s 4242\nPREEDIT 1 1 ▽か" nelisp-ime-emacs--inline-token))
      (nelisp-ime-emacs-inline-test--wait
       (lambda () (and nelisp-ime-emacs--inline-client
                       (equal (process-get nelisp-ime-emacs--inline-client 'pending) "PREEDIT 1 1 ▽か"))))
      (should-not nelisp-ime-emacs--inline-overlay)
      (process-send-string client "な\nCLEAR 2\nPREEDIT 3 1 ▼漢字\n")
      (nelisp-ime-emacs-inline-test--sequence 3)
      (should (equal (substring-no-properties (nelisp-ime-emacs-inline-test--display)) "▼漢字"))
      ;; Split a UTF-8 code point across TCP writes, as well as line chunks.
      (set-process-coding-system client 'utf-8-unix 'binary)
      (let ((bytes (encode-coding-string "PREEDIT 4 1 ▽😀\n" 'utf-8-unix)))
        (process-send-string client (substring bytes 0 13))
        (accept-process-output nil 0.02)
        (process-send-string client (substring bytes 13)))
      (nelisp-ime-emacs-inline-test--sequence 4)
      (should (equal (substring-no-properties (nelisp-ime-emacs-inline-test--display)) "▽😀")))))

