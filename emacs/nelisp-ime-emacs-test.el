;;; nelisp-ime-emacs-test.el --- Native integration tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-ime-emacs)
(defvar evil-local-mode nil)
(defvar evil-state 'normal)
(defvar evil-insert-state-entry-hook)
(defvar evil-normal-state-entry-hook)

(ert-deftest nelisp-ime-emacs-background-events-never-set-open ()
  (let ((nelisp-ime-emacs-mode nil) (nelisp-ime-emacs--timer nil)
        (nelisp-ime-emacs--warned t)
        (nelisp-ime-emacs--cursors (make-hash-table :test #'eq)) calls)
    (cl-letf (((symbol-function 'nelisp-ime-emacs--focused-frame)
               (lambda () (selected-frame)))
              ((symbol-function 'w32-read-registry) (lambda (&rest _) nil))
              ((symbol-function 'w32-set-ime-open-status)
               (lambda (value) (push value calls))))
      (unwind-protect
          (progn
            (nelisp-ime-emacs-mode 1)
            (setq calls nil)
            (run-hooks 'focus-in-hook 'buffer-list-update-hook)
            (when after-focus-change-function (funcall after-focus-change-function))
            (run-hook-with-args 'window-selection-change-functions (selected-frame))
            (run-hook-with-args 'window-buffer-change-functions (selected-window))
            (with-temp-buffer
              (let ((evil-state nil)) (run-hooks 'buffer-list-update-hook)))
            (funcall (timer--function nelisp-ime-emacs--timer))
            (should-not calls))
        (nelisp-ime-emacs-mode -1)))))

(ert-deftest nelisp-ime-emacs-state-and-veto ()
  (with-current-buffer (window-buffer (selected-window))
  (let ((nelisp-ime-emacs-mode t) (evil-local-mode t) (evil-state 'insert)
        (nelisp-ime-emacs-before-open-hook nil) calls)
    (cl-letf (((symbol-function 'nelisp-ime-emacs--focused-frame) (lambda () (selected-frame)))
              ((symbol-function 'w32-set-ime-open-status) (lambda (value) (push value calls)))
              ((symbol-function 'nelisp-ime-emacs--restore) #'ignore))
      (dolist (state '(insert replace normal visual motion operator emacs))
        (setq evil-state state)
        (nelisp-ime-emacs--state-entry))
      (should (equal (reverse calls) '(t t nil nil nil nil nil)))
      (setq evil-state 'insert nelisp-ime-emacs-before-open-hook (list (lambda () nil)))
      (nelisp-ime-emacs--state-entry)
      (should-not (car calls))))))

(ert-deftest nelisp-ime-emacs-colors-labels-and-evil-cursor ()
  (let ((nelisp-ime-emacs-mode t) (evil-local-mode t) (evil-state 'insert)
        (nelisp-ime-emacs--cursors (make-hash-table :test #'eq))
        (nelisp-ime-emacs--warned t) (mode "hiragana") (background 'dark)
        color label refreshed)
    (cl-letf (((symbol-function 'nelisp-ime-emacs--focused-frame) (lambda () (selected-frame)))
              ((symbol-function 'w32-read-registry)
               (lambda (_root _key name)
                 (pcase name ("revision" 14) ("sequence" 7) ("mode" mode) ("open" 1))))
              ((symbol-function 'frame-parameter) (lambda (_frame parameter) (if (eq parameter 'background-mode) background "white")))
              ((symbol-function 'set-cursor-color) (lambda (value) (setq color value)))
              ((symbol-function 'w32-set-ime-open-status)
               (lambda (&rest _) (ert-fail "Cursor polling changed IME open status")))
              ((symbol-function 'evil-refresh-cursor) (lambda () (setq refreshed t))))
      (dolist (entry '(("hiragana" "pink" "coral4" "[あ]")
                       ("katakana" "spring green" "forest green" "[ア]")
                       ("jisx0201" "thistle" "blueviolet" "[ｱ]")
                       ("wide-latin" "gold" "gold" "[Ａ]")
                       ("latin" "gray" "ivory4" "[A]")
                       ("abbrev" "orange" "dark orange" "[aA]")))
        (setq mode (car entry) background 'dark)
        (nelisp-ime-emacs--poll)
        (should (equal color (nth 1 entry)))
        (should (equal nelisp-ime-emacs--label (nth 3 entry)))
        (setq background 'light)
        (nelisp-ime-emacs--poll)
        (should (equal color (nth 2 entry))))
      (setq label nelisp-ime-emacs--label mode "candidate")
      (nelisp-ime-emacs--poll)
      (should (equal label nelisp-ime-emacs--label))
      (setq evil-state 'normal)
      (nelisp-ime-emacs--poll)
      (should refreshed)
      (should (equal nelisp-ime-emacs--label "")))))

(ert-deftest nelisp-ime-emacs-unfocused-does-not-read ()
  (let ((nelisp-ime-emacs-mode t))
    (cl-letf (((symbol-function 'nelisp-ime-emacs--focused-frame) (lambda () nil))
              ((symbol-function 'w32-read-registry) (lambda (&rest _) (ert-fail "Unfocused poll")))
              ((symbol-function 'w32-set-ime-open-status) (lambda (&rest _) (ert-fail "Unfocused open"))))
      (nelisp-ime-emacs--poll))))

(ert-deftest nelisp-ime-emacs-hooks-and-timer-lifecycle ()
  (let ((nelisp-ime-emacs--timer nil) (nelisp-ime-emacs-mode nil)
        (nelisp-ime-emacs--cursors (make-hash-table :test #'eq)) calls)
    (cl-letf (((symbol-function 'nelisp-ime-emacs--focused-frame) (lambda () (selected-frame)))
              ((symbol-function 'w32-set-ime-open-status) (lambda (value) (push value calls)))
              ((symbol-function 'w32-read-registry) (lambda (&rest _) 1)))
      (unwind-protect
          (progn
            (nelisp-ime-emacs-mode 1)
            (should (timerp nelisp-ime-emacs--timer))
            (dolist (hook '(buffer-list-update-hook
                           window-selection-change-functions window-buffer-change-functions))
              (should-not (memq #'nelisp-ime-emacs--state-entry (symbol-value hook))))
            (should (memq #'nelisp-ime-emacs--state-entry evil-insert-state-entry-hook))
            (should-not calls))
        (nelisp-ime-emacs-mode -1))
      (should-not nelisp-ime-emacs--timer)
      (should-not (memq #'nelisp-ime-emacs--state-entry evil-normal-state-entry-hook)))))

(ert-deftest nelisp-ime-emacs-org-source-predicate ()
  (require 'org)
  (with-temp-buffer
    (org-mode)
    (insert "#+begin_src emacs-lisp\n(message \"test\")\n#+end_src\nOutside\n")
    (goto-char (point-min)) (forward-line 1)
    (should-not (nelisp-ime-emacs-outside-org-src-p))
    (forward-line 2)
    (should (nelisp-ime-emacs-outside-org-src-p))))

(ert-deftest nelisp-ime-emacs-publish-off-warning ()
  (let ((nelisp-ime-emacs--warned nil) warnings)
    (cl-letf (((symbol-function 'w32-read-registry) (lambda (&rest _) 0))
              ((symbol-function 'display-warning) (lambda (&rest args) (push args warnings))))
      (nelisp-ime-emacs--check-settings)
      (nelisp-ime-emacs--check-settings)
      (should (= (length warnings) 1)))))

(ert-deftest nelisp-ime-emacs-inconsistent-snapshot-ignored ()
  (let ((nelisp-ime-emacs-mode t) (nelisp-ime-emacs--warned t) (sequence 0))
    (cl-letf (((symbol-function 'nelisp-ime-emacs--focused-frame) (lambda () (selected-frame)))
              ((symbol-function 'w32-read-registry)
               (lambda (_root _key name) (pcase name ("revision" 14) ("sequence" (cl-incf sequence)) ("mode" "latin") ("open" 1))))
              ((symbol-function 'set-cursor-color) (lambda (&rest _) (ert-fail "Torn snapshot applied"))))
      (nelisp-ime-emacs--poll))))

(ert-deftest nelisp-ime-emacs-odd-revision-ignored ()
  (let ((nelisp-ime-emacs-mode t) (nelisp-ime-emacs--warned t))
    (cl-letf (((symbol-function 'nelisp-ime-emacs--focused-frame) (lambda () (selected-frame)))
              ((symbol-function 'w32-read-registry)
               (lambda (_root _key name) (pcase name ("revision" 3) ("sequence" 1) ("mode" "latin") ("open" 1))))
              ((symbol-function 'set-cursor-color) (lambda (&rest _) (ert-fail "Partial write applied"))))
      (nelisp-ime-emacs--poll))))

(ert-deftest nelisp-ime-emacs-without-evil-then-late-state-hooks ()
  (with-current-buffer (window-buffer (selected-window))
  (let ((nelisp-ime-emacs-mode t) (evil-local-mode nil) (evil-state 'normal) calls)
    (cl-letf (((symbol-function 'nelisp-ime-emacs--focused-frame) (lambda () (selected-frame)))
              ((symbol-function 'w32-set-ime-open-status) (lambda (value) (push value calls)))
              ((symbol-function 'nelisp-ime-emacs--restore) #'ignore))
      (nelisp-ime-emacs--install-evil-hooks)
      (unwind-protect
          (progn
            (run-hooks 'evil-normal-state-entry-hook)
            (should-not calls)
            (setq evil-local-mode t)
            (run-hooks 'evil-normal-state-entry-hook)
            (should-not (car calls))
            (setq evil-state 'insert)
            (run-hooks 'evil-insert-state-entry-hook)
            (should (car calls)))
        (dolist (state '(normal insert replace visual motion operator emacs))
          (remove-hook (intern (format "evil-%s-state-entry-hook" state)) #'nelisp-ime-emacs--state-entry)))))))

(ert-deftest nelisp-ime-emacs-selected-buffer-transitions ()
  (let ((nelisp-ime-emacs-mode t) (evil-local-mode t) (evil-state 'insert)
        (nelisp-ime-emacs-before-open-hook nil) calls)
    (cl-letf (((symbol-function 'w32-set-ime-open-status)
               (lambda (value) (push value calls)))
              ((symbol-function 'nelisp-ime-emacs--restore) #'ignore))
      (nelisp-ime-emacs--install-evil-hooks)
      (unwind-protect
          (with-current-buffer (window-buffer (selected-window))
            (run-hooks 'evil-insert-state-entry-hook)
            (should (equal calls '(t)))
            (setq evil-state 'normal)
            (run-hooks 'evil-normal-state-entry-hook)
            (should (equal calls '(nil t)))
            (with-temp-buffer
              (let ((evil-local-mode t) (evil-state 'insert))
                (run-hooks 'evil-insert-state-entry-hook))
              (let ((evil-local-mode t) (evil-state 'normal))
                (run-hooks 'evil-normal-state-entry-hook)))
            (should (equal calls '(nil t))))
        (dolist (state '(normal insert replace visual motion operator emacs))
          (remove-hook (intern (format "evil-%s-state-entry-hook" state))
                       #'nelisp-ime-emacs--state-entry))))))
