;;; nelisp-ime-emacs-test.el --- Native integration tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-ime-emacs)
(defvar evil-local-mode nil)
(defvar evil-state 'normal)
(defvar evil-insert-state-entry-hook)
(defvar evil-normal-state-entry-hook)

(defmacro nelisp-ime-emacs-test--with-selection (&rest body)
  (declare (indent 0) (debug t))
  `(let ((nelisp-ime-emacs-mode nil)
         (nelisp-ime-emacs-inline-preedit nil)
         (nelisp-ime-emacs--timer nil)
         (nelisp-ime-emacs--reconcile-timer nil)
         (nelisp-ime-emacs--selection nil)
         (nelisp-ime-emacs--warned t)
         (nelisp-ime-emacs-before-open-hook nil)
         (nelisp-ime-emacs--cursors (make-hash-table :test #'eq))
         (nelisp-ime-emacs--ime-colors (make-hash-table :test #'eq))
         (nelisp-ime-emacs--closing-frames (make-hash-table :test #'eq))
         (insert-buffer (generate-new-buffer " *ime-insert*"))
         (normal-buffer (generate-new-buffer " *ime-normal*"))
         (actual nil) (focused t) calls)
     (unwind-protect
         (save-window-excursion
           (delete-other-windows)
           (dolist (buffer (list insert-buffer normal-buffer))
             (with-current-buffer buffer
               (setq-local evil-local-mode t)
               (setq-local evil-state (if (eq buffer insert-buffer) 'insert 'normal))))
           (switch-to-buffer normal-buffer)
           (cl-letf (((symbol-function 'w32-get-ime-open-status) (lambda () actual))
                     ((symbol-function 'w32-set-ime-open-status)
                      (lambda (value) (setq actual value) (push value calls)))
                     ((symbol-function 'w32-read-registry) (lambda (&rest _) nil))
                     ((symbol-function 'frame-focus-state) (lambda (_) focused))
                     ((symbol-function 'nelisp-ime-emacs--restore) #'ignore))
             (nelisp-ime-emacs-mode 1)
             ,@body))
       (nelisp-ime-emacs-mode -1)
       (kill-buffer insert-buffer)
       (kill-buffer normal-buffer))))

(defun nelisp-ime-emacs-test--drain ()
  (let ((deadline (+ (float-time) 1)))
    (while (and nelisp-ime-emacs--reconcile-timer (< (float-time) deadline))
      (accept-process-output nil 0.01))
    (should-not nelisp-ime-emacs--reconcile-timer)))

(defun nelisp-ime-emacs-test--selection-event (hook)
  (run-hook-with-args hook (selected-frame))
  (nelisp-ime-emacs-test--drain))

(ert-deftest nelisp-ime-emacs-selection-two-windows ()
  (nelisp-ime-emacs-test--with-selection
    (let ((normal-window (selected-window)) (insert-window (split-window)))
      (set-window-buffer insert-window insert-buffer)
      (select-window insert-window)
      (nelisp-ime-emacs-test--selection-event 'window-selection-change-functions)
      (should actual)
      (select-window normal-window)
      (nelisp-ime-emacs-test--selection-event 'window-selection-change-functions)
      (should-not actual)
      (should (equal (reverse calls) '(t nil))))))

(ert-deftest nelisp-ime-emacs-selection-buffer-change-and-coalescing ()
  (nelisp-ime-emacs-test--with-selection
    (set-window-buffer (selected-window) insert-buffer)
    (run-hook-with-args 'window-buffer-change-functions (selected-frame))
    (let ((timer nelisp-ime-emacs--reconcile-timer))
      (should (timerp timer))
      (run-hook-with-args 'window-selection-change-functions (selected-frame))
      (should (eq timer nelisp-ime-emacs--reconcile-timer)))
    (nelisp-ime-emacs-test--drain)
    (should actual)
    (set-window-buffer (selected-window) normal-buffer)
    (nelisp-ime-emacs-test--selection-event 'window-buffer-change-functions)
    (should (equal (reverse calls) '(t nil)))))

(ert-deftest nelisp-ime-emacs-selection-focus-regained ()
  (nelisp-ime-emacs-test--with-selection
    (switch-to-buffer insert-buffer)
    (nelisp-ime-emacs-test--selection-event 'window-buffer-change-functions)
    (setq actual nil calls nil focused nil)
    (funcall after-focus-change-function)
    (nelisp-ime-emacs-test--drain)
    (should-not calls)
    (setq focused t)
    (funcall after-focus-change-function)
    (nelisp-ime-emacs-test--drain)
    (should (equal calls '(t)))
    ;; A repeated event with matching actual state never calls the setter.
    (funcall after-focus-change-function)
    (nelisp-ime-emacs-test--drain)
    (should (equal calls '(t)))))

(ert-deftest nelisp-ime-emacs-selection-temporary-and-unselected-buffers ()
  (nelisp-ime-emacs-test--with-selection
    (let ((other (split-window)))
      (set-window-buffer other insert-buffer)
      (with-temp-buffer
        (setq-local evil-local-mode t)
        (setq-local evil-state 'insert)
        (run-hooks 'buffer-list-update-hook)
        (run-hooks 'evil-insert-state-entry-hook)
        (nelisp-ime-emacs-test--selection-event 'window-buffer-change-functions))
      (should-not calls)
      (should-not nelisp-ime-emacs--reconcile-timer)
      ;; A genuine selected-buffer change is read in that buffer, even
      ;; when the global hook happens to run with a temporary current buffer.
      (set-window-buffer (selected-window) insert-buffer)
      (with-temp-buffer
        (setq-local evil-state 'normal)
        (nelisp-ime-emacs-test--selection-event 'window-buffer-change-functions))
      (should (equal calls '(t))))))

(ert-deftest nelisp-ime-emacs-selection-user-toggle-until-next-change ()
  (nelisp-ime-emacs-test--with-selection
    (switch-to-buffer insert-buffer)
    (nelisp-ime-emacs-test--selection-event 'window-buffer-change-functions)
    (setq actual nil calls nil)
    (nelisp-ime-emacs-test--selection-event 'window-selection-change-functions)
    (nelisp-ime-emacs-test--selection-event 'window-buffer-change-functions)
    (nelisp-ime-emacs--poll)
    (should-not calls)
    (should-not actual)
    (let ((other (split-window)))
      (set-window-buffer other insert-buffer)
      (select-window other)
      (nelisp-ime-emacs-test--selection-event 'window-selection-change-functions))
