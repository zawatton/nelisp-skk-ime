(ert-deftest nelisp-ime-emacs-selection-org-source-veto-at-window-point ()
  (nelisp-ime-emacs-test--with-selection
    (require 'org)
    (with-current-buffer insert-buffer
      (org-mode)
      (setq-local evil-local-mode t)
      (setq-local evil-state 'insert)
      (insert "#+begin_src emacs-lisp\n(message \"test\")\n#+end_src\nOutside\n"))
    (setq nelisp-ime-emacs-before-open-hook '(nelisp-ime-emacs-outside-org-src-p))
    (set-window-buffer (selected-window) insert-buffer)
    (set-window-point (selected-window) 30)
    (with-temp-buffer
      (nelisp-ime-emacs-test--selection-event 'window-buffer-change-functions))
    (should-not actual)
    (should-not calls)
    (setq actual t)
    (funcall after-focus-change-function)
    (nelisp-ime-emacs-test--drain)
    (should (equal calls '(nil)))))

(ert-deftest nelisp-ime-emacs-selection-minibuffer-and-disable ()
  (nelisp-ime-emacs-test--with-selection
    (select-window (minibuffer-window))
    (nelisp-ime-emacs-test--selection-event 'window-selection-change-functions)
    (should-not calls)
    (select-window (next-window (selected-window) 'no-minibuf))
    (switch-to-buffer insert-buffer)
    (run-hook-with-args 'window-buffer-change-functions (selected-frame))
    (let ((timer nelisp-ime-emacs--reconcile-timer))
      (should (timerp timer))
      (nelisp-ime-emacs-mode -1)
      (should-not (memq timer timer-list)))
    (should-not nelisp-ime-emacs--reconcile-timer)
    (dolist (hook '(window-selection-change-functions window-buffer-change-functions))
      (should-not (memq #'nelisp-ime-emacs--selection-change (symbol-value hook))))
    (funcall after-focus-change-function)
    (nelisp-ime-emacs-test--drain)
    (should-not calls)))

(ert-deftest nelisp-ime-emacs-describe-selected-context ()
  (nelisp-ime-emacs-test--with-selection
    (switch-to-buffer insert-buffer)
    (cl-letf (((symbol-function 'w32-read-registry)
               (lambda (_root key name)
                 (should (string-suffix-p (format "\\Clients\\%d" (emacs-pid)) key))
                 (should (equal name "mode"))
                 "latin")))
      (with-temp-buffer
        (setq-local evil-state 'normal)
        (let ((description (nelisp-ime-emacs-describe)))
          (should (string-match-p "Evil state: insert" description))
          (should (string-match-p "desired IME: open; actual IME: closed; published mode: latin"
                                  description)))))
    (should (string-match-p "published mode: unavailable" (nelisp-ime-emacs-describe)))))

(ert-deftest nelisp-ime-emacs-background-events-never-set-open ()
  (let ((nelisp-ime-emacs-mode nil) (nelisp-ime-emacs--timer nil)
        (nelisp-ime-emacs-inline-preedit nil)
        (nelisp-ime-emacs--warned t)
        (nelisp-ime-emacs--cursors (make-hash-table :test #'eq)) calls)
    (cl-letf (((symbol-function 'nelisp-ime-emacs--focused-frame)
               (lambda () (selected-frame)))
              ((symbol-function 'w32-read-registry) (lambda (&rest _) nil))
              ((symbol-function 'w32-set-ime-open-status)
               (lambda (value) (push value calls))))
      (unwind-protect
          (progn
            (nelisp-ime-emacs-mode 1)
            (setq calls nil)
            (run-hooks 'focus-in-hook 'buffer-list-update-hook)
            (when after-focus-change-function (funcall after-focus-change-function))
            (run-hook-with-args 'window-selection-change-functions (selected-frame))
            (run-hook-with-args 'window-buffer-change-functions (selected-window))
            (with-temp-buffer
              (let ((evil-state nil)) (run-hooks 'buffer-list-update-hook)))
            (funcall (timer--function nelisp-ime-emacs--timer))
            (should-not calls))
        (nelisp-ime-emacs-mode -1)))))

(ert-deftest nelisp-ime-emacs-state-and-veto ()
  (with-current-buffer (window-buffer (selected-window))
  (let ((nelisp-ime-emacs-mode t) (evil-local-mode t) (evil-state 'insert)
        (nelisp-ime-emacs-before-open-hook nil) calls)
    (cl-letf (((symbol-function 'nelisp-ime-emacs--focused-frame) (lambda () (selected-frame)))
              ((symbol-function 'w32-set-ime-open-status) (lambda (value) (push value calls)))
              ((symbol-function 'nelisp-ime-emacs--restore) #'ignore))
      (dolist (state '(insert replace normal visual motion operator emacs))
        (setq evil-state state)
        (nelisp-ime-emacs--state-entry))
      (should (equal (reverse calls) '(t t nil nil nil nil nil)))
      (setq evil-state 'insert nelisp-ime-emacs-before-open-hook (list (lambda () nil)))
      (nelisp-ime-emacs--state-entry)
      (should-not (car calls))))))

(ert-deftest nelisp-ime-emacs-colors-labels-and-evil-cursor ()
  (let ((nelisp-ime-emacs-mode t) (evil-local-mode t) (evil-state 'insert)
        (frame-background-mode nil)
        (nelisp-ime-emacs--ime-colors (make-hash-table :test #'eq))
        (nelisp-ime-emacs--cursors (make-hash-table :test #'eq))
        (nelisp-ime-emacs--warned t) (mode "hiragana") (background 'dark)
        color label refreshed)
    (cl-letf (((symbol-function 'nelisp-ime-emacs--focused-frame) (lambda () (selected-frame)))
              ((symbol-function 'w32-read-registry)
               (lambda (_root _key name)
                 (pcase name ("revision" 14) ("sequence" 7) ("mode" mode) ("open" 1))))
              ((symbol-function 'frame-parameter) (lambda (_frame parameter) (if (eq parameter 'background-mode) background "white")))
              ((symbol-function 'set-cursor-color) (lambda (value) (setq color value)))
              ((symbol-function 'w32-set-ime-open-status)
               (lambda (&rest _) (ert-fail "Cursor polling changed IME open status")))
              ((symbol-function 'evil-refresh-cursor) (lambda () (setq refreshed t))))
      (dolist (entry '(("hiragana" "pink" "coral4" "[あ]")
                       ("katakana" "spring green" "forest green" "[ア]")
                       ("jisx0201" "thistle" "blueviolet" "[ｱ]")
                       ("wide-latin" "gold" "gold" "[Ａ]")
                       ("latin" "gray" "ivory4" "[A]")
                       ("abbrev" "orange" "dark orange" "[aA]")))
        (setq mode (car entry) background 'dark)
        (nelisp-ime-emacs--poll)
        (should (equal color (nth 1 entry)))
        (should (equal nelisp-ime-emacs--label (nth 3 entry)))
        (setq background 'light)
        (nelisp-ime-emacs--poll)
        (should (equal color (nth 2 entry))))
      (setq label nelisp-ime-emacs--label mode "candidate")
      (nelisp-ime-emacs--poll)
      (should (equal label nelisp-ime-emacs--label))
      (setq evil-state 'normal)
      (nelisp-ime-emacs--poll)
      (should refreshed)
      (should (equal nelisp-ime-emacs--label "")))))

(ert-deftest nelisp-ime-emacs-steady-poll-skips-redisplay ()
  "Unchanged IME state must not re-apply cursor color or mode-line updates."
  (let ((nelisp-ime-emacs-mode t) (evil-local-mode t) (evil-state 'insert)
        (nelisp-ime-emacs--ime-colors (make-hash-table :test #'eq))
        (nelisp-ime-emacs--closing-frames (make-hash-table :test #'eq))
        (nelisp-ime-emacs--cursors (make-hash-table :test #'eq))
        (nelisp-ime-emacs--warned t) (nelisp-ime-emacs--label "")
        (open 1) (cursor "white") (sets 0) (updates 0) (restores 0))
    (cl-letf (((symbol-function 'nelisp-ime-emacs--focused-frame) (lambda () (selected-frame)))
              ((symbol-function 'w32-read-registry)
               (lambda (_root _key name)
                 (pcase name ("revision" 14) ("sequence" 7) ("mode" "hiragana") ("open" open))))
              ((symbol-function 'frame-parameter)
               (lambda (_frame parameter) (if (eq parameter 'background-mode) 'dark cursor)))
              ((symbol-function 'set-cursor-color)
               (lambda (value) (setq cursor value) (cl-incf sets)))
              ((symbol-function 'force-mode-line-update) (lambda (&rest _) (cl-incf updates)))
              ((symbol-function 'nelisp-ime-emacs--restore) (lambda (_) (cl-incf restores))))
      (dotimes (_ 3) (nelisp-ime-emacs--poll))
      (should (equal (list sets updates restores) '(1 1 0)))
      (setq open 0)
      (dotimes (_ 3) (nelisp-ime-emacs--poll))
      (should (equal (list sets updates restores) '(1 2 1))))))

(defmacro nelisp-ime-emacs-test--with-cursor (&rest body)
  (declare (indent 0))
  `(let ((nelisp-ime-emacs-mode t) (evil-local-mode t) (evil-state 'insert)
         (nelisp-ime-emacs--warned t) (nelisp-ime-emacs--label "")
         (nelisp-ime-emacs--base-mode "hiragana")
         (nelisp-ime-emacs--closing-frames (make-hash-table :test #'eq))
         (nelisp-ime-emacs--cursors (make-hash-table :test #'eq))
         (nelisp-ime-emacs--ime-colors (make-hash-table :test #'eq))
         (frame-background-mode 'light) (background 'dark)
         (mode "hiragana") (open 1) (actual t) (focused t)
         (cursor "white") sets (shapes 0))
     (cl-letf (((symbol-function 'nelisp-ime-emacs--focused-frame)
                (lambda () (and focused (selected-frame))))
               ((symbol-function 'display-graphic-p) (lambda (&rest _) t))
               ((symbol-function 'w32-read-registry)
                (lambda (_root _key name)
                  (pcase name ("revision" 2) ("sequence" 1) ("mode" mode) ("open" open))))
               ((symbol-function 'w32-get-ime-open-status) (lambda () actual))
               ((symbol-function 'w32-set-ime-open-status) (lambda (value) (setq actual value)))
               ((symbol-function 'frame-parameter)
                (lambda (_frame parameter) (if (eq parameter 'background-mode) background cursor)))
               ((symbol-function 'set-cursor-color)
                (lambda (color) (setq cursor color) (push color sets)))
               ((symbol-function 'evil-set-cursor-color)
                (lambda (color) (unless (equal color cursor) (set-cursor-color color))))
               ((symbol-function 'evil-refresh-cursor)
                (lambda (&rest _)
                  ;; Evil's default and state cursor specifications can both
                  ;; request colors, while still updating the bar shape.
                  (cl-incf shapes)
                  (evil-set-cursor-color "black")
                  (evil-set-cursor-color "white"))))
       (advice-add 'evil-set-cursor-color :around #'nelisp-ime-emacs--evil-set-cursor-color)
       (unwind-protect (progn ,@body)
         (advice-remove 'evil-set-cursor-color #'nelisp-ime-emacs--evil-set-cursor-color)))))

(ert-deftest nelisp-ime-emacs-ddskk-background-and-overrides ()
  (nelisp-ime-emacs-test--with-cursor
    (nelisp-ime-emacs--poll)
    (should (equal cursor "coral4"))
    (setq frame-background-mode 'dark background 'light)
    (nelisp-ime-emacs--poll)
    (should (equal cursor "pink"))
    (setq frame-background-mode nil)
    (nelisp-ime-emacs--poll)
    (should (equal cursor "coral4"))
    (dolist (entry '(("hiragana" skk-cursor-hiragana-color)
                     ("katakana" skk-cursor-katakana-color)
                     ("jisx0201" skk-cursor-jisx0201-color)
                     ("wide-latin" skk-cursor-jisx0208-latin-color)
                     ("latin" skk-cursor-latin-color)
                     ("abbrev" skk-cursor-abbrev-color)))
      (setq mode (car entry))
      (cl-progv (list (cadr entry)) '("red")
        (nelisp-ime-emacs--poll)
        (should (equal (nelisp-ime-emacs--cursor-color (selected-frame)) "red"))
        (should (equal cursor "red"))))))

(ert-deftest nelisp-ime-emacs-typing-and-evil-refresh-never-recolor ()
  (nelisp-ime-emacs-test--with-cursor
    (nelisp-ime-emacs--poll)
    (should (equal sets '("coral4")))
    (setq sets nil)
    (dolist (input '("hiragana" "preedit" "candidate" "registration" "" nil "hiragana"))
      (setq mode input)
      (evil-refresh-cursor)
      (evil-set-cursor-color "black")
      (nelisp-ime-emacs--poll)
      (should (equal nelisp-ime-emacs--label "[あ]")))
    ;; Missing and stale closed publications during native open/focus changes.
    (setq open nil)
    (nelisp-ime-emacs--poll)
    (setq open 0)
    (nelisp-ime-emacs--poll)
    ;; Even agreement on a single closed snapshot can be transient.
    (setq actual nil)
    (nelisp-ime-emacs--poll)
    (setq actual t open 1)
    (nelisp-ime-emacs--poll)
    (setq focused nil)
    (nelisp-ime-emacs--poll)
    (setq focused t open 1)
    (nelisp-ime-emacs--poll)
    (should (= shapes 7))
    (should-not sets)
    (should (equal cursor "coral4"))
    (setq mode "katakana")
    (nelisp-ime-emacs--poll)
    (should (equal sets '("forest green")))
    (setq sets nil)
    (dotimes (_ 3) (evil-refresh-cursor) (nelisp-ime-emacs--poll))
    (should-not sets)))

(ert-deftest nelisp-ime-emacs-close-and-insert-exit-restore ()
  (dolist (exit '(close state disable))
    (nelisp-ime-emacs-test--with-cursor
      (nelisp-ime-emacs--poll)
      (setq sets nil)
      (pcase exit
        ('close (setq open 0 actual nil) (dotimes (_ 2) (nelisp-ime-emacs--poll)))
        ('state
         (setq evil-state 'normal)
         (with-current-buffer (window-buffer (selected-window))
           (nelisp-ime-emacs--state-entry)))
        ('disable (setq nelisp-ime-emacs-mode nil) (nelisp-ime-emacs--restore (selected-frame))))
      (should (equal cursor "white"))
      (should-not (member "coral4" sets))
      (should-not (gethash (selected-frame) nelisp-ime-emacs--ime-colors))
      (should-not (gethash (selected-frame) nelisp-ime-emacs--cursors))
      (should (= shapes 1))
      (setq sets nil)
      (dotimes (_ 3) (nelisp-ime-emacs--poll))
      (should-not sets))))

